{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "allowJs": true,
    "paths": {
      "~/*": ["./src/*"]
    }
  },
  "contentMappers": [
    {
      "package": "@astrojs/ts-content-mapper",
      "extensions": [".astro"]
    }
  ],
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist/"]
}
