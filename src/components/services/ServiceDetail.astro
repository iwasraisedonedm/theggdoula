---
import Layout from '~/layouts/PageLayout.astro';
import Button from '~/components/ui/Button.astro';
import RelatedServices from '~/components/services/RelatedServices.astro';
import { services, type Service } from '~/data/services';

interface Props {
  service: Service;
}

const { service } = Astro.props as Props;
const currentIndex = services.findIndex(({ slug }) => slug === service.slug);
const relatedServices = [
  services[(currentIndex + services.length - 1) % services.length],
  services[(currentIndex + 1) % services.length],
];

const metadata = {
  title: service.name,
  description: service.summary,
};
---

<Layout metadata={metadata}>
  <div class="bg-page text-default">
    <section class="border-b border-border bg-surface-subtle">
      <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-16 lg:px-8 lg:py-20">
        <nav aria-label="Breadcrumb" class="mb-8 text-sm text-muted">
          <ol class="flex flex-wrap items-center gap-2">
            <li>
              <a class="gg-link" href="/services/">
                Services
              </a>
            </li>
            <li aria-hidden="true">/</li>
            <li aria-current="page" class="text-heading">
              {service.name}
            </li>
          </ol>
        </nav>
        <p class="gg-section-label">{service.stage}</p>
        <h1 class="mt-3 max-w-4xl font-heading text-display font-medium tracking-heading text-heading">
          {service.name}
        </h1>
        <p class="mt-6 max-w-2xl text-lg leading-reading text-default sm:text-xl">{service.detail}</p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center">
          <Button variant="primary" href="/book/">
            Ask about a free consultation
          </Button>
          <a class="gg-link text-base" href="/services/">
            Explore all services
          </a>
        </div>
      </div>
    </section>

    <section class="border-b border-border bg-page">
      <div class="mx-auto grid max-w-6xl gap-8 px-4 py-12 sm:px-6 sm:py-16 md:grid-cols-[minmax(0,1fr)_minmax(16rem,0.7fr)] lg:px-8 lg:py-20">
        <div>
          <p class="gg-section-label">A place to begin</p>
          <h2 class="mt-3 font-heading text-title font-medium tracking-heading text-heading">
            What this support focuses on
          </h2>
          <p class="mt-5 max-w-reading text-base leading-reading text-default">{service.focus}</p>
        </div>
        <aside class="gg-card p-6 sm:p-8" aria-labelledby="fit-heading">
          <p class="gg-section-label">Who it may suit</p>
          <h2 id="fit-heading" class="mt-3 font-heading text-2xl font-medium tracking-heading text-heading">
            This may fit if…
          </h2>
          <p class="mt-4 text-base leading-reading text-default">{service.idealClient}</p>
        </aside>
      </div>
    </section>

    <section class="border-b border-border bg-surface-subtle">
      <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-16 lg:px-8 lg:py-20">
        <div class="max-w-3xl">
          <p class="gg-section-label">Care, in context</p>
          <h2 class="mt-3 font-heading text-title font-medium tracking-heading text-heading">
            Support that complements your care team
          </h2>
          <p class="mt-5 text-base leading-reading text-default">
            Doula support is nonmedical. It can offer emotional, physical, and informational support alongside your
            medical care team; it does not replace medical care.
          </p>
          <a class="gg-link mt-5 inline-flex text-base" href="/services/#approach">
            Read about how support begins
          </a>
        </div>
      </div>
    </section>

    <RelatedServices
      services={relatedServices}
      title="Related support"
      label="Keep exploring"
      actionText="View service overview"
    />

    <section id="consultation" class="border-t border-border bg-surface-subtle">
      <div class="mx-auto grid max-w-6xl gap-8 px-4 py-12 sm:px-6 sm:py-16 md:grid-cols-12 md:items-center lg:gap-16 lg:px-8 lg:py-20">
        <div class="md:col-span-8">
          <p class="gg-section-label">Start with a conversation</p>
          <h2 class="mt-3 max-w-3xl font-heading text-title font-medium tracking-heading text-heading">
            Talk through what support could look like.
          </h2>
          <p class="mt-5 max-w-reading text-base leading-reading text-muted">
            Share what matters to you and ask about the support available for your stage.
          </p>
        </div>
        <div class="md:col-span-4 md:justify-self-start">
          <Button variant="primary" href="/book/">
            Ask about a free consultation
          </Button>
        </div>
      </div>
    </section>
  </div>
</Layout>
