---
import { getPermalink } from '~/utils/permalinks';
import type { Service } from '~/data/services';

interface Props {
  service: Pick<Service, 'slug' | 'name' | 'stage' | 'summary'> &
    Partial<Pick<Service, 'number' | 'benefit' | 'idealClient'>>;
  showBenefit?: boolean;
}

const { service, showBenefit = true } = Astro.props;
---

<article class="gg-card group flex h-full flex-col p-6 transition-colors duration-standard hover:border-brand sm:p-7">
  <div class="flex items-start justify-between gap-4">
    {service.number && <span class="font-mono text-xs tracking-widest text-brand">{service.number}</span>}
    <span class="gg-badge">{service.stage}</span>
  </div>
  <h3 class="gg-type-card-title mt-6 text-heading">{service.name}</h3>
  <p class="mt-3 text-base leading-reading text-default">{service.summary}</p>
  {showBenefit && service.benefit && service.idealClient && (
    <dl class="mt-6 border-t border-border pt-5">
      <dt class="gg-section-label">What it can offer</dt>
      <dd class="mt-2 text-base leading-reading text-default">{service.benefit}</dd>
      <dt class="gg-section-label mt-5">May suit you if</dt>
      <dd class="mt-2 text-base leading-reading text-muted">{service.idealClient}</dd>
    </dl>
  )}
  <a
    class="gg-link mt-auto inline-flex min-h-11 items-center gap-2 pt-5 text-base font-medium focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary"
    href={getPermalink(`/services/${service.slug}`)}
  >
    Explore {service.name.toLowerCase()} <span aria-hidden="true">→</span>
  </a>
</article>
