---
export interface Props {
  name: string;
  description: string;
  href: string;
  label: string;
  linkText?: string;
}

const { name, description, href, label, linkText = `Explore ${name.toLowerCase()}` } = Astro.props;
---

<article class="service-preview min-w-0 py-2">
  <p class="service-preview-label mb-2 font-mono text-xs uppercase tracking-wider text-muted">{label}</p>
  <h3 class="gg-type-card-title text-heading">{name}</h3>
  <p class="service-preview-description mt-2 max-w-2xl text-base leading-relaxed text-muted">{description}</p>
  <a
    class="service-preview-link mt-3 inline-flex min-h-11 items-center gap-2 text-sm font-medium text-link underline-offset-4 hover:underline"
    href={href}
    aria-label={`Learn more about ${name}`}
  >
    {linkText} <span aria-hidden="true">↗</span>
  </a>
</article>
