---
export interface Props {
  number: string;
  name: string;
  description: string;
  href: string;
  label: string;
}

const { number, name, description, href, label } = Astro.props;
---

<article class="gg-card flex h-full flex-col p-4 lg:p-6">
  <div class="mb-4 flex items-start justify-between gap-4">
    <span class="flex h-10 w-10 items-center justify-center border border-border bg-surface-botanical font-mono text-xs text-brand">
      {number}
    </span>
    <span class="gg-badge font-mono">{label}</span>
  </div>
  <h3 class="gg-type-card-title mb-2 text-heading">{name}</h3>
  <p class="mb-4 text-base font-light leading-relaxed text-muted">{description}</p>
  <a
    class="mt-auto border-t border-border pt-4 text-xs font-medium text-default transition-colors hover:text-link-hover"
    href={href}
    aria-label={`Learn more about ${name}`}
  >
    LEARN MORE <span aria-hidden="true">↗</span>
  </a>
</article>
