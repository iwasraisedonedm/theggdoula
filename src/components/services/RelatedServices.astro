---
import { getPermalink } from '~/utils/permalinks';
import ServiceCard from '~/components/services/ServiceCard.astro';
import type { Service } from '~/data/services';

type RelatedService = Pick<Service, 'slug' | 'name' | 'stage' | 'summary'>;

export interface Props {
  services: RelatedService[];
  title: string;
  label?: string;
  actionText?: string;
}

const { services, title, label = 'Related support', actionText = 'View all services' } = Astro.props;
---

<section aria-labelledby="related-services-title" class="border-b border-border bg-surface-subtle">
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-16 lg:px-8 lg:py-20">
    <div class="mb-8 flex flex-col gap-4 border-b border-border pb-6 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="gg-section-label">{label}</p>
        <h2 id="related-services-title" class="gg-type-section-title mt-3 text-heading">
          {title}
        </h2>
      </div>
      <a class="gg-link inline-flex min-h-11 items-center text-base" href={getPermalink('/services')}>
        {actionText}
      </a>
    </div>
    <ul class="grid gap-4 md:grid-cols-2">
      {services.map((service) => (
        <li>
          <ServiceCard service={service} showBenefit={false} />
        </li>
      ))}
    </ul>
  </div>
</section>
