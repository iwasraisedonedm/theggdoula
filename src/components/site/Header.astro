---
import { Icon } from 'astro-icon/components';
import Logo from '~/components/Logo.astro';
import ToggleTheme from '~/components/common/ToggleTheme.astro';
import ToggleMenu from '~/components/common/ToggleMenu.astro';
import Button from '~/components/ui/Button.astro';

import { getHomePermalink } from '~/utils/permalinks';
import { trimSlash, getAsset } from '~/utils/permalinks';
import type { CallToAction } from '~/types';

interface Link {
  text?: string;
  href?: string;
  ariaLabel?: string;
  icon?: string;
}

interface MenuLink extends Link {
  links?: Array<MenuLink>;
}

export interface Props {
  id?: string;
  links?: Array<MenuLink>;
  actions?: Array<CallToAction>;
  isSticky?: boolean;
  isDark?: boolean;
  isFullWidth?: boolean;
  showToggleTheme?: boolean;
  showRssFeed?: boolean;
  position?: string;
}

const {
  id = 'header',
  links = [],
  actions = [],
  isSticky = false,
  isDark = false,
  isFullWidth = false,
  showToggleTheme = false,
  showRssFeed = false,
  position = 'center',
} = Astro.props;

const currentPath = `/${trimSlash(new URL(Astro.url).pathname)}`;
const navId = `${id}-navigation`;

// Compare paths without trailing slashes so the active link is detected
// regardless of the `trailingSlash` setting (`getPermalink()` emits `/contact/`
// when it is enabled, while `currentPath` above never has one, see #557).
const isActive = (href?: string) => typeof href === 'string' && `/${trimSlash(href)}` === currentPath;

// The header is kept across view transitions (transition:persist) so its state
// survives client-side navigations. Astro matches persisted elements by name,
// so hash the props that shape the markup to avoid reusing a header with stale content.
const persistKey = `header-${Array.from(
  JSON.stringify({ links, actions, isSticky, isDark, isFullWidth, showToggleTheme, showRssFeed, position })
)
  .reduce((hash, char) => (hash * 31 + char.charCodeAt(0)) >>> 0, 7)
  .toString(36)}`;
---

<gg-header transition:persist={persistKey}>
  <header
    class:list={[
      { sticky: isSticky, relative: !isSticky, dark: isDark },
      'top-0 z-40 mx-auto w-full flex-none border-b border-border bg-page transition-colors duration-standard ease-standard',
    ]}
    {...(isSticky ? { 'data-gg-sticky-header': true } : {})}
    {...(id ? { id } : {})}
  >
    <div class="absolute inset-0"></div>
    <div
      class:list={[
        'gg-site-container relative w-full py-3 text-default',
        {
          'lg:flex lg:justify-between': position !== 'center',
        },
        {
          'lg:grid lg:grid-cols-[1fr_auto_1fr] lg:items-center': position === 'center',
          'full-width': isFullWidth,
        },
      ]}
    >
      <div class:list={[{ 'mr-auto rtl:mr-0 rtl:ml-auto': position === 'right' }, 'flex items-center justify-between']}>
        <a class="gg-brand-link flex items-center rounded-control" href={getHomePermalink()} data-astro-prefetch>
          <Logo />
        </a>
        <div class="flex items-center lg:hidden">
          <ToggleMenu
            label="Open navigation"
            controls={navId}
            class="gg-menu-toggle group flex size-11 flex-col items-center justify-center rounded-control"
          />
        </div>
      </div>
      <nav
        id={navId}
        class="gg-header-nav hidden w-full overflow-x-hidden overflow-y-auto text-default lg:mx-5 lg:flex lg:w-auto lg:items-center lg:justify-self-center lg:overflow-visible"
        aria-label="Main navigation"
      >
        <ul class="flex w-full flex-col font-medium lg:w-auto lg:flex-row lg:justify-center lg:self-center">
          {links.map(({ text, href, links }, index) => (
            <li class:list={[{ 'dropdown group': links?.length }]}>
              {links?.length ? (
                <>
                  <button
                    type="button"
                    class:list={[
                      'gg-nav-link gg-nav-trigger flex w-full items-center justify-between whitespace-nowrap px-4 py-3 text-left lg:w-auto',
                      { 'gg-link-active': links.some((item) => isActive(item.href)) },
                    ]}
                    aria-expanded="false"
                    aria-controls={`${navId}-group-${index}`}
                  >
                    {text}{' '}
                    <Icon
                      name="tabler:chevron-down"
                      class="ml-2 h-4 w-4 shrink-0 transition-transform duration-fast group-[.dropdown-open]:rotate-180 lg:inline"
                    />
                  </button>
                  <ul id={`${navId}-group-${index}`} class="dropdown-menu">
                    {links.map(({ text: text2, href: href2 }) => (
                      <li>
                        <a
                          class:list={[
                            'gg-nav-link gg-subnav-link block whitespace-nowrap px-4 py-3 lg:py-2',
                            { 'gg-link-active': isActive(href2) },
                          ]}
                          href={href2}
                          aria-current={isActive(href2) ? 'page' : undefined}
                          data-astro-prefetch
                        >
                          {text2}
                        </a>
                      </li>
                    ))}
                  </ul>
                </>
              ) : (
                <a
                  class:list={[
                    'gg-nav-link flex items-center whitespace-nowrap px-4 py-3',
                    { 'gg-link-active': isActive(href) },
                  ]}
                  href={href}
                  aria-current={isActive(href) ? 'page' : undefined}
                  data-astro-prefetch
                >
                  {text}
                </a>
              )}
            </li>
          ))}
        </ul>
      </nav>
      <div
        data-header-actions
        class:list={[
          { 'ml-auto rtl:ml-0 rtl:mr-auto': position === 'left' },
          'gg-header-actions fixed bottom-0 left-0 z-10 hidden w-full items-center justify-end border-t border-border bg-page p-4 lg:static lg:z-auto lg:flex lg:w-auto lg:border-0 lg:bg-transparent lg:p-0 lg:justify-self-end',
        ]}
      >
        <div class="items-center flex justify-between w-full lg:w-auto">
          <div class="flex">
            {showToggleTheme && <ToggleTheme iconClass="w-6 h-6 lg:w-5 lg:h-5 lg:inline-block" />}
            {showRssFeed && (
              <a
                class="gg-icon-button inline-flex items-center rounded-control p-2.5 text-muted"
                aria-label="RSS Feed"
                href={getAsset('/rss.xml')}
              >
                <Icon name="tabler:rss" class="w-5 h-5" />
              </a>
            )}
          </div>
          {actions?.length ? (
            <span class="ml-4 rtl:ml-0 rtl:mr-4">
              {actions.map((btnProps) => (
                <Button {...btnProps} class="w-full px-4 py-2.5 text-base font-semibold lg:w-auto" />
              ))}
            </span>
          ) : (
            ''
          )}
        </div>
      </div>
    </div>
  </header>
</gg-header>

<style>
  gg-header {
    display: contents;
  }
</style>

<script>
  class GGHeader extends HTMLElement {
    private onScroll?: () => void;
    private mql?: MediaQueryList;
    private onMqlChange?: () => void;
    private onKeyDown?: (event: KeyboardEvent) => void;
    private onPageLoad = () => {
      this.updateActiveLinks();
      this.closeOpenDropdown();
    };

    connectedCallback() {
      const header = this.querySelector<HTMLElement>('header');
      const toggle = this.querySelector<HTMLElement>('[data-gg-toggle-menu]');
      const nav = this.querySelector<HTMLElement>('nav[aria-label="Main navigation"]');
      const actions = this.querySelector<HTMLElement>('[data-header-actions]');

      // The header persists across view transitions (transition:persist), so
      // the server-rendered `gg-link-active` class would go stale. Re-compute it
      // on every navigation (astro:page-load fires on load and after each swap).
      this.updateActiveLinks();
      document.addEventListener('astro:page-load', this.onPageLoad);

      const closeMenu = (restoreFocus = false) => {
        toggle?.classList.remove('expanded');
        toggle?.setAttribute('aria-expanded', 'false');
        toggle?.setAttribute('aria-label', 'Open navigation');
        toggle?.querySelector('[data-gg-toggle-label]')?.replaceChildren('Open navigation');
        document.body.classList.remove('overflow-hidden');
        header?.classList.remove('expanded', 'bg-page');
        nav?.classList.add('hidden');
        actions?.classList.add('hidden');
        this.querySelectorAll<HTMLLIElement>('.dropdown.dropdown-open').forEach((item) => {
          item.classList.remove('dropdown-open');
          item.querySelector('.gg-nav-trigger')?.setAttribute('aria-expanded', 'false');
        });
        if (restoreFocus) toggle?.focus();
      };

      // Mobile menu toggle.
      toggle?.addEventListener('click', () => {
        const expanded = toggle.classList.toggle('expanded');
        toggle.setAttribute('aria-expanded', String(expanded));
        toggle.setAttribute('aria-label', expanded ? 'Close navigation' : 'Open navigation');
        toggle
          .querySelector('[data-gg-toggle-label]')
          ?.replaceChildren(expanded ? 'Close navigation' : 'Open navigation');
        document.body.classList.toggle('overflow-hidden');
        header?.classList.toggle('expanded');
        header?.classList.toggle('bg-page');
        nav?.classList.toggle('hidden');
        actions?.classList.toggle('hidden');
      });

      nav?.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        const trigger = target.closest<HTMLButtonElement>('.gg-nav-trigger');
        if (trigger) {
          const item = trigger.closest<HTMLLIElement>('.dropdown');
          const keptOpenByHover = item?.hasAttribute('data-hover-open') && e instanceof MouseEvent && e.detail > 0;
          if (keptOpenByHover) item?.removeAttribute('data-hover-open');
          const expanded = keptOpenByHover ? true : (item?.classList.toggle('dropdown-open') ?? false);
          if (keptOpenByHover) item?.classList.add('dropdown-open');
          trigger.setAttribute('aria-expanded', String(expanded));
          if (!expanded) trigger.blur();
          return;
        }
        const link = target.closest<HTMLAnchorElement>('a[href]');
        if (link) closeMenu();
      });

      nav?.addEventListener('focusout', (e) => {
        const target = e.target as HTMLElement;
        const item = target.closest<HTMLLIElement>('.dropdown');
        if (item && !item.contains(e.relatedTarget as Node | null)) {
          item.classList.remove('dropdown-open');
          item.querySelector('.gg-nav-trigger')?.setAttribute('aria-expanded', 'false');
        }
      });
      nav?.querySelectorAll<HTMLLIElement>('.dropdown').forEach((item) => {
        item.addEventListener('mouseenter', () => {
          item.classList.add('dropdown-open');
          item.setAttribute('data-hover-open', 'true');
          item.querySelector('.gg-nav-trigger')?.setAttribute('aria-expanded', 'true');
        });
        item.addEventListener('mouseleave', () => {
          item.removeAttribute('data-hover-open');
          if (!item.matches(':focus-within')) {
            item.classList.remove('dropdown-open');
            item.querySelector('.gg-nav-trigger')?.setAttribute('aria-expanded', 'false');
          }
        });
      });

      this.onKeyDown = (event) => {
        if (event.key === 'Tab' && toggle?.getAttribute('aria-expanded') === 'true') {
          const focusable = Array.from(this.querySelectorAll<HTMLElement>('a[href], button:not([disabled])')).filter(
            (element) => element.getClientRects().length > 0
          );
          const first = focusable[0];
          const last = focusable[focusable.length - 1];
          if (event.shiftKey && document.activeElement === first) {
            event.preventDefault();
            last?.focus();
          } else if (!event.shiftKey && document.activeElement === last) {
            event.preventDefault();
            first?.focus();
          }
          return;
        }

        if (event.key === 'Escape') {
          const dropdown = (event.target as HTMLElement).closest<HTMLLIElement>('.dropdown');
          if (dropdown) {
            dropdown.classList.remove('dropdown-open');
            dropdown.querySelector('.gg-nav-trigger')?.setAttribute('aria-expanded', 'false');
            this.querySelector<HTMLAnchorElement>('.gg-brand-link')?.focus();
          } else if (toggle?.getAttribute('aria-expanded') === 'true') {
            closeMenu(true);
          }
        }
      };
      this.addEventListener('keydown', this.onKeyDown);

      // Close it when leaving the mobile/tablet breakpoint (desktop nav starts at `lg`).
      this.mql = window.matchMedia('(max-width: 1023px)');
      this.onMqlChange = () => closeMenu();
      this.mql.addEventListener('change', this.onMqlChange);

      // Sticky header: toggle the `scroll` class past a small threshold.
      if (header?.hasAttribute('data-gg-sticky-header')) {
        let ticking = false;
        const applyStyles = () => {
          if (window.scrollY > 60) header.classList.add('scroll');
          else header.classList.remove('scroll');
          ticking = false;
        };
        this.onScroll = () => {
          if (!ticking) {
            window.requestAnimationFrame(applyStyles);
            ticking = true;
          }
        };
        applyStyles();
        document.addEventListener('scroll', this.onScroll, { passive: true });
      }

      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('scroll-smooth');
      }
    }

    disconnectedCallback() {
      if (this.onScroll) document.removeEventListener('scroll', this.onScroll);
      if (this.mql && this.onMqlChange) this.mql.removeEventListener('change', this.onMqlChange);
      document.removeEventListener('astro:page-load', this.onPageLoad);
      if (this.onKeyDown) this.removeEventListener('keydown', this.onKeyDown);
    }

    // With `transition:persist` the header (and its focus) survives client-side
    // navigations, so a clicked dropdown link keeps `:focus-within` and its menu
    // would stay open on the next page. Drop the focus so the CSS closes it.
    private closeOpenDropdown() {
      const active = document.activeElement as HTMLElement | null;
      if (active && this.contains(active) && active.closest('.dropdown')) active.blur();
    }

    private updateActiveLinks() {
      const norm = (p: string) => '/' + p.replace(/^\/+|\/+$/g, '');
      const current = norm(window.location.pathname);
      this.querySelectorAll<HTMLAnchorElement>('nav a[href]').forEach((a) => {
        const url = new URL(a.href, window.location.href);
        // Anchor-only links (`#`, `/#features`) resolve to the current page and
        // would light up everywhere; only path links can be "the current page".
        const isPathLink =
          url.origin === window.location.origin && !url.hash && !a.getAttribute('href')?.startsWith('#');
        const active = isPathLink && norm(url.pathname) === current;
        a.classList.toggle('gg-link-active', active);
        if (active) a.setAttribute('aria-current', 'page');
        else a.removeAttribute('aria-current');
      });
      this.querySelectorAll<HTMLLIElement>('.dropdown').forEach((item) => {
        const active = !!item.querySelector('.dropdown-menu .gg-link-active');
        item.querySelector('.gg-nav-trigger')?.classList.toggle('gg-link-active', active);
      });
    }
  }

  if (!customElements.get('gg-header')) {
    customElements.define('gg-header', GGHeader);
  }
</script>
