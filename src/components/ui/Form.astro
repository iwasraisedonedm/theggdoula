---
import type { Form as Props } from '~/types';
import Button from '~/components/ui/Button.astro';

const { inputs, textarea, disclaimer, button = 'Contact us', description = '' } = Astro.props;
---

<form>
  {inputs &&
    inputs.map(
      ({ type = 'text', name, label = '', autocomplete = 'on', placeholder = '' }) =>
        name && (
          <div class="mb-6">
            {label && (
              <label for={name} class="mb-2 block text-base font-medium text-heading">
                {label}
              </label>
            )}
            <input
              type={type}
              name={name}
              id={name}
              autocomplete={autocomplete}
              placeholder={placeholder}
              class="gg-field"
            />
          </div>
        )
    )}

  {textarea && (
    <div>
      <label for="textarea" class="mb-2 block text-base font-medium text-heading">
        {textarea.label}
      </label>
      <textarea
        id="textarea"
        name={textarea.name ? textarea.name : 'message'}
        rows={textarea.rows ? textarea.rows : 4}
        placeholder={textarea.placeholder}
        class="gg-field"
      />
    </div>
  )}

  {disclaimer && (
    <div class="mt-3 flex items-start">
      <div class="flex mt-0.5">
        <input id="disclaimer" name="disclaimer" type="checkbox" class="gg-checkbox mt-1 size-4 cursor-pointer" />
      </div>
      <div class="ml-3">
        <label for="disclaimer" class="cursor-pointer select-none text-base text-muted">
          {disclaimer.label}
        </label>
      </div>
    </div>
  )}

  {button && (
    <div class="mt-10 grid">
      <Button variant="primary" type="submit">
        {button}
      </Button>
    </div>
  )}

  {description && (
    <div class="mt-3 text-center">
      <p class="text-base text-muted">{description}</p>
    </div>
  )}
</form>
