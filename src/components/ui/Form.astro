---
import type { Form as Props } from '~/types';
import Button from '~/components/ui/Button.astro';

const {
  action,
  button = 'Contact us',
  buttonIcon,
  description = '',
  disclaimer,
  honeypot = false,
  id = 'contact-form',
  inputs,
  method = 'post',
  select,
  textarea,
} = Astro.props;
---

<form id={id} method={method} action={action} data-formspree={action?.includes('formspree.io') ? 'true' : undefined}>
  {inputs &&
    inputs.map(
      ({ type = 'text', name, label = '', autocomplete = 'on', placeholder = '', required = false, classes = '' }) =>
        name && (
          <div class="mb-6">
            {label && (
              <label for={name} class="mb-2 block text-base font-medium text-heading">
                {label}
                {required && (
                  <span aria-hidden="true" class="ml-1 text-brand">
                    *
                  </span>
                )}
              </label>
            )}
            <input
              type={type}
              name={name}
              id={name}
              autocomplete={autocomplete}
              placeholder={placeholder}
              required={required}
              aria-describedby={`${name}-error`}
              class={`gg-field ${classes}`}
              data-form-field={name}
            />
            <p id={`${name}-error`} class="mt-2 text-sm text-feedback-error" data-field-error={name} hidden />
          </div>
        )
    )}

  {select && (
    <div class="mb-6">
      <label for={select.name} class="mb-2 block text-base font-medium text-heading">
        {select.label}
        {select.required && (
          <span aria-hidden="true" class="ml-1 text-brand">
            *
          </span>
        )}
      </label>
      <select
        id={select.name}
        name={select.name}
        required={select.required}
        aria-describedby={`${select.name}-error`}
        class={`gg-field ${select.classes ?? ''}`}
        data-form-field={select.name}
      >
        <option value="" disabled selected>
          {select.placeholder ?? 'Choose a topic'}
        </option>
        {select.options.map((option) => (
          <option value={option.value}>{option.label}</option>
        ))}
      </select>
      <p id={`${select.name}-error`} class="mt-2 text-sm text-feedback-error" data-field-error={select.name} hidden />
    </div>
  )}

  {textarea && (
    <div class="mb-6">
      <label for="textarea" class="mb-2 block text-base font-medium text-heading">
        {textarea.label}
        {textarea.required && (
          <span aria-hidden="true" class="ml-1 text-brand">
            *
          </span>
        )}
      </label>
      <textarea
        id="textarea"
        name={textarea.name ? textarea.name : 'message'}
        rows={textarea.rows ? textarea.rows : 4}
        placeholder={textarea.placeholder}
        required={textarea.required}
        aria-describedby={`${textarea.name ? textarea.name : 'message'}-error`}
        class={`gg-field ${textarea.classes ?? ''}`}
        data-form-field={textarea.name ? textarea.name : 'message'}
      />
      <p
        id={`${textarea.name ? textarea.name : 'message'}-error`}
        class="mt-2 text-sm text-feedback-error"
        data-field-error={textarea.name ? textarea.name : 'message'}
        hidden
      />
    </div>
  )}

  {honeypot && (
    <div class="pointer-events-none absolute -left-[10000px] h-px w-px overflow-hidden" aria-hidden="true">
      <label for={`${id}-website`}>Leave this field empty</label>
      <input id={`${id}-website`} type="text" name="_gotcha" tabindex="-1" autocomplete="off" />
    </div>
  )}

  {disclaimer && (
    <div class="mt-3 flex items-start">
      <div class="mt-0.5 flex">
        <input id="disclaimer" name="disclaimer" type="checkbox" class="gg-checkbox mt-1 size-4 cursor-pointer" />
      </div>
      <div class="ml-3">
        <label for="disclaimer" class="cursor-pointer select-none text-base text-muted">
          {disclaimer.label}
        </label>
      </div>
    </div>
  )}

  {button && (
    <div class="mt-8 grid">
      <Button variant="primary" type="submit" icon={buttonIcon} class="w-full" data-submit-button>
        <span data-submit-label>{button}</span>
      </Button>
    </div>
  )}

  {description && (
    <div class="mt-3">
      <p class="text-sm leading-reading text-muted">{description}</p>
    </div>
  )}

  {action?.includes('formspree.io') && (
    <p
      class="mt-5 rounded-surface border border-border bg-surface-subtle p-4 text-sm leading-reading text-default"
      data-form-status
      data-state="idle"
      role="status"
      aria-live="polite"
      hidden
    />
  )}
</form>

<script>
  const initFormspreeForms = () => {
    document.querySelectorAll<HTMLFormElement>('form[data-formspree="true"]').forEach((form) => {
      if (form.dataset.formspreeInitialized === 'true') return;
      form.dataset.formspreeInitialized = 'true';

      const status = form.querySelector<HTMLElement>('[data-form-status]');
      const submitButton = form.querySelector<HTMLButtonElement>('[data-submit-button]');
      const submitLabel = submitButton?.querySelector<HTMLElement>('[data-submit-label]');
      if (!status || !submitButton || !submitLabel) return;

      const clearFieldError = (field: HTMLElement) => {
        const name = field.dataset.formField;
        if (!name) return;
        field.removeAttribute('aria-invalid');
        const error = Array.from(form.querySelectorAll<HTMLElement>('[data-field-error]')).find(
          (item) => item.dataset.fieldError === name
        );
        if (error) {
          error.hidden = true;
          error.textContent = '';
        }
      };

      form.addEventListener('input', (event) => {
        if (event.target instanceof HTMLElement && event.target.matches('[data-form-field]')) {
          clearFieldError(event.target);
        }
      });
      form.addEventListener('change', (event) => {
        if (event.target instanceof HTMLElement && event.target.matches('[data-form-field]')) {
          clearFieldError(event.target);
        }
      });

      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (form.dataset.submitting === 'true' || !form.reportValidity()) return;

        const payload = new FormData(form);
        const originalButtonText = submitLabel.textContent ?? 'Send inquiry';
        form.dataset.submitting = 'true';
        form.setAttribute('aria-busy', 'true');
        submitButton.disabled = true;
        submitLabel.textContent = 'Sending…';
        status.hidden = false;
        status.setAttribute('role', 'status');
        status.dataset.state = 'loading';
        status.textContent = 'Sending your inquiry…';

        try {
          const response = await fetch(form.action, {
            method: 'POST',
            body: payload,
            headers: { Accept: 'application/json' },
          });
          const result = await response.json().catch(() => ({}));

          if (response.ok) {
            form.reset();
            status.dataset.state = 'success';
            status.textContent =
              'Thank you. Formspree accepted your inquiry. If you need to follow up, use the email or phone details on this page.';
            return;
          }

          const fieldErrors = Array.isArray(result.errors) ? result.errors : [];
          fieldErrors.forEach((fieldError: { field?: string; message?: string }) => {
            if (!fieldError.field || !fieldError.message) return;
            const input = Array.from(form.querySelectorAll<HTMLElement>('[data-form-field]')).find(
              (item) => item.dataset.formField === fieldError.field
            );
            const error = Array.from(form.querySelectorAll<HTMLElement>('[data-field-error]')).find(
              (item) => item.dataset.fieldError === fieldError.field
            );
            if (input && error) {
              input.setAttribute('aria-invalid', 'true');
              error.hidden = false;
              error.textContent = fieldError.message;
            }
          });

          status.setAttribute('role', 'alert');
          status.dataset.state = 'error';
          status.textContent =
            response.status === 429
              ? 'The form is receiving too many requests. Please wait a moment and try again.'
              : fieldErrors.length
                ? 'Please review the marked fields and try again.'
                : 'We could not send your inquiry. Your entries are still here; please try again or email Teesee.';
        } catch {
          status.setAttribute('role', 'alert');
          status.dataset.state = 'error';
          status.textContent =
            'We could not reach the form service. Your entries are still here; please try again or email Teesee.';
        } finally {
          form.dataset.submitting = 'false';
          form.removeAttribute('aria-busy');
          submitButton.disabled = false;
          submitLabel.textContent = originalButtonText;
        }
      });
    });
  };

  document.addEventListener('astro:page-load', initFormspreeForms);
  initFormspreeForms();
</script>
