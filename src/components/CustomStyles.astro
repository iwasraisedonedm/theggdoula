---
/** Site-owned font face for the editorial display role. */
---

<style is:inline>
  @font-face {
    font-family: 'Newsreader';
    font-style: normal;
    font-weight: 300 600;
    font-display: swap;
    src: url('/fonts/newsreader-latin.woff2') format('woff2');
  }
</style>

<style is:inline>
  :root {
    --gg-font-display: var(--gg-type-font-display);
    --gg-color-border: var(--gg-color-field-border);
    --gg-color-on-primary: var(--gg-color-on-brand);
    --gg-color-divider: var(--gg-border-color-divider);
    --gg-layout-content: 65ch;
    --gg-layout-reading: 65ch;
    --gg-layout-site: 72rem;
    --gg-layout-section-sm: 3rem;
    --gg-layout-section-md: 4rem;
    --gg-layout-section-lg: 6rem;
    --gg-layout-grid-gap: 1.5rem;
    --gg-radius-pill: 0;
    --gg-shadow-surface: none;
    --gg-transition-fast: 150ms;
    --gg-transition-standard: 200ms;
    --gg-transition-slow: 250ms;
    --gg-ease-standard: cubic-bezier(0.2, 0, 0, 1);
    --gg-focus-width: var(--gg-border-focus-width);
    --gg-focus-offset: 2px;
  }
</style>
