---
// Brand typography: Inter for body, UI, and headings; system monospace is
// reserved for small editorial labels.
---

<style is:inline>
  :root {
    --aw-font-sans: var(--font-inter);
    --aw-font-serif: var(--font-inter);
    --aw-font-heading: var(--font-inter);

    --aw-color-primary: var(--gg-color-brand);
    --aw-color-secondary: var(--gg-color-brand-hover);
    --aw-color-accent: var(--gg-color-surface-botanical);
    --aw-color-link: var(--gg-color-link);

    --aw-color-text-heading: var(--gg-color-text-heading);
    --aw-color-text-default: var(--gg-color-text-body);
    --aw-color-text-muted: var(--gg-color-text-muted);
    --aw-color-bg-page: var(--gg-color-canvas);
    --aw-color-bg-page-dark: var(--gg-color-canvas-dark);
    --gg-color-border: var(--gg-color-field-border);
    --gg-color-on-primary: var(--gg-color-on-brand);
    --gg-color-on-surface: var(--aw-color-text-default);
    --gg-color-divider: var(--gg-border-color-divider);

    --gg-type-body-size: 1rem;
    --gg-type-body-leading: 1.65;
    --gg-type-heading-leading: 1.15;
    --gg-type-tight-tracking: -0.025em;
    --gg-type-label-tracking: 0.08em;

    --gg-layout-content: 65ch;
    --gg-layout-reading: 65ch;
    --gg-layout-site: 72rem;
    --gg-layout-section-sm: 3rem;
    --gg-layout-section-md: 4rem;
    --gg-layout-section-lg: 6rem;
    --gg-layout-grid-gap: 1.5rem;

    --gg-radius-pill: 0;
    --gg-shadow-surface: none;
    --gg-transition-fast: 150ms;
    --gg-transition-standard: 200ms;
    --gg-transition-slow: 250ms;
    --gg-ease-standard: cubic-bezier(0.2, 0, 0, 1);
    --gg-focus-width: var(--gg-border-focus-width);
    --gg-focus-offset: 2px;
    color-scheme: light;

    ::selection {
      background-color: var(--gg-color-selection);
      color: var(--gg-color-selection-text);
    }
  }

  .dark {
    --aw-font-sans: var(--font-inter);
    --aw-font-serif: var(--font-inter);
    --aw-font-heading: var(--font-inter);

    --aw-color-primary: var(--gg-color-brand);
    --aw-color-secondary: var(--gg-color-brand-hover);
    --aw-color-accent: var(--gg-color-surface-botanical);
    --aw-color-link: var(--gg-color-link);

    --aw-color-text-heading: var(--gg-color-text-heading);
    --aw-color-text-default: var(--gg-color-text-body);
    --aw-color-text-muted: var(--gg-color-text-muted);
    --aw-color-bg-page: var(--gg-color-canvas);
    --gg-color-border: var(--gg-color-field-border);
    --gg-color-on-primary: var(--gg-color-on-brand);
    --gg-color-on-surface: var(--aw-color-text-default);
    --gg-color-divider: var(--gg-border-color-divider);
    color-scheme: dark;

    ::selection {
      background-color: var(--gg-color-selection);
      color: var(--gg-color-selection-text);
    }
  }
</style>
