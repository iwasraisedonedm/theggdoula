---
import Button from '~/components/ui/Button.astro';
import { getPermalink } from '~/utils/permalinks';

const steps = [
  {
    label: '01 · EXPLORE',
    title: 'Explore care options',
    description:
      'Review prenatal, birth, postpartum, breastfeeding, and newborn care to see what you would like to learn more about.',
    href: getPermalink('/services'),
    action: 'Explore services',
  },
  {
    label: '02 · CONSULT',
    title: 'Book a consultation',
    description:
      'Book a free 30-minute consultation with Teesee. Current availability and meeting options appear on Cal.com.',
    href: getPermalink('/book'),
    action: 'Book a free consultation',
  },
  {
    label: '03 · DECIDE',
    title: 'Choose your next step',
    description:
      'Use the consultation to discuss your questions, preferences, and support needs. There is no obligation to book care.',
  },
];
---

<section id="client-journey" class="process-overview bg-surface-subtle" aria-labelledby="process-title">
  <div class="process-rail">
    <header class="process-intro">
      <p class="process-kicker">How it works</p>
      <h2 id="process-title" class="process-heading">
        A simple way to get started
      </h2>
      <p class="process-summary">Explore care, have a free consultation, and decide what feels right for you.</p>

      <div class="process-action">
        <p>Have a question before booking? Send Teesee a message.</p>
        <Button variant="primary" href={getPermalink('/contact')} class="process-cta">
          Send a message
        </Button>
      </div>
    </header>

    <ol class="process-steps">
      {steps.map((step) => (
        <li class="process-step">
          <p class="process-label">{step.label}</p>
          <h3>{step.title}</h3>
          <p class="process-description">{step.description}</p>
          {step.href && (
            <a class="process-link" href={step.href}>
              {step.action} <span aria-hidden="true">→</span>
            </a>
          )}
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .process-overview {
    color: var(--gg-color-text-body);
    scroll-margin-top: 6rem;
  }

  .process-rail {
    display: grid;
    width: min(100%, 80rem);
    grid-template-columns: minmax(15rem, 0.8fr) minmax(0, 2fr);
    align-items: start;
    gap: clamp(1.5rem, 3vw, 3rem);
    margin-inline: auto;
    padding: clamp(3rem, 6vw, 5.5rem) clamp(1.5rem, 5vw, 4rem);
  }

  .process-intro {
    max-width: 28rem;
  }

  .process-label {
    color: var(--gg-color-brand);
    font-family: var(--gg-type-font-label), ui-monospace, monospace;
    font-size: var(--gg-type-label-size);
    font-weight: var(--gg-type-weight-heading);
    letter-spacing: var(--gg-type-label-tracking);
    line-height: var(--gg-type-label-leading);
    text-transform: uppercase;
  }

  .process-heading {
    margin: 0;
    color: var(--gg-color-text-heading);
    font-family: var(--gg-font-display);
    font-size: var(--gg-type-editorial-card-size);
    font-weight: var(--gg-type-editorial-weight);
    letter-spacing: var(--gg-type-editorial-tracking);
    line-height: var(--gg-type-editorial-section-leading);
    text-wrap: balance;
  }

  .process-summary,
  .process-action p,
  .process-description {
    color: var(--gg-color-text-body);
    font-size: var(--gg-type-body-size);
    line-height: var(--gg-type-body-leading);
    text-wrap: pretty;
  }

  .process-summary {
    max-width: 38ch;
    margin: 0.75rem 0 0;
  }

  .process-action {
    display: grid;
    justify-items: start;
    gap: 0.75rem;
    margin-top: 1.5rem;
    padding-top: 0.5rem;
  }

  .process-action p {
    margin: 0;
  }

  .process-cta {
    min-height: 2.75rem;
    border-radius: 0 !important;
    font-size: var(--gg-type-body-small-size) !important;
  }

  .process-steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(0.75rem, 1.5vw, 1.5rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .process-step {
    min-width: 0;
    padding-top: 0;
  }

  .process-label {
    margin: 0;
  }

  .process-step h3 {
    margin: 0.75rem 0 0.5rem;
    color: var(--gg-color-text-heading);
    font-family: var(--gg-font-display);
    font-size: var(--gg-type-editorial-step-size);
    font-weight: var(--gg-type-editorial-weight);
    letter-spacing: var(--gg-type-editorial-tracking);
    line-height: var(--gg-type-card-title-leading);
    text-wrap: balance;
  }

  .process-description {
    max-width: 34ch;
    margin: 0;
  }

  .process-link {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    gap: 0.375rem;
    margin-top: 0.75rem;
    color: var(--gg-color-link);
    font-size: var(--gg-type-body-small-size);
    font-weight: var(--gg-type-weight-strong);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 0.2em;
  }

  .process-link:hover {
    text-decoration-color: currentColor;
  }

  .process-link:focus-visible,
  .process-cta:focus-visible {
    border-radius: 0;
    outline: 2px solid var(--gg-color-focus);
    outline-offset: 3px;
  }

  @media (max-width: 1023px) {
    .process-rail {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.5rem;
    }

    .process-steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1rem;
    }
  }

  @media (max-width: 639px) {
    .process-steps {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
