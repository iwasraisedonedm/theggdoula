---
import { Icon } from 'astro-icon/components';
import Logo from '~/components/Logo.astro';
import { getHomePermalink } from '~/utils/permalinks';
import { CONSULTATION_LINK } from '~/navigation';
import Button from '~/components/ui/Button.astro';

interface Link {
  text?: string;
  href?: string;
  ariaLabel?: string;
  icon?: string;
}

interface Links {
  title?: string;
  links: Array<Link>;
}

export interface Props {
  links: Array<Links>;
  secondaryLinks: Array<Link>;
  socialLinks: Array<Link>;
  footNote?: string;
  theme?: string;
}

const { socialLinks = [], secondaryLinks = [], links = [], footNote = '', theme = 'light' } = Astro.props;
---

<footer class:list={[{ dark: theme === 'dark' }, 'gg-footer not-prose border-t-2 border-border bg-page']}>
  <div class="gg-site-container gg-footer-main-container">
    <div class="grid grid-cols-2 gap-x-6 gap-y-8 md:grid-cols-4 md:gap-x-8 lg:grid-cols-12 lg:gap-x-10">
      <div class="col-span-2 md:col-span-4 lg:col-span-4">
        <a class="gg-brand-link inline-flex items-center rounded-none" href={getHomePermalink()} data-astro-prefetch>
          <Logo />
        </a>
        <p class="mt-4 max-w-sm text-sm leading-relaxed text-muted">
          Thoughtful support for pregnancy, birth, and life with a new baby across Orange County.
        </p>
        {secondaryLinks.length > 0 && (
          <div class="mt-4 flex flex-wrap gap-x-2 text-sm text-muted">
            {secondaryLinks.map(({ text, href }, index) => (
              <>
                {index !== 0 ? ' · ' : ''}
                <a class="gg-footer-link" href={href} set:html={text} />
              </>
            ))}
          </div>
        )}
        <Button variant="primary" href={CONSULTATION_LINK} class="mt-5 rounded-none px-4 py-2.5 text-sm">
          Book now
        </Button>
      </div>
      <nav
        class="col-span-2 grid grid-cols-2 gap-x-6 gap-y-8 md:col-span-4 md:grid-cols-4 md:gap-x-6 lg:col-span-8 lg:gap-x-8"
        aria-label="Footer sitemap"
      >
        {links.map(({ title, links }) => (
          <div class="col-span-1">
            <h2 class="mb-4 font-mono text-[0.6875rem] font-semibold uppercase tracking-[0.12em] text-heading">
              {title}
            </h2>
            {links && Array.isArray(links) && links.length > 0 && (
              <ul class="space-y-3 text-[0.9375rem] leading-relaxed">
                {links.map(({ text, href, ariaLabel }) => (
                  <li>
                    <a class="gg-footer-link" href={href} aria-label={ariaLabel}>
                      <Fragment set:html={text} />
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </div>
        ))}
      </nav>
    </div>
  </div>
  <div class="border-t border-border bg-surface-subtle">
    <div class="gg-site-container gg-footer-legal-container flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
      <div class="text-[0.8125rem] text-muted">
        <Fragment set:html={footNote} />
      </div>
      {socialLinks?.length ? (
        <ul class="flex items-center gap-1 sm:justify-end">
          {socialLinks.map(({ ariaLabel, href, text, icon }) => (
            <li>
              <a
                class="gg-icon-button inline-flex size-9 items-center justify-center border border-transparent text-muted transition-colors hover:border-border rounded-none"
                aria-label={ariaLabel}
                href={href}
              >
                {icon && <Icon name={icon} class="size-4" />}
                <Fragment set:html={text} />
              </a>
            </li>
          ))}
        </ul>
      ) : (
        ''
      )}
    </div>
  </div>
</footer>
