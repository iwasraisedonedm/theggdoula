---
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import type { CallToAction, Widget } from '~/types';
import Headline from '~/components/ui/Headline.astro';
import Button from '~/components/ui/Button.astro';

interface Props extends Widget {
  title?: string;
  subtitle?: string;
  tagline?: string;
  callToAction?: CallToAction;
  actions?: string | CallToAction[];
  /** `card` (boxed, centred) or `banner` (full-width band on the primary colour). */
  layout?: 'card' | 'banner';
}

const {
  title = await Astro.slots.render('title'),
  subtitle = await Astro.slots.render('subtitle'),
  tagline = await Astro.slots.render('tagline'),
  actions = await Astro.slots.render('actions'),
  layout = 'card',

  id,
  isDark = false,
  classes = {},
  bg = await Astro.slots.render('bg'),
} = Astro.props;
---

<WidgetWrapper id={id} isDark={isDark} containerClass={`max-w-6xl mx-auto ${classes?.container ?? ''}`} bg={bg}>
  <div
    class:list={[
      'text-left',
      layout === 'banner'
        ? 'mx-auto rounded-surface bg-brand px-6 py-12 text-on-brand md:py-16'
        : 'gg-card mx-auto max-w-3xl p-6 md:p-8',
    ]}
  >
    <Headline
      title={title}
      subtitle={subtitle}
      tagline={tagline}
      classes={{
        container: 'mb-0 md:mb-0',
        title: `text-title mb-4 font-semibold tracking-heading ${layout === 'banner' ? 'text-on-brand' : ''}`,
        subtitle: layout === 'banner' ? 'text-xl text-on-brand' : 'text-xl text-muted',
        ...((classes?.headline as Record<string, string>) ?? {}),
      }}
    />
    {actions && (
      <div class="mt-6 flex max-w-xs flex-col gap-4 sm:max-w-md sm:flex-row sm:flex-nowrap">
        {Array.isArray(actions) ? (
          actions.map((action) => (
            <div class="flex w-full sm:w-auto">
              <Button
                {...(action || {})}
                class:list={[
                  'w-full sm:mb-0 whitespace-nowrap',
                  layout === 'banner' && action?.variant === 'primary'
                    ? 'border-surface bg-surface text-brand hover:border-surface-subtle hover:bg-surface-subtle hover:text-brand'
                    : layout === 'banner'
                      ? 'border-current text-on-brand hover:bg-white/10 hover:text-on-brand'
                      : '',
                ]}
              />
            </div>
          ))
        ) : (
          <Fragment set:html={actions} />
        )}
      </div>
    )}
  </div>
</WidgetWrapper>
