---
import { UI } from 'astrowind:config';
---

<script is:inline define:vars={{ defaultTheme: UI.theme || 'system' }}>
  // Single source of truth for *applying* the color theme.
  //
  // This runs inline in the <head> so the `.dark` class is set before first
  // paint (anti-FOUC — it must not be deferred/bundled). It also registers an
  // `astro:after-swap` listener so the theme is re-applied on client-side
  // navigations with <ClientRouter />. Toggling the theme is owned by the
  // <aw-theme-toggle> custom element (see ToggleTheme.astro).
  function applyTheme(theme) {
    document.documentElement.classList[theme === 'dark' ? 'add' : 'remove']('dark');
  }

  function getManualTheme() {
    try {
      const theme = localStorage.getItem('theme');
      return theme === 'light' || theme === 'dark' ? theme : null;
    } catch {
      return null;
    }
  }

  function resolveTheme() {
    const fixedTheme = (defaultTheme || 'system').replace(':only', '');
    if (defaultTheme?.endsWith(':only')) return fixedTheme;
    const manualTheme = getManualTheme();
    if (manualTheme) return manualTheme;
    if (fixedTheme !== 'system') return fixedTheme;
    return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
  }

  applyTheme(resolveTheme());

  // `document` persists across view transitions, so install these once and
  // reapply the current preference after each navigation.
  if (!window.__ggThemeRuntimeInstalled) {
    document.addEventListener('astro:after-swap', () => applyTheme(resolveTheme()));
    if ((defaultTheme || 'system') === 'system') {
      const systemPreference = window.matchMedia('(prefers-color-scheme: dark)');
      const handleSystemChange = () => {
        if (!getManualTheme()) applyTheme(resolveTheme());
      };
      if (systemPreference.addEventListener) systemPreference.addEventListener('change', handleSystemChange);
      else systemPreference.addListener(handleSystemChange);
    }
    window.__ggThemeRuntimeInstalled = true;
  }
</script>
