---
import { Icon } from 'astro-icon/components';

import { UI } from 'astrowind:config';

export interface Props {
  label?: string;
  class?: string;
  iconClass?: string;
  /** Icon shown in light mode (it invites to switch to dark). */
  iconName?: string;
  /** Icon shown in dark mode. */
  iconNameDark?: string;
}

const {
  label = 'Toggle between Dark and Light mode',
  class:
    className = 'text-muted hover:bg-surface-subtle focus:outline-none focus:ring-2 focus:ring-focus rounded-control text-sm min-h-11 min-w-11 inline-flex items-center justify-center',
  iconClass = 'w-6 h-6',
  iconName = 'tabler:moon',
  iconNameDark = 'tabler:sun',
} = Astro.props;
---

{!(UI.theme && UI.theme.endsWith(':only')) && (
  <aw-theme-toggle>
    <button type="button" class={className} aria-label={label} data-aw-toggle-color-scheme>
      <span class:list={['relative block', iconClass]}>
        <Icon
          name={iconName}
          class="absolute inset-0 h-full w-full transition-[opacity,transform] duration-200 motion-reduce:transition-none [html.dark_&]:-rotate-90 [html.dark_&]:scale-0 [html.dark_&]:opacity-0"
        />
        <Icon
          name={iconNameDark}
          class="absolute inset-0 h-full w-full rotate-90 scale-0 opacity-0 transition-[opacity,transform] duration-200 motion-reduce:transition-none [html.dark_&]:rotate-0 [html.dark_&]:scale-100 [html.dark_&]:opacity-100"
        />
      </span>
    </button>
  </aw-theme-toggle>
)}

<style>
  aw-theme-toggle {
    display: contents;
  }
</style>

<script>
  class AwThemeToggle extends HTMLElement {
    connectedCallback() {
      this.querySelector('[data-aw-toggle-color-scheme]')?.addEventListener('click', () => {
        const isDark = document.documentElement.classList.toggle('dark');
        try {
          localStorage.setItem('theme', isDark ? 'dark' : 'light');
        } catch {
          // Keep the current page theme usable when browser storage is blocked.
        }
        // Let the reveal-on-scroll controller drop its stagger delay so the
        // theme change doesn't flicker mid-animation (see REF #643).
        document.dispatchEvent(new CustomEvent('aw:theme-change'));
      });
    }
  }

  if (!customElements.get('aw-theme-toggle')) {
    customElements.define('aw-theme-toggle', AwThemeToggle);
  }
</script>
