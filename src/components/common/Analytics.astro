---
import { analyticsConfig } from '~/config/site';

const id = analyticsConfig.googleAnalyticsId;
const partytown = analyticsConfig.partytown;
const scriptType = partytown ? 'text/partytown' : undefined;
---

{id && (
  <>
    <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${id}`} type={scriptType} />
    <script is:inline id="ga-init" data-id={id} type={scriptType}>
      const analyticsId = document.currentScript?.dataset.id;
      window.dataLayer = window.dataLayer || [];
      window.gtag = function () {
        dataLayer.push(arguments);
      };
      window.gtag('js', new Date());
      window.gtag('config', analyticsId);
    </script>
  </>
)}
