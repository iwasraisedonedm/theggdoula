---
import { Icon } from 'astro-icon/components';

export interface Props {
  text: string;
  url: string | URL;
  class?: string;
}

const { text, url, class: className = 'inline-block' } = Astro.props;
---

<gg-social-share class={className}>
  <span class="align-super font-bold text-muted">Share:</span>
  <button
    type="button"
    class="inline-flex h-11 w-11 items-center justify-center rounded-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus"
    title="Twitter Share"
    aria-label="Twitter Share"
    data-gg-social-share="twitter"
    data-gg-url={url}
    data-gg-text={text}
  >
    <Icon name="tabler:brand-x" class="w-6 h-6 text-muted hover:text-heading" />
  </button>
  <button
    type="button"
    class="inline-flex h-11 w-11 items-center justify-center rounded-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus"
    title="Facebook Share"
    aria-label="Facebook Share"
    data-gg-social-share="facebook"
    data-gg-url={url}
  >
    <Icon name="tabler:brand-facebook" class="w-6 h-6 text-muted hover:text-heading" />
  </button>
  <button
    type="button"
    class="inline-flex h-11 w-11 items-center justify-center rounded-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus"
    title="Linkedin Share"
    aria-label="Linkedin Share"
    data-gg-social-share="linkedin"
    data-gg-url={url}
    data-gg-text={text}
  >
    <Icon name="tabler:brand-linkedin" class="w-6 h-6 text-muted hover:text-heading" />
  </button>
  <button
    type="button"
    class="inline-flex h-11 w-11 items-center justify-center rounded-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus"
    title="Whatsapp Share"
    aria-label="Whatsapp Share"
    data-gg-social-share="whatsapp"
    data-gg-url={url}
    data-gg-text={text}
  >
    <Icon name="tabler:brand-whatsapp" class="w-6 h-6 text-muted hover:text-heading" />
  </button>
  <button
    type="button"
    class="inline-flex h-11 w-11 items-center justify-center rounded-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus"
    title="Email Share"
    aria-label="Email Share"
    data-gg-social-share="mail"
    data-gg-url={url}
    data-gg-text={text}
  >
    <Icon name="tabler:mail" class="w-6 h-6 text-muted hover:text-heading" />
  </button>
</gg-social-share>

<script>
  const SHARE_URLS: Record<string, (url: string, text: string) => string> = {
    facebook: (url) => `https://www.facebook.com/sharer.php?u=${url}`,
    twitter: (url, text) => `https://twitter.com/intent/tweet?url=${url}&text=${text}`,
    linkedin: (url, text) => `https://www.linkedin.com/shareArticle?mini=true&url=${url}&title=${text}`,
    whatsapp: (_url, text) => `https://wa.me/?text=${text}%20${_url}`,
    mail: (url, text) => `mailto:?subject=%22${text}%22&body=${text}%20${url}`,
  };

  class GGSocialShare extends HTMLElement {
    connectedCallback() {
      this.querySelectorAll<HTMLElement>('[data-gg-social-share]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const network = btn.getAttribute('data-gg-social-share') ?? '';
          const url = encodeURIComponent(btn.getAttribute('data-gg-url') ?? '');
          const text = encodeURIComponent(btn.getAttribute('data-gg-text') ?? '');
          const build = SHARE_URLS[network];
          if (!build) return;

          const link = document.createElement('a');
          link.target = '_blank';
          link.rel = 'noopener noreferrer';
          link.href = build(url, text);
          link.click();
        });
      });
    }
  }

  if (!customElements.get('gg-social-share')) {
    customElements.define('gg-social-share', GGSocialShare);
  }
</script>

<style>
  gg-social-share {
    display: inline-block;
  }
</style>
