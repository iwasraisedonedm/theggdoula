---
import Item from '~/components/blog/ListItem.astro';
import type { Post } from '~/types';

export interface Props {
  posts: Array<Post>;
}

const { posts } = Astro.props;
---

<ul class="grid list-none gap-6 p-0 md:grid-cols-2 lg:grid-cols-3">
  {posts.map((post) => (
    <li>
      <Item post={post} />
    </li>
  ))}
</ul>
