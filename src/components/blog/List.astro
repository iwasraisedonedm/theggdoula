---
import Item from '~/components/blog/EditorialPostItem.astro';
import type { Post } from '~/types';

export interface Props {
  posts: Array<Post>;
}

const { posts } = Astro.props;
---

<section aria-labelledby="article-list-title">
  <h2 id="article-list-title" class="gg-type-section-title sr-only">
    Articles
  </h2>
  <ul class="journal-post-list">
    {posts.map((post) => (
      <li>
        <Item post={post} />
      </li>
    ))}
  </ul>
</section>
