---
import type { Post } from '~/types';
import { getPermalink } from '~/utils/permalinks';
import { getFormattedDate } from '~/utils/utils';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const postUrl = getPermalink(post.permalink, 'post');
const sourceImage = typeof post.image === 'string' ? post.image : post.image?.src;
const isGuideCover = sourceImage?.includes('/images/guides/') ?? false;
const imageSrc = sourceImage
  ?.replace('/teesee-family-support.avif', '/teesee-family-support-480.avif')
  .replace('/teesee-portrait.avif', '/teesee-portrait-640.avif');
const imageDimensions = imageSrc?.includes('portrait') ? { width: 640, height: 960 } : { width: 480, height: 616 };
---

<article class="gg-card group flex h-full flex-col overflow-hidden">
  {imageSrc && (
    <div class="block overflow-hidden">
      <img
        class:list={[
          'aspect-[4/3] w-full',
          isGuideCover
            ? 'bg-surface-subtle object-contain'
            : 'object-cover transition-transform duration-standard group-hover:scale-[1.02]',
        ]}
        src={imageSrc}
        alt={post.imageAlt ?? ''}
        width={imageDimensions.width}
        height={imageDimensions.height}
        loading="lazy"
        decoding="async"
      />
    </div>
  )}
  <div class="flex flex-1 flex-col p-6 sm:p-7">
    <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-muted">
      {post.category && (
        <a class="gg-link" href={getPermalink(post.category.slug, 'category')}>
          {post.category.title}
        </a>
      )}
      <time datetime={post.publishDate.toISOString()}>{getFormattedDate(post.publishDate)}</time>
    </div>
    <h3 class="gg-type-card-title mt-3 text-heading">
      <a
        class="focus-visible:rounded-none focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary"
        href={postUrl}
      >
        {post.title}
      </a>
    </h3>
    <p class="mt-3 flex-1 text-base leading-reading text-default">{post.excerpt}</p>
    <a class="gg-link mt-5 inline-flex w-fit items-center gap-2 text-base" href={postUrl}>
      Read article <span aria-hidden="true">→</span>
    </a>
  </div>
</article>
