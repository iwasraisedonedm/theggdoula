---
import PostTags from '~/components/blog/Tags.astro';
import SocialShare from '~/components/common/SocialShare.astro';
import { getPermalink } from '~/utils/permalinks';
import { getFormattedDate } from '~/utils/utils';
import type { Post } from '~/types';

interface Props {
  post: Post;
  url: string | URL;
}

const { post, url } = Astro.props;
const imageSrc = typeof post.image === 'string' ? post.image : post.image?.src;
const imageDimensions = imageSrc?.includes('portrait') ? { width: 960, height: 1440 } : { width: 960, height: 1231 };
---

<article class="gg-site-container py-8 sm:py-12 lg:py-16">
  <header class="mx-auto max-w-3xl">
    {post.category && (
      <a class="gg-section-label gg-link" href={getPermalink(post.category.slug, 'category')}>
        {post.category.title}
      </a>
    )}
    <h1 class="mt-4 font-heading text-4xl font-medium leading-tight tracking-heading text-heading sm:text-5xl lg:text-6xl">
      {post.title}
    </h1>
    <p class="mt-5 text-lg leading-reading text-default sm:text-xl">{post.excerpt}</p>
    <div class="mt-6 flex flex-wrap gap-x-4 gap-y-2 border-y border-border py-3 text-sm text-muted">
      {post.author && <span>By {post.author}</span>}
      <time datetime={post.publishDate.toISOString()}>{getFormattedDate(post.publishDate)}</time>
      {post.updateDate && post.updateDate.getTime() !== post.publishDate.getTime() && (
        <span>
          Updated <time datetime={post.updateDate.toISOString()}>{getFormattedDate(post.updateDate)}</time>
        </span>
      )}
      {post.readingTime && <span>{post.readingTime} min read</span>}
    </div>
  </header>

  {imageSrc && (
    <figure class="mx-auto mt-8 max-w-4xl sm:mt-10">
      <img
        class="max-h-[42rem] w-full rounded-control object-cover"
        src={imageSrc}
        alt={post.imageAlt ?? ''}
        width={imageDimensions.width}
        height={imageDimensions.height}
        fetchpriority="high"
        decoding="async"
      />
    </figure>
  )}

  <div class="prose prose-lg mx-auto mt-8 max-w-reading prose-headings:font-heading prose-headings:font-medium prose-headings:leading-heading prose-headings:tracking-heading prose-headings:text-heading prose-p:leading-reading prose-p:text-default prose-a:text-primary prose-a:underline prose-a:underline-offset-4 prose-strong:text-heading prose-li:text-default prose-img:rounded-control sm:mt-10">
    <slot />
  </div>

  <footer class="mx-auto mt-10 flex max-w-3xl flex-col gap-5 border-t border-border pt-6 sm:flex-row sm:items-start sm:justify-between">
    <div>
      <p class="gg-section-label">Topics</p>
      <PostTags tags={post.tags} class="mt-3 flex flex-wrap gap-2" />
    </div>
    <SocialShare url={url} text={post.title} class="flex flex-wrap gap-3 text-sm text-muted" />
  </footer>
</article>
