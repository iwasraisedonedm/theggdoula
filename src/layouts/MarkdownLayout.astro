---
import Layout from '~/layouts/PageLayout.astro';

import type { MetaData } from '~/types';

export interface Props {
  frontmatter: {
    title?: string;
    description?: string;
  };
}

const { frontmatter } = Astro.props;

const metadata: MetaData = {
  title: frontmatter?.title,
  description: frontmatter?.description,
};
---

<Layout metadata={metadata}>
  <section class="gg-site-container py-12 md:py-16 lg:py-24">
    <h1 class="gg-heading text-display">{frontmatter.title}</h1>
    <div class="prose prose-lg mt-8 max-w-reading dark:prose-invert prose-headings:font-heading prose-headings:leading-heading prose-headings:tracking-heading prose-headings:font-semibold prose-a:text-link prose-img:rounded-surface">
      <slot />
    </div>
  </section>
</Layout>
