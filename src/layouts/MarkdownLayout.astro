---
import Layout from '~/layouts/PageLayout.astro';

import type { MetaData } from '~/types';

export interface Props {
  frontmatter: {
    title?: string;
    description?: string;
  };
}

const { frontmatter } = Astro.props;

const metadata: MetaData = {
  title: frontmatter?.title,
  description: frontmatter?.description,
};
---

<Layout metadata={metadata}>
  <section class="gg-site-container py-12 md:py-16 lg:py-24">
    <h1 class="gg-type-page-title">{frontmatter.title}</h1>
    <div class="prose prose-lg mt-8 max-w-reading dark:prose-invert prose-headings:font-heading prose-headings:font-medium prose-headings:tracking-heading prose-headings:text-heading prose-h2:text-title prose-h2:leading-heading prose-h3:text-subsection prose-h3:leading-heading prose-p:text-lg prose-p:leading-reading prose-li:text-base prose-li:leading-reading prose-strong:text-heading prose-a:text-link prose-img:rounded-none">
      <slot />
    </div>
  </section>
</Layout>
