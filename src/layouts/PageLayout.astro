---
import Layout from '~/layouts/Layout.astro';
import Header from '~/components/widgets/Header.astro';
import Footer from '~/components/widgets/Footer.astro';

import { headerData, footerData } from '~/navigation';

import type { MetaData } from '~/types';

export interface Props {
  metadata?: MetaData;
}

const { metadata } = Astro.props;
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const isAstroWindDemoRoute = /^\/(?:homes|landing)(?:\/|$)/.test(Astro.url.pathname) || pathname === '/pricing';
const pageMetadata = isAstroWindDemoRoute
  ? { ...metadata, robots: { ...metadata?.robots, index: false, follow: true } }
  : metadata;
---

<Layout metadata={pageMetadata}>
  <slot name="head" slot="head" />
  <a class="gg-skip-link" href="#main-content">
    Skip to content
  </a>
  {/*
    Slot fallbacks are rendered explicitly. With `<slot name="x">fallback</slot>`
    Astro still evaluates the fallback when the page overrides the slot, and
    astro-icon then believes the icons inside it (the RSS icon of the default
    header, for instance) were already emitted, so their SVG sprite symbol
    goes missing on that page.
  */}
  {Astro.slots.has('announcement') && <slot name="announcement" />}
  {Astro.slots.has('header') ? <slot name="header" /> : <Header {...headerData} isSticky showToggleTheme />}
  <main id="main-content" class="flex-1">
    <slot />
  </main>
  {Astro.slots.has('footer') ? <slot name="footer" /> : <Footer {...footerData} />}
</Layout>
