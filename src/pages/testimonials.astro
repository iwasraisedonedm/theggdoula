---
import Breadcrumbs from '~/components/common/Breadcrumbs.astro';
import StructuredData from '~/components/common/StructuredData.astro';
import Button from '~/components/ui/Button.astro';
import PageLayout from '~/layouts/PageLayout.astro';
import { clientExperiences, featuredExperience } from '~/data/client-experiences';
import { buildBreadcrumbSchema } from '~/utils/structuredData';

const metadata = {
  title: 'Client Experiences',
  description:
    'Read permission-backed excerpts from families who have worked with Grit + Grace Doula for birth, postpartum, and newborn support.',
  openGraph: { type: 'website' },
};

const breadcrumbs = [{ text: 'Home', href: '/' }, { text: 'Client experiences' }];
---

<PageLayout metadata={metadata}>
  <StructuredData slot="head" schema={buildBreadcrumbSchema(breadcrumbs)} />
  <div class="bg-page text-default">
    <Breadcrumbs items={breadcrumbs} bar />

    <section class="border-b border-border bg-surface-subtle">
      <div class="gg-site-container py-16 sm:py-20 lg:py-24">
        <p class="gg-section-label">Client experiences · Shared with permission</p>
        <h1 class="mt-5 max-w-4xl font-heading text-4xl font-medium leading-tight tracking-heading text-heading sm:text-5xl lg:text-6xl">
          Care is personal. So are these experiences.
        </h1>
        <p class="mt-6 max-w-reading text-pretty text-lg leading-reading text-default sm:text-xl">
          These excerpts come from families Teesee has supported. The words and attributions are kept as provided. Every
          family’s needs and experience are different; these stories describe individual experiences, not promised
          outcomes.
        </p>
      </div>
    </section>

    <section class="gg-site-container py-16 sm:py-20" aria-labelledby="featured-experience-heading">
      <div class="mb-8 border-b border-border pb-6">
        <p class="gg-section-label">A family story</p>
        <h2 id="featured-experience-heading" class="gg-heading mt-3 text-3xl sm:text-4xl">
          Support through birth and postpartum.
        </h2>
      </div>
      <figure class="border border-border bg-surface p-7 sm:p-10 lg:p-14">
        <blockquote class="max-w-4xl font-heading text-2xl font-medium leading-relaxed tracking-heading text-heading sm:text-3xl lg:text-4xl">
          {featuredExperience.quote}
        </blockquote>
        <figcaption class="mt-8 flex flex-col gap-3 border-t border-border pt-5 sm:flex-row sm:items-center sm:justify-between">
          <div>
            <cite class="not-italic text-base font-medium text-heading">{featuredExperience.attribution}</cite>
            <p class="mt-1 text-sm text-muted">{featuredExperience.careType}</p>
          </div>
          <ul class="flex list-none flex-wrap gap-x-5 gap-y-2 p-0">
            {featuredExperience.services.map((service) => (
              <li>
                <a class="gg-link inline-flex min-h-11 items-center text-base" href={service.href}>
                  {service.label}
                </a>
              </li>
            ))}
          </ul>
        </figcaption>
      </figure>
    </section>

    <section class="border-y border-border bg-surface-subtle" aria-labelledby="more-experiences-heading">
      <div class="gg-site-container py-16 sm:py-20">
        <div class="mb-8 border-b border-border pb-6">
          <p class="gg-section-label">More from families</p>
          <h2 id="more-experiences-heading" class="gg-heading mt-3 text-3xl sm:text-4xl">
            Different families, different kinds of support.
          </h2>
        </div>
        <ul class="m-0 list-none divide-y divide-border border-y border-border p-0">
          {clientExperiences.map((experience) => (
            <li class="py-8 sm:py-10">
              <figure>
                <p class="gg-section-label">{experience.careType}</p>
                <blockquote class="mt-4 max-w-4xl font-heading text-xl font-medium leading-relaxed tracking-heading text-heading sm:text-2xl">
                  {experience.quote}
                </blockquote>
                <figcaption class="mt-5 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
                  <cite class="not-italic text-base font-medium text-heading">{experience.attribution}</cite>
                  <ul class="flex list-none flex-wrap gap-x-5 gap-y-2 p-0">
                    {experience.services.map((service) => (
                      <li>
                        <a class="gg-link inline-flex min-h-11 items-center text-base" href={service.href}>
                          {service.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                </figcaption>
              </figure>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="gg-site-container grid gap-10 py-16 sm:py-20 lg:grid-cols-[minmax(0,1fr)_20rem] lg:items-center lg:gap-16">
      <div>
        <p class="gg-section-label">When you’re ready</p>
        <h2 class="gg-heading mt-3 text-3xl sm:text-4xl">Talk about what support could look like for you.</h2>
        <p class="mt-5 max-w-reading text-base leading-reading text-default">
          A free 30-minute consultation is a chance to share what matters to your family, ask questions, and discuss
          next steps.
        </p>
      </div>
      <div class="lg:justify-self-end">
        <Button variant="primary" href="/book/">
          Book a free consultation
        </Button>
      </div>
    </section>
  </div>
</PageLayout>
