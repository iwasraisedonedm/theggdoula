---
import Button from '~/components/ui/Button.astro';
import PageLayout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Page Not Found',
  description:
    'This page could not be found. Browse doula services and resources or return to the Grit + Grace Doula homepage.',
  robots: { index: false, follow: true },
};
---

<PageLayout metadata={metadata}>
  <section class="flex flex-1 items-center border-b border-border bg-surface-subtle">
    <div class="gg-site-container w-full py-20 sm:py-28">
      <div class="max-w-2xl">
        <p class="gg-section-label">Page not found · 404</p>
        <h1 class="mt-5 font-heading text-4xl font-medium leading-tight tracking-heading text-heading sm:text-5xl">
          We couldn’t find that page.
        </h1>
        <p class="mt-5 max-w-reading text-lg leading-reading text-default">
          The address may have changed or the link may be out of date. Start again or browse a section of the site.
        </p>
        <div class="mt-8 flex flex-col gap-4 sm:flex-row sm:items-center">
          <Button variant="primary" href="/">
            Go to the homepage
          </Button>
          <a class="gg-link inline-flex min-h-11 items-center text-base" href="/services/">
            Explore services
          </a>
          <a class="gg-link inline-flex min-h-11 items-center text-base" href="/resources/">
            Browse resources
          </a>
        </div>
      </div>
    </div>
  </section>
</PageLayout>
