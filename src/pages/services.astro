---
import { getPermalink } from '~/utils/permalinks';
import Layout from '~/layouts/PageLayout.astro';
import Button from '~/components/ui/Button.astro';
import { services, serviceFaqs } from '~/data/services';
import ServiceCard from '~/components/services/ServiceCard.astro';

const metadata = {
  title: 'Doula Services',
  description:
    'Explore prenatal, birth, postpartum, breastfeeding, and newborn-care support from Grit + Grace Doula. Start with a free consultation.',
};

const journey = [
  {
    number: '01',
    title: 'Explore what matters to you',
    description: 'Review the support areas and notice which stage or questions feel most relevant to your family.',
  },
  {
    number: '02',
    title: 'Have a conversation',
    description:
      'Use a free 30-minute consultation to share what matters to you and talk through the available support.',
  },
  {
    number: '03',
    title: 'Choose a way forward',
    description: 'Identify the service or combination of support that fits your needs and preferences.',
  },
];

const stages = [
  {
    title: 'During pregnancy',
    description: 'One-on-one preparation, birth preferences, informed choices, and questions.',
    links: [services[0]],
  },
  {
    title: 'Labor and birth',
    description: 'Continuous emotional, physical, and informational support.',
    links: [services[1]],
  },
  {
    title: 'After birth',
    description: 'Practical postpartum care, feeding education, and newborn-care guidance.',
    links: services.slice(2),
  },
];
---

<Layout metadata={metadata}>
  <div class="service-overview bg-page text-default">
    <section class="relative isolate overflow-hidden border-b border-border bg-page">
      <div class="relative mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20 lg:px-8 lg:py-24">
        <div class="max-w-4xl border-l border-border pl-6 sm:pl-8 md:pl-12">
          <p class="gg-section-label">Care through pregnancy, birth, and early parenthood</p>
          <h1 class="mt-4 gg-type-page-title">Support for every stage.</h1>
          <p class="mt-6 max-w-2xl text-lg leading-reading text-default sm:text-xl">
            Explore prenatal, birth, postpartum, breastfeeding, and newborn-care support. Start with the stage or
            question that feels most important to you.
          </p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center">
            <Button variant="primary" href={getPermalink('/book')}>
              Ask about a free 30-minute consultation
            </Button>
            <a class="gg-link inline-flex min-h-11 items-center text-base" href="#service-list">
              Explore the services
            </a>
          </div>
        </div>
      </div>
    </section>

    <nav aria-label="Service areas" class="border-b border-border bg-surface">
      <div class="mx-auto max-w-6xl px-4 py-5 sm:px-6 lg:px-8">
        <ul class="flex flex-wrap gap-x-6 gap-y-3">
          {services.map((service) => (
            <li>
              <a class="gg-link inline-flex min-h-11 items-center text-base" href={`#${service.slug}`}>
                {service.name}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </nav>

    <section id="service-list" class="border-b border-border bg-surface-subtle">
      <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 sm:py-20 lg:px-8 lg:py-24">
        <div class="mb-10 max-w-3xl sm:mb-12">
          <p class="gg-section-label">Ways we can support you</p>
          <h2 class="gg-type-section-title mt-3 text-heading">Care for each part of the journey.</h2>
          <p class="mt-4 text-base leading-reading text-muted">
            Each service focuses on a different stage or kind of support. You can explore one area or talk through how
            they may fit together.
          </p>
        </div>

        <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {services.map((service) => (
            <li id={service.slug} class="h-full scroll-mt-24">
              <ServiceCard service={service} />
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="border-b border-border bg-page">
      <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 sm:py-20 lg:px-8 lg:py-24">
        <div class="mb-10 max-w-3xl sm:mb-12">
          <p class="gg-section-label">Support at a glance</p>
          <h2 class="gg-type-section-title mt-3 text-heading">Find your starting point.</h2>
        </div>
        <ol class="grid gap-4 md:grid-cols-3">
          {stages.map((stage, index) => (
            <li class="gg-card p-6 sm:p-7">
              <span class="font-mono text-xs tracking-widest text-brand">0{index + 1}</span>
              <h3 class="gg-type-card-title mt-4 text-heading">{stage.title}</h3>
              <p class="mt-3 text-base leading-reading text-muted">{stage.description}</p>
              <ul class="mt-5 flex flex-wrap gap-x-4 gap-y-2 border-t border-border pt-4">
                {stage.links.map((service) => (
                  <li>
                    <a
                      class="gg-link inline-flex min-h-11 items-center text-base"
                      href={getPermalink(`/services/${service.slug}`)}
                    >
                      {service.name}
                    </a>
                  </li>
                ))}
              </ul>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="border-b border-border bg-page">
      <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 sm:py-20 lg:px-8 lg:py-24">
        <div class="grid gap-8 md:grid-cols-[minmax(0,1fr)_minmax(18rem,0.8fr)] md:items-start lg:gap-16">
          <div>
            <p class="gg-section-label">How it can begin</p>
            <h2 class="gg-type-section-title mt-3 text-heading">A care journey shaped around your questions.</h2>
            <p class="mt-5 max-w-reading text-base leading-reading text-muted">
              There is no one right place to start. Explore the support areas, then use a conversation to talk about
              what matters to you and identify services that may fit.
            </p>
          </div>
          <ol class="divide-y divide-border border-y border-border">
            {journey.map((step) => (
              <li class="grid grid-cols-[2.5rem_1fr] gap-4 py-5">
                <span class="pt-1 font-mono text-xs tracking-widest text-brand">{step.number}</span>
                <div>
                  <h3 class="gg-type-card-title text-heading">{step.title}</h3>
                  <p class="mt-2 text-base leading-reading text-muted">{step.description}</p>
                </div>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>

    <section id="approach" class="border-b border-border bg-surface-subtle">
      <div class="mx-auto grid max-w-6xl gap-8 px-4 py-14 sm:px-6 sm:py-20 md:grid-cols-[minmax(0,1fr)_minmax(18rem,0.75fr)] lg:px-8 lg:py-24">
        <div>
          <p class="gg-section-label">Our approach</p>
          <h2 class="gg-type-section-title mt-3 max-w-2xl text-heading">
            Nonmedical support, alongside your care team.
          </h2>
          <p class="mt-5 max-w-reading text-base leading-reading text-default">
            Doula support offers emotional, physical, and informational care. It complements—not replaces—your medical
            care team. A consultation is a chance to discuss what matters to you and whether the support described here
            is a fit.
          </p>
          <a class="gg-link mt-5 inline-flex min-h-11 items-center text-base" href={getPermalink('/book')}>
            Ask a question about support
          </a>
        </div>
        <aside class="gg-card p-6 sm:p-8" aria-labelledby="consultation-heading">
          <p class="gg-section-label">Begin with a conversation</p>
          <h3 id="consultation-heading" class="gg-type-card-title mt-3 text-heading">
            Bring your questions.
          </h3>
          <p class="mt-4 text-base leading-reading text-muted">
            Ask about a free 30-minute consultation and share the kind of support you are looking for.
          </p>
          <a class="gg-link mt-5 inline-flex min-h-11 items-center text-base font-medium" href={getPermalink('/book')}>
            Ask about a consultation <span aria-hidden="true">→</span>
          </a>
        </aside>
      </div>
    </section>

    <section id="faqs" class="border-b border-border bg-surface-subtle">
      <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 sm:py-20 lg:px-8 lg:py-24">
        <div class="mb-8">
          <p class="gg-section-label">Common questions</p>
          <h2 class="gg-type-section-title mt-3 text-heading">Before you choose a service.</h2>
        </div>
        <div class="divide-y divide-border border-y border-border">
          {serviceFaqs.map((faq) => (
            <details class="group py-5">
              <summary class="flex min-h-11 cursor-pointer list-none items-center justify-between gap-5 py-1 font-heading text-lg font-medium text-heading focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-focus [&::-webkit-details-marker]:hidden">
                {faq.question}
                <span class="text-brand transition-transform duration-standard group-open:rotate-45" aria-hidden="true">
                  +
                </span>
              </summary>
              <p class="max-w-reading pt-4 text-base leading-reading text-muted">{faq.answer}</p>
            </details>
          ))}
        </div>
        <p class="mt-6 text-base text-muted">
          Have another question?{' '}
          <a class="gg-link" href={getPermalink('/book')}>
            Get in touch
          </a>
          .
        </p>
      </div>
    </section>

    <section class="bg-brand text-on-brand">
      <div class="mx-auto grid max-w-6xl gap-8 px-4 py-14 sm:px-6 sm:py-20 md:grid-cols-12 md:items-center lg:gap-16 lg:px-8 lg:py-24">
        <div class="md:col-span-8">
          <p class="font-mono text-xs uppercase tracking-widest opacity-85">Your next step</p>
          <h2 class="gg-type-section-title mt-3 max-w-3xl text-on-brand">Let’s talk about the support you need.</h2>
          <p class="mt-5 max-w-reading text-base leading-reading opacity-90">
            Ask about a free 30-minute consultation and bring the questions on your mind.
          </p>
        </div>
        <div class="md:col-span-4 md:justify-self-start">
          <Button
            variant="secondary"
            href={getPermalink('/book')}
            class="border-on-brand text-on-brand hover:bg-on-brand/10"
          >
            Ask about a free consultation
          </Button>
        </div>
      </div>
    </section>
  </div>

  <style>
    @media (min-width: 640px) and (max-width: 1023px) {
      .service-overview #service-list li:last-child:nth-child(odd) {
        grid-column: 1 / -1;
        justify-self: center;
        width: calc((100% - 1rem) / 2);
      }
    }
  </style>
</Layout>
