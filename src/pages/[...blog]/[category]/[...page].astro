---
import type { InferGetStaticPropsType, GetStaticPaths } from 'astro';
import { blogCategoryRobots, getStaticPathsBlogCategory } from '~/utils/blog';

import Layout from '~/layouts/PageLayout.astro';
import BlogList from '~/components/blog/List.astro';
import Pagination from '~/components/blog/Pagination.astro';
import Breadcrumbs from '~/components/common/Breadcrumbs.astro';
import StructuredData from '~/components/common/StructuredData.astro';
import { getPermalink, getBlogPermalink } from '~/utils/permalinks';
import { buildBreadcrumbSchema } from '~/utils/structuredData';

export const prerender = true;

export const getStaticPaths = (async ({ paginate }) => {
  return await getStaticPathsBlogCategory({ paginate });
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths> & { category: Record<string, string> };

const { page, category } = Astro.props as Props;

const currentPage = page.currentPage ?? 1;

const breadcrumbs = [
  { text: 'Home', href: getPermalink('/') },
  { text: 'Resources', href: getPermalink('/resources') },
  { text: 'Blog', href: getBlogPermalink() },
  ...(currentPage > 1
    ? [{ text: category.title, href: getPermalink(category.slug, 'category') }, { text: `Page ${currentPage}` }]
    : [{ text: category.title }]),
];

const metadata = {
  title: `${category.title} Articles${currentPage > 1 ? ` — Page ${currentPage}` : ''}`,
  description: `Read Grit + Grace Doula articles about ${category.title.toLowerCase()}, family support, and the early weeks around birth.`,
  robots: {
    index: blogCategoryRobots?.index,
    follow: blogCategoryRobots?.follow,
  },
};
---

<Layout metadata={metadata}>
  <StructuredData slot="head" schema={buildBreadcrumbSchema(breadcrumbs)} />
  <Breadcrumbs bar items={breadcrumbs} />
  <section class="gg-site-container py-12 sm:py-16">
    <p class="gg-section-label">Browse by topic</p>
    <h1 class="gg-heading mt-3 text-3xl sm:text-4xl">{category.title}</h1>
    <p class="mt-4 max-w-reading text-base leading-reading text-default">
      Articles and practical perspectives related to {category.title.toLowerCase()}.
    </p>
    <div class="mt-8">
      <BlogList posts={page.data} />
    </div>
    <Pagination prevUrl={page.url.prev} nextUrl={page.url.next} />
  </section>
</Layout>
