---
import type { InferGetStaticPropsType, GetStaticPaths } from 'astro';
import Layout from '~/layouts/PageLayout.astro';
import Breadcrumbs from '~/components/common/Breadcrumbs.astro';
import StructuredData from '~/components/common/StructuredData.astro';
import ResourceArticleCard from '~/components/blog/ResourceArticleCard.astro';
import Pagination from '~/components/blog/Pagination.astro';
import { blogListRobots, FEATURED_POST_SLUG, fetchPosts, getStaticPathsBlogList } from '~/utils/blog';
import { getBlogPermalink, getPermalink } from '~/utils/permalinks';
import { buildBreadcrumbSchema } from '~/utils/structuredData';

export const prerender = true;

export const getStaticPaths = (async ({ paginate }) => {
  return await getStaticPathsBlogList({ paginate });
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { page } = Astro.props as Props;
const currentPage = page.currentPage ?? 1;
const allPosts = await fetchPosts();
const featuredPost = currentPage === 1 ? page.data.find((post) => post.slug === FEATURED_POST_SLUG) : undefined;
const visiblePosts = featuredPost ? page.data.filter((post) => post.slug !== FEATURED_POST_SLUG) : page.data;
const featuredImage = typeof featuredPost?.image === 'string' ? featuredPost.image : featuredPost?.image?.src;
const featuredImageDimensions = featuredImage?.includes('portrait')
  ? { width: 960, height: 1440 }
  : { width: 960, height: 1231 };
const categories = [
  ...new Map(
    allPosts.flatMap((post) => (post.category ? [[post.category.slug, post.category] as const] : []))
  ).values(),
].sort((a, b) => a.title.localeCompare(b.title));

const pageLabel = currentPage > 1 ? ` — Page ${currentPage}` : '';
const metadata = {
  title: `Birth, Postpartum & Family Articles${pageLabel}`,
  description:
    'Thoughtful, practical reading about doula care, labor support, partners, postpartum care, and newborn support from Grit + Grace Doula.',
  robots: {
    index: blogListRobots?.index && currentPage === 1,
    follow: blogListRobots?.follow,
  },
  openGraph: { type: 'blog' },
};
const breadcrumbs = [
  { text: 'Home', href: getPermalink('/') },
  { text: 'Resources', href: getPermalink('/resources') },
  ...(currentPage > 1
    ? [{ text: 'Blog', href: getBlogPermalink() }, { text: `Page ${currentPage}` }]
    : [{ text: 'Blog' }]),
];
---

<Layout metadata={metadata}>
  <Fragment slot="head">
    {page.url.prev && <link rel="prev" href={page.url.prev} />}
    {page.url.next && <link rel="next" href={page.url.next} />}
    <StructuredData schema={buildBreadcrumbSchema(breadcrumbs)} />
  </Fragment>
  <Breadcrumbs bar items={breadcrumbs} />

  <section class="border-b border-border bg-surface-subtle">
    <div class="gg-site-container py-14 sm:py-18 lg:py-24">
      <p class="gg-section-label">Grit + Grace journal</p>
      <h1 class="mt-4 max-w-4xl font-heading text-4xl font-medium leading-tight tracking-heading text-heading sm:text-5xl lg:text-6xl">
        Clear, caring guidance for the journey around birth.
      </h1>
      <p class="mt-5 max-w-reading text-lg leading-reading text-default sm:text-xl">
        Read about doula care, birth preparation, partner support, and the early weeks with a newborn. These articles
        share general information and practical perspectives; your licensed healthcare team is the source for clinical
        advice.
      </p>
    </div>
  </section>

  <nav class="gg-site-container py-6" aria-label="Browse articles by topic">
    <ul class="flex list-none flex-wrap gap-2 p-0">
      <li>
        <a
          class="btn btn-secondary px-4 py-2 text-sm"
          href={getBlogPermalink()}
          aria-current={currentPage === 1 ? 'page' : undefined}
        >
          All articles
        </a>
      </li>
      {categories.map((category) => (
        <li>
          <a class="btn btn-secondary px-4 py-2 text-sm" href={getPermalink(category.slug, 'category')}>
            {category.title}
          </a>
        </li>
      ))}
    </ul>
  </nav>

  {featuredPost && (
    <section class="gg-site-container pb-12 sm:pb-16" aria-labelledby="featured-article-title">
      <article class="grid overflow-hidden border-y border-border md:grid-cols-[1fr_0.9fr]">
        {featuredImage && (
          <img
            class="aspect-[4/3] h-full w-full object-cover md:aspect-auto"
            src={featuredImage}
            alt={featuredPost.imageAlt ?? ''}
            width={featuredImageDimensions.width}
            height={featuredImageDimensions.height}
            fetchpriority="high"
            decoding="async"
          />
        )}
        <div class="flex flex-col justify-center px-6 py-8 sm:px-10 sm:py-12 lg:px-14">
          <p class="gg-section-label">
            Featured article{featuredPost.category ? ` · ${featuredPost.category.title}` : ''}
          </p>
          <h2
            id="featured-article-title"
            class="mt-4 font-heading text-3xl font-medium leading-tight tracking-heading text-heading sm:text-4xl"
          >
            <a
              class="focus-visible:rounded-sm focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary"
              href={getPermalink(featuredPost.permalink, 'post')}
            >
              {featuredPost.title}
            </a>
          </h2>
          <p class="mt-4 text-base leading-reading text-default sm:text-lg">{featuredPost.excerpt}</p>
          <a
            class="gg-link mt-6 inline-flex w-fit items-center gap-2 text-base"
            href={getPermalink(featuredPost.permalink, 'post')}
          >
            Read the featured article <span aria-hidden="true">→</span>
          </a>
        </div>
      </article>
    </section>
  )}

  <section class="gg-site-container pb-16 sm:pb-20" aria-labelledby="article-list-heading">
    <div class="mb-8 flex flex-col gap-2 border-b border-border pb-5 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="gg-section-label">Browse the journal</p>
        <h2 id="article-list-heading" class="gg-heading mt-3 text-3xl sm:text-4xl">
          {featuredPost
            ? 'More from the journal'
            : currentPage > 1
              ? `More articles · Page ${currentPage}`
              : 'Articles'}
        </h2>
      </div>
      <p class="text-base text-muted">{allPosts.length} articles</p>
    </div>

    {visiblePosts.length > 0 ? (
      <ul class="grid list-none gap-6 p-0 md:grid-cols-2 lg:grid-cols-3">
        {visiblePosts.map((post) => (
          <li>
            <ResourceArticleCard post={post} />
          </li>
        ))}
      </ul>
    ) : (
      <div class="gg-card p-6 sm:p-8">
        <h3 class="font-heading text-xl font-medium text-heading">No articles here yet.</h3>
        <p class="mt-3 max-w-reading text-base leading-reading text-default">
          Browse the topics above or explore the service pages for information about current support.
        </p>
        <a class="gg-link mt-5 inline-flex text-base" href="/services/">
          Explore doula services{' '}
          <span class="ml-1" aria-hidden="true">
            →
          </span>
        </a>
      </div>
    )}

    <div class="mt-10">
      <Pagination prevUrl={page.url.prev} nextUrl={page.url.next} prevText="Newer articles" nextText="Older articles" />
    </div>
  </section>

  <section class="border-t border-border bg-surface-subtle">
    <div class="gg-site-container grid gap-8 py-12 sm:grid-cols-2 sm:items-center sm:py-16">
      <div>
        <p class="gg-section-label">Keep exploring</p>
        <h2 class="gg-heading mt-3 text-2xl sm:text-3xl">Find support for your next question.</h2>
        <p class="mt-3 max-w-reading text-base leading-reading text-default">
          Browse the resource hub for topic-based starting points and the Birth Better Guide.
        </p>
        <a class="gg-link mt-4 inline-flex text-base" href="/resources/">
          Explore all resources{' '}
          <span class="ml-1" aria-hidden="true">
            →
          </span>
        </a>
      </div>
      <div class="sm:justify-self-end">
        <p class="gg-section-label">When you’re ready</p>
        <p class="mt-3 max-w-sm text-base leading-reading text-default">
          Talk with Teesee about the support you are considering during a free 30-minute consultation.
        </p>
        <a class="btn btn-primary mt-5" href="/book/">
          Book a free consultation
        </a>
      </div>
    </div>
  </section>
</Layout>
