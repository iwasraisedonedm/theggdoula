---
import type { InferGetStaticPropsType, GetStaticPaths } from 'astro';
import { blogTagRobots, fetchPosts, getStaticPathsBlogTag } from '~/utils/blog';
import Layout from '~/layouts/PageLayout.astro';
import BlogList from '~/components/blog/List.astro';
import EditorialSidebar from '~/components/blog/EditorialSidebar.astro';
import EditorialStyles from '~/components/blog/EditorialStyles.astro';
import Pagination from '~/components/blog/Pagination.astro';
import Breadcrumbs from '~/components/common/Breadcrumbs.astro';
import StructuredData from '~/components/common/StructuredData.astro';
import { getPermalink, getBlogPermalink } from '~/utils/permalinks';
import { buildBreadcrumbSchema } from '~/utils/structuredData';

export const prerender = true;

export const getStaticPaths = (async ({ paginate }) => {
  return await getStaticPathsBlogTag({ paginate });
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { page, tag } = Astro.props as Props;
const currentPage = page.currentPage ?? 1;
const allPosts = await fetchPosts();
const breadcrumbs = [
  { text: 'Home', href: getPermalink('/') },
  { text: 'Resources', href: getPermalink('/resources') },
  { text: 'Blog', href: getBlogPermalink() },
  ...(currentPage > 1
    ? [{ text: `Tag: ${tag.title}`, href: getPermalink(tag.slug, 'tag') }, { text: `Page ${currentPage}` }]
    : [{ text: `Tag: ${tag.title}` }]),
];

const metadata = {
  title: `${tag.title} Articles${currentPage > 1 ? ` — Page ${currentPage}` : ''}`,
  description: `Grit + Grace Doula articles tagged ${tag.title}, with practical information about birth, postpartum, and family support.`,
  robots: {
    index: blogTagRobots?.index,
    follow: blogTagRobots?.follow,
  },
};
---

<Layout metadata={metadata}>
  <Fragment slot="head">
    {page.url.prev && <link rel="prev" href={page.url.prev} />}
    {page.url.next && <link rel="next" href={page.url.next} />}
    <StructuredData schema={buildBreadcrumbSchema(breadcrumbs)} />
  </Fragment>
  <Breadcrumbs class="sr-only" items={breadcrumbs} />

  <div class="journal-page">
    <EditorialStyles />
    <div class="journal-shell">
      <header class="journal-masthead">
        <p class="journal-eyebrow">Browse by tag</p>
        <h1 class="journal-masthead__title">{tag.title}</h1>
        <p class="journal-masthead__description">Articles that touch on {tag.title.toLowerCase()}.</p>
      </header>

      <div class="journal-content-grid">
        <section class="journal-feed" aria-labelledby="latest-articles-heading">
          <div class="journal-feed__heading">
            <h2 id="latest-articles-heading">Latest Articles</h2>
            <span class="journal-feed__count">{page.total} articles</span>
          </div>
          <BlogList posts={page.data} />
          <Pagination
            currentPage={currentPage}
            lastPage={page.lastPage}
            currentUrl={page.url.current}
            prevUrl={page.url.prev}
            nextUrl={page.url.next}
          />
        </section>

        <EditorialSidebar posts={allPosts} />
      </div>
    </div>
  </div>
</Layout>
