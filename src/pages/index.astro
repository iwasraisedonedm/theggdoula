---
import Layout from '~/layouts/Layout.astro';

const metadata = {
  title: 'Teesee | The GG Doula',
  description:
    'Personalized prenatal, birth, postpartum, virtual doula, feeding education, and newborn-care support from Grit + Grace Doula in Orange County, California.',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <main id="main-content" class="brand-hero" aria-labelledby="home-title">
    <canvas class="brand-threads" data-brand-threads aria-hidden="true"></canvas>
    <h1 id="home-title" class="sr-only">
      teesee | the gg doula
    </h1>
  </main>
</Layout>

<script>
  let stopBrandThreads: (() => void) | undefined;

  function startBrandThreads() {
    stopBrandThreads?.();
    stopBrandThreads = undefined;

    const canvas = document.querySelector<HTMLCanvasElement>('[data-brand-threads]');
    const context = canvas?.getContext('2d');
    if (!canvas || !context) return;
    const brandCanvas = canvas;
    const brandContext = context;

    const motionPreference = window.matchMedia('(prefers-reduced-motion: reduce)');
    let width = 0;
    let height = 0;
    let pixelRatio = 1;
    let frame = 0;
    let active = true;
    const themeObserver = new MutationObserver(() => draw(0));
    const firstSequence = 'teesee | the gg doula';
    const secondSequence = 'the gg doula | teesee';

    function resize() {
      const bounds = brandCanvas.getBoundingClientRect();
      pixelRatio = Math.min(window.devicePixelRatio || 1, 2);
      width = bounds.width;
      height = bounds.height;
      brandCanvas.width = Math.round(width * pixelRatio);
      brandCanvas.height = Math.round(height * pixelRatio);
      brandContext.setTransform(pixelRatio, 0, 0, pixelRatio, 0, 0);
      draw(0);
    }

    function draw(time: number) {
      brandContext.clearRect(0, 0, width, height);
      if (!width || !height) return;

      const ink = getComputedStyle(brandCanvas).getPropertyValue('--gg-color-on-brand').trim();
      const centerY = height / 2;
      const amplitude = height * 0.25;
      const preferredSpacing = Math.min(30, width / firstSequence.length);
      const repetitions = Math.ceil(width / (preferredSpacing * firstSequence.length));
      const segments = repetitions * firstSequence.length;
      const spacing = width / segments;
      const phase = motionPreference.matches ? 0 : time * 0.00024;
      const points: Array<{ x: number; first: number; second: number; depth: number }> = [];

      for (let index = 0; index < segments; index += 1) {
        const x = (index + 0.5) * spacing;
        const angle = index * 0.2 - phase;
        points.push({
          x,
          first: centerY + Math.sin(angle) * amplitude,
          second: centerY + Math.sin(angle + Math.PI) * amplitude,
          depth: (Math.cos(angle) + 1) / 2,
        });
      }

      brandContext.lineWidth = 1;
      brandContext.strokeStyle = ink;
      for (const point of points) {
        const firstOpacity = 0.2 + point.depth * 0.8;
        const secondOpacity = 0.2 + (1 - point.depth) * 0.8;
        brandContext.globalAlpha = Math.min(firstOpacity, secondOpacity) * 0.2;
        brandContext.beginPath();
        brandContext.moveTo(point.x, point.first);
        brandContext.lineTo(point.x, point.second);
        brandContext.stroke();
      }

      const labelFont =
        getComputedStyle(document.documentElement).getPropertyValue('--gg-type-font-label').trim() || 'monospace';
      const fontSize = Math.max(9, Math.min(14, width / 100));
      brandContext.font = `500 ${fontSize}px ${labelFont}`;
      brandContext.fillStyle = ink;
      brandContext.textAlign = 'center';
      brandContext.textBaseline = 'middle';
      points.forEach((point, index) => {
        brandContext.globalAlpha = 0.2 + point.depth * 0.8;
        brandContext.fillText(firstSequence[index % firstSequence.length], point.x, point.first);
        brandContext.globalAlpha = 0.2 + (1 - point.depth) * 0.8;
        brandContext.fillText(secondSequence[index % secondSequence.length], point.x, point.second);
      });
      brandContext.globalAlpha = 1;
    }

    function animate(time: number) {
      if (!active) return;
      draw(time);
      if (!motionPreference.matches) frame = window.requestAnimationFrame(animate);
    }

    function updateMotion() {
      window.cancelAnimationFrame(frame);
      draw(0);
      if (!motionPreference.matches) frame = window.requestAnimationFrame(animate);
    }

    function stop() {
      active = false;
      window.cancelAnimationFrame(frame);
      window.removeEventListener('resize', resize);
      motionPreference.removeEventListener('change', updateMotion);
      document.removeEventListener('astro:before-swap', stop);
      themeObserver.disconnect();
    }

    resize();
    window.addEventListener('resize', resize, { passive: true });
    motionPreference.addEventListener('change', updateMotion);
    themeObserver.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
    document.addEventListener('astro:before-swap', stop, { once: true });
    if (!motionPreference.matches) frame = window.requestAnimationFrame(animate);
    stopBrandThreads = stop;
  }

  document.addEventListener('astro:page-load', startBrandThreads);
  startBrandThreads();
</script>

<style>
  :global(body:has(.brand-hero)) {
    min-height: 100svh;
    background: var(--gg-color-brand);
    color: var(--gg-color-on-brand);
  }

  .brand-hero {
    position: relative;
    display: grid;
    min-height: 100vh;
    min-height: 100svh;
    width: 100%;
    overflow: hidden;
    place-items: center;
    isolation: isolate;
    background: var(--gg-color-brand);
    color: var(--gg-color-on-brand);
  }

  .brand-threads {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: block;
    width: 100%;
    height: 100%;
    opacity: 0.6;
    pointer-events: none;
  }

  .brand-hero::before {
    position: absolute;
    inset: 0;
    z-index: 0;
    background-image:
      linear-gradient(to right, color-mix(in srgb, var(--gg-color-on-brand) 8%, transparent) 1px, transparent 1px),
      linear-gradient(to bottom, color-mix(in srgb, var(--gg-color-on-brand) 8%, transparent) 1px, transparent 1px);
    background-size: 40px 40px;
    content: '';
    pointer-events: none;
  }
</style>
