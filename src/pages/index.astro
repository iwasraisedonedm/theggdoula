---
import Layout from '~/layouts/PageLayout.astro';
import ClientJourney from '~/components/widgets/ClientJourney.astro';

/**
 * Grit + Grace Doula — full-bleed, framed-grid homepage.
 * Astro 7 + Tailwind CSS v4, with minimal vanilla JS and no React dependency.
 * The internal links assume the routes in the doula project exist.
 */
const services = [
  {
    number: '01',
    name: 'Prenatal Support',
    description:
      'One-on-one preparation for pregnancy, birth preferences, informed choices, and the questions that come up along the way.',
    href: '/services/prenatal/',
    label: 'BEFORE BIRTH',
    icon: 'sun',
  },
  {
    number: '02',
    name: 'Birth Doula Support',
    description:
      'Continuous emotional, physical, and informational support during labor and birth—for you and the people by your side.',
    href: '/services/birth/',
    label: 'LABOR & BIRTH',
    icon: 'heart',
  },
  {
    number: '03',
    name: 'Postpartum Care',
    description:
      'Gentle, practical care as you recover, bond with your baby, adjust to new routines, and find your footing at home.',
    href: '/services/postpartum/',
    label: 'AFTER BIRTH',
    icon: 'home',
  },
  {
    number: '04',
    name: 'Breastfeeding & Newborn Care',
    description:
      'Personalized feeding education and newborn-care guidance that helps you make confident, informed decisions.',
    href: '/services/breastfeeding/',
    label: 'FEEDING & BABY',
    icon: 'sparkles',
  },
];
const faqs = [
  {
    question: 'What does a doula do?',
    answer:
      'A doula provides nonmedical emotional, physical, and informational support. Your doula complements—not replaces—your medical care team.',
  },
  {
    question: 'When should I book a doula?',
    answer:
      'You can reach out at any point in pregnancy or postpartum. Earlier contact allows more time to discuss preferences and availability.',
  },
  {
    question: 'Can my partner be involved?',
    answer:
      'Yes. Doula support can include your partner or chosen support people so everyone feels informed, included, and supported.',
  },
];
const metadata = {
  title: 'Grit + Grace Doula | Birth & Postpartum Support',
  description:
    'Compassionate prenatal, birth, postpartum, breastfeeding, and newborn-care support from Grit + Grace Doula. Ask about a free 30-minute consultation.',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <div class="gg-home relative isolate overflow-hidden bg-page text-neutral-600">
    <section class="home-hero" aria-labelledby="home-title">
      <div class="home-hero-content">
        <div class="home-hero-grid">
          <div class="home-hero-heading">
            <div class="home-hero-meta">
              <p class="home-hero-eyebrow">
                <span aria-hidden="true"></span>GRIT + GRACE DOULA
              </p>
              <p class="home-hero-location">ORANGE COUNTY · CALIFORNIA</p>
            </div>
            <h1 id="home-title">Thoughtful support for birth and beyond.</h1>
            <div class="home-hero-copy">
              <p class="home-hero-subtitle">Care that meets you where you are.</p>
              <p class="home-hero-description">
                Pregnancy, birth, and life with a new baby are deeply personal. Find thoughtful education, steady
                encouragement, and hands-on support—so you can feel heard, informed, and cared for.
              </p>
              <div class="home-hero-actions">
                <a class="home-hero-primary" href="/book/">
                  Ask about a free consultation
                </a>
                <a class="home-hero-secondary" href="/services/">
                  Explore services <span aria-hidden="true">→</span>
                </a>
              </div>
            </div>
          </div>
          <figure class="home-hero-portrait">
            <div class="home-portrait-frame">
              <img
                src="/images/teesee-portrait.avif"
                srcset="/images/teesee-portrait-640.avif 640w, /images/teesee-portrait.avif 960w"
                sizes="(min-width: 1024px) 38vw, (min-width: 640px) 55vw, calc(100vw - 3rem)"
                alt="Teesee Logan, Grit + Grace Doula"
                width="960"
                height="1440"
                fetchpriority="high"
                decoding="async"
              />
              <span class="home-portrait-shade" aria-hidden="true"></span>
              <figcaption>
                <span>GRIT + GRACE DOULA</span>
                <strong>Meet Teesee Logan</strong>
              </figcaption>
              <a class="home-portrait-link" href="/about/" aria-label="Meet Teesee Logan">
                <span aria-hidden="true">↗</span>
              </a>
            </div>
          </figure>
        </div>
        <div class="home-hero-trust" aria-label="Grit + Grace Doula at a glance">
          <div>
            <span>01 / AREA</span>
            <strong>Orange County + nearby communities</strong>
          </div>
          <div>
            <span>02 / CARE</span>
            <strong>Pregnancy, birth + postpartum</strong>
          </div>
          <div>
            <span>03 / APPROACH</span>
            <strong>Non-medical, family-led support</strong>
          </div>
        </div>
      </div>
    </section>

    <section class="relative z-10 border-b border-neutral-200 bg-white">
      <div class="home-container grid gap-8 lg:grid-cols-12 lg:gap-10">
        <header class="lg:col-span-4">
          <p class="home-label">WHY THIS SUPPORT MATTERS</p>
          <h2 class="home-section-title">You don't have to figure everything out alone.</h2>
        </header>
        <div class="home-empathy-grid lg:col-span-8">
          <article>
            <span class="home-index">01</span>
            <h3>So many decisions. So little clarity.</h3>
            <p>
              From birth preferences to feeding choices, conflicting advice can make even simple decisions feel
              overwhelming. You deserve time, information, and space to ask questions.
            </p>
          </article>
          <article>
            <span class="home-index">02</span>
            <h3>Your care should feel personal.</h3>
            <p>
              Every family, birth, and recovery looks different. Support should adapt to your values, circumstances, and
              the way you want to welcome your baby.
            </p>
          </article>
        </div>
      </div>
    </section>

    <section id="services" class="relative z-10 bg-white">
      <div class="home-container">
        <div class="mb-8 max-w-3xl sm:mb-10">
          <p class="mb-4 font-mono text-[10px] uppercase tracking-widest text-emerald-600">WAYS WE CAN SUPPORT YOU</p>
          <h3 class="text-2xl font-medium tracking-tighter text-neutral-900 sm:text-3xl">
            Care for every stage of your journey.
          </h3>
        </div>
        <div class="grid grid-cols-1 gap-4 sm:gap-6 md:grid-cols-2">
          {services.map((service) => (
            <article class="group h-full rounded-sm border border-neutral-200">
              <div class="relative z-10 flex h-full flex-col rounded-sm bg-neutral-50 p-6 sm:p-8">
                <div class="mb-6 flex items-start justify-between">
                  <div class="flex h-10 w-10 items-center justify-center rounded-sm border border-neutral-200 bg-white font-mono text-xs text-emerald-600">
                    {service.number}
                  </div>
                  <span class="rounded-sm border border-neutral-200 bg-white px-2 py-1 font-mono text-[10px] text-neutral-500">
                    {service.label}
                  </span>
                </div>
                <h4 class="mb-2 text-base font-medium tracking-tight text-neutral-900 sm:text-lg">{service.name}</h4>
                <p class="mb-6 text-base font-light leading-relaxed text-neutral-500">{service.description}</p>
                <a
                  class="mt-auto border-t border-neutral-200 pt-5 text-xs font-medium text-neutral-700 transition-colors hover:text-emerald-600"
                  href={service.href}
                >
                  LEARN MORE <span aria-hidden="true">↗</span>
                </a>
              </div>
            </article>
          ))}
        </div>
        <div class="mt-8">
          <a href="/services/" class="text-xs font-medium text-neutral-700 underline-offset-4 hover:underline">
            Explore all services
          </a>
        </div>
      </div>
    </section>

    <ClientJourney />

    <!-- The original calculator's two-column card becomes a practical planning tool -->
    <section id="planner" class="relative z-10 border-b border-neutral-200 bg-neutral-50">
      <div class="home-container">
        <div class="mb-8 max-w-3xl">
          <p class="mb-4 flex items-center gap-2 font-mono text-[10px] uppercase tracking-widest text-emerald-600">
            <span class="h-1 w-1 rounded-full bg-emerald-500"></span>POSTPARTUM PLANNING TOOL
          </p>
          <h3 class="text-2xl font-medium tracking-tighter text-neutral-900 sm:text-3xl">
            Make room for the support you need.
          </h3>
        </div>
        <div class="rounded-sm border border-neutral-200">
          <div class="flex flex-col rounded-sm bg-white md:flex-row">
            <div class="w-full border-b border-neutral-100 p-6 sm:p-8 md:w-1/2 md:border-b-0 md:border-r">
              <div class="space-y-8">
                <div>
                  <div class="mb-3 flex items-baseline justify-between">
                    <label for="weeks-range" class="font-mono text-[10px] uppercase tracking-wider text-neutral-500">
                      Weeks of support
                    </label>
                    <span class="text-sm font-medium text-neutral-900">
                      <span id="weeks-val">4</span> weeks
                    </span>
                  </div>
                  <input type="range" id="weeks-range" min="1" max="12" step="1" value="4" class="w-full" />
                  <div class="mt-2 flex justify-between font-mono text-[10px] text-neutral-400">
                    <span>1 week</span>
                    <span>12 weeks</span>
                  </div>
                </div>
                <div>
                  <div class="mb-3 flex items-baseline justify-between">
                    <label for="hours-range" class="font-mono text-[10px] uppercase tracking-wider text-neutral-500">
                      Hours per week
                    </label>
                    <span class="text-sm font-medium text-neutral-900">
                      <span id="hours-val">6</span> hours
                    </span>
                  </div>
                  <input type="range" id="hours-range" min="2" max="30" step="2" value="6" class="w-full" />
                  <div class="mt-2 flex justify-between font-mono text-[10px] text-neutral-400">
                    <span>2 hours</span>
                    <span>30 hours</span>
                  </div>
                </div>
              </div>
            </div>
            <div class="flex w-full flex-col justify-center bg-neutral-50/50 p-6 sm:p-8 md:w-1/2">
              <div class="mb-6 border-b border-neutral-200 pb-6">
                <span class="mb-1 block font-mono text-[10px] uppercase text-neutral-500">Your selected schedule</span>
                <div class="text-2xl font-medium tracking-tight text-neutral-400">
                  <span id="schedule-val">4 weeks × 6 hours</span>
                </div>
              </div>
              <div>
                <span class="mb-1 flex items-center gap-2 font-mono text-[10px] uppercase text-emerald-600">
                  <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>ESTIMATED SUPPORT TIME
                </span>
                <div class="mb-2 text-4xl font-semibold tracking-tighter text-neutral-900">
                  <span id="total-val">24</span> hours
                </div>
                <p class="text-base font-light leading-relaxed text-neutral-500">
                  Use this estimate to start a conversation about the kind of postpartum help that fits your family.
                </p>
              </div>
            </div>
          </div>
        </div>
        <p class="mt-4 text-left text-[10px] text-neutral-400">
          Planning illustration only; not a quote, package, or confirmation of availability.
        </p>
      </div>
    </section>

    <section id="values" class="relative z-10 border-b border-neutral-200 bg-white">
      <div class="home-container relative z-10">
        <div class="mb-8 flex flex-col items-start justify-between gap-6 border-b border-neutral-200 pb-6 sm:mb-10 sm:pb-8 lg:flex-row">
          <h2 class="max-w-2xl text-2xl font-medium leading-[1.1] tracking-tight text-neutral-900 sm:text-3xl md:text-3xl">
            Support that respects <span class="text-neutral-400">your voice, your family, and your choices.</span>
          </h2>
          <a
            href="/about/"
            class="flex items-center gap-2 border-b border-neutral-200 pb-1 text-sm font-medium text-neutral-900 transition-colors hover:border-emerald-500 hover:text-emerald-600"
          >
            Meet your doula <span aria-hidden="true">↗</span>
          </a>
        </div>
        <div class="home-values-grid">
          <article class="home-value-primary">
            <div class="flex h-full flex-col justify-between bg-neutral-50 p-6 sm:p-8">
              <div>
                <h3 class="mb-4 text-base font-medium leading-tight tracking-tight text-neutral-900 sm:text-lg">
                  You deserve to feel heard.
                </h3>
                <p class="text-base font-light leading-relaxed text-neutral-500">
                  No one knows your hopes or your family better than you. My role is to help you ask questions, explore
                  options, and feel supported through your experience.
                </p>
              </div>
              <div class="mt-6 border-t border-neutral-200 pt-4">
                <span class="text-sm font-medium text-neutral-900">Teesee Logan</span>
                <div class="mt-1 font-mono text-[10px] uppercase tracking-wider text-neutral-500">
                  GRIT + GRACE DOULA
                </div>
              </div>
            </div>
          </article>
          <article class="home-value-philosophy">
            <div class="flex h-full flex-col justify-between bg-neutral-50 p-6 sm:p-8">
              <div class="text-left">
                <span class="mb-2 block font-mono text-xs uppercase tracking-widest text-neutral-500">
                  OUR PHILOSOPHY
                </span>
                <span class="text-sm font-medium tracking-tight text-neutral-900">Informed. Respected. Supported.</span>
              </div>
              <div class="my-8 border-y border-neutral-200 py-5">
                <span class="block text-2xl font-semibold tracking-tight text-neutral-900">YOU FIRST</span>
              </div>
              <a
                href="/about/"
                class="inline-flex w-fit items-center border-b border-neutral-200 py-3 text-xs font-semibold tracking-wide text-neutral-900 transition-colors hover:border-emerald-600 hover:text-emerald-700"
              >
                OUR STORY
              </a>
            </div>
          </article>
          <aside class="home-value-cta bg-neutral-900">
            <div>
              <p class="home-label">START WITH A CONVERSATION</p>
              <h3 class="text-lg font-medium tracking-tight text-white sm:text-xl">Let's talk.</h3>
              <p class="mt-3 max-w-reading text-sm leading-relaxed text-neutral-300">
                Not sure what type of support you need? A conversation is a good place to begin.
              </p>
            </div>
            <a href="/book/" class="home-value-cta-link">
              Ask about your free consultation <span aria-hidden="true">→</span>
            </a>
          </aside>
        </div>
      </div>
    </section>

    <section id="resources" class="relative z-10 border-b border-neutral-200 bg-neutral-50">
      <div class="home-container">
        <div class="rounded-sm border border-neutral-200">
          <div class="rounded-sm bg-white p-6 sm:p-8 md:p-12">
            <div class="grid grid-cols-1 items-start gap-8 md:grid-cols-12 md:gap-12">
              <div class="md:col-span-7">
                <div class="mb-6 inline-flex items-center gap-2 rounded-sm border border-emerald-100 bg-emerald-50 px-2 py-1">
                  <span class="font-mono text-[10px] uppercase tracking-wider text-emerald-600">PDF GUIDE</span>
                </div>
                <h2 class="mb-4 text-2xl font-medium tracking-tight text-neutral-900 sm:text-3xl">
                  Birth Better Guide
                </h2>
                <p class="mb-6 text-base font-light leading-relaxed text-neutral-500">
                  Product recommendations for pregnancy, postpartum, baby, and beyond, gathered in one guide with links
                  to explore items and resources.
                </p>
                <ul class="mb-8 space-y-2">
                  {[
                    'Pregnancy and preparation ideas',
                    'Postpartum and recovery suggestions',
                    'Baby products and additional resources',
                  ].map((line) => (
                    <li class="flex items-center gap-3 text-xs text-neutral-600">
                      <span class="text-emerald-500">✓</span>
                      {line}
                    </li>
                  ))}
                </ul>
              </div>
              <div class="w-full md:col-span-5">
                <div class="rounded-sm border border-neutral-200 bg-neutral-50 p-6">
                  <span class="mb-3 block font-mono text-[10px] uppercase tracking-wider text-neutral-500">
                    START HERE
                  </span>
                  <p class="mb-6 text-sm leading-relaxed text-neutral-700">
                    See what the guide includes, its current price, and where checkout and PDF delivery happen.
                  </p>
                  <div class="rounded-sm border border-neutral-200">
                    <a
                      href="/resources/better-birth-guide/"
                      class="block rounded-sm bg-neutral-900 px-4 py-3 text-left text-xs font-semibold tracking-wide text-white transition-colors hover:bg-neutral-800"
                    >
                      GUIDE DETAILS & CHECKOUT →
                    </a>
                  </div>
                  <a
                    href="/resources/blog/"
                    class="mt-4 block text-left text-xs text-neutral-500 underline-offset-4 hover:underline"
                  >
                    Read the blog
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="common-questions" class="relative z-10 border-t border-neutral-200 bg-neutral-50">
      <div class="home-container grid gap-8 lg:grid-cols-12 lg:gap-10">
        <div class="mb-10 lg:col-span-4">
          <p class="mb-4 font-mono text-[10px] uppercase tracking-widest text-emerald-600">COMMON QUESTIONS</p>
          <h3 class="text-2xl font-medium tracking-tighter text-neutral-900 sm:text-3xl">
            A few things you may be wondering.
          </h3>
        </div>
        <div class="divide-y divide-neutral-200 border-y border-neutral-200 lg:col-span-8">
          {faqs.map((faq) => (
            <details class="group bg-white/60 px-5 py-5">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-sm font-medium text-neutral-900">
                {faq.question}
                <span class="text-xl font-light text-neutral-500 group-open:rotate-45">+</span>
              </summary>
              <p class="max-w-2xl pt-4 text-base font-light leading-relaxed text-neutral-500">{faq.answer}</p>
            </details>
          ))}
        </div>
        <div class="mt-6 lg:col-start-5 lg:col-span-8">
          <a href="/services/#faqs" class="text-xs font-medium text-neutral-700 underline-offset-4 hover:underline">
            More frequently asked questions →
          </a>
        </div>
      </div>
    </section>

    <section id="contact" class="relative z-10 border-t border-neutral-200 bg-white">
      <div class="home-container grid gap-8 lg:grid-cols-12 lg:gap-10">
        <div class="mb-8 max-w-3xl lg:col-span-7 sm:mb-12">
          <p class="mb-4 font-mono text-[10px] uppercase tracking-widest text-emerald-600">YOUR NEXT STEP</p>
          <h3 class="mb-4 text-2xl font-medium tracking-tighter text-neutral-900 sm:text-3xl md:text-4xl">
            Let's talk about what support looks like for you.
          </h3>
          <p class="text-base font-light text-neutral-500">
            A free 30-minute conversation to connect, ask questions, and explore your options. No pressure or
            obligation.
          </p>
        </div>
        <div class="rounded-sm border border-neutral-200 lg:col-span-5">
          <div class="rounded-sm bg-neutral-50 p-6 text-left sm:p-8">
            <p class="home-label mb-5">G+G / PERSONAL SUPPORT</p>
            <h4 class="mb-3 text-lg font-medium text-neutral-900">Come as you are.</h4>
            <p class="mb-8 max-w-md text-base font-light leading-relaxed text-neutral-500">
              Whether you're planning for birth or navigating postpartum life, we'd love to hear what matters to you.
            </p>
            <div class="max-w-sm rounded-sm border border-neutral-200">
              <a
                href="/book/"
                class="block rounded-sm bg-neutral-900 px-6 py-4 text-left text-xs font-semibold tracking-wide text-white transition-colors hover:bg-neutral-800"
              >
                ASK ABOUT A FREE CONSULTATION →
              </a>
            </div>
            <a href="/contact/" class="mt-5 inline-block text-xs text-neutral-500 underline-offset-4 hover:underline">
              Prefer to send a message?
            </a>
          </div>
        </div>
      </div>
    </section>
  </div>
</Layout>
<script>
  const weeks = document.querySelector<HTMLInputElement>('#weeks-range');
  const hours = document.querySelector<HTMLInputElement>('#hours-range');
  const weeksValue = document.querySelector<HTMLElement>('#weeks-val');
  const hoursValue = document.querySelector<HTMLElement>('#hours-val');
  const scheduleValue = document.querySelector<HTMLElement>('#schedule-val');
  const totalValue = document.querySelector<HTMLElement>('#total-val');
  function updatePlanner() {
    if (!weeks || !hours || !weeksValue || !hoursValue || !scheduleValue || !totalValue) return;
    const w = Number(weeks.value);
    const h = Number(hours.value);
    weeksValue.textContent = String(w);
    hoursValue.textContent = String(h);
    scheduleValue.textContent = `${w} ${w === 1 ? 'week' : 'weeks'} × ${h} hours`;
    totalValue.textContent = String(w * h);
  }
  weeks?.addEventListener('input', updatePlanner);
  hours?.addEventListener('input', updatePlanner);
  updatePlanner();
</script>
<style>
  @font-face {
    font-family: 'Newsreader';
    font-style: normal;
    font-weight: 300 600;
    font-display: swap;
    src: url('/fonts/newsreader-latin.woff2') format('woff2');
  }

  .gg-home {
    --gg-page: #f5f4ec;
    --gg-surface: #fbfaf5;
    --gg-subtle: #eeefe5;
    --home-panel-surface: #fbfaf7;
    --gg-heading: #303a27;
    --gg-body: #3c4335;
    --gg-muted: #68705e;
    --gg-border: #c8cdbb;
    --gg-border-strong: #8e967d;
    --gg-primary: #3e4930;
    --gg-button: #3e4930;
    --gg-secondary: #303a27;
    --gg-color-on-primary: #f7f6ef;
    --gg-font-mono: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, 'Liberation Mono', monospace;
    background-color: var(--gg-page);
    color: var(--gg-body);
    font-family: var(--gg-font-mono);
    font-size: 1rem;
  }

  :global(.dark) .gg-home {
    --gg-page: #1c2119;
    --gg-surface: #242a20;
    --gg-subtle: #2b3225;
    --home-panel-surface: var(--gg-surface);
    --gg-heading: #eef0e5;
    --gg-body: #d9ddcf;
    --gg-muted: #aeb59f;
    --gg-border: #48513d;
    --gg-border-strong: #697454;
    --gg-primary: #bac795;
    --gg-button: #596444;
    --gg-secondary: #4b5738;
    --gg-color-on-primary: #f5f4ec;
  }

  .gg-home,
  .gg-home *,
  .gg-home::before,
  .gg-home::after,
  .gg-home *::before,
  .gg-home *::after {
    border-radius: 0 !important;
  }

  .home-hero {
    display: flex;
    min-height: min(38rem, calc(100svh - 4.25rem));
    align-items: center;
    border-bottom: 1px solid var(--gg-border);
    background-color: var(--gg-surface);
    color: var(--gg-heading);
    text-align: left;
  }

  :global(.gg-home .client-journey) {
    --journey-bg: #fbfaf5;
    --journey-ink: #303a27;
    --journey-copy: #68705e;
    --journey-rule: #c8cdbb;
  }

  :global(.gg-home .client-journey [class*='rounded']) {
    border-radius: 0 !important;
  }

  :global(.dark .gg-home .client-journey) {
    --journey-bg: #242a20;
    --journey-ink: #eef0e5;
    --journey-copy: #aeb59f;
    --journey-rule: #48513d;
  }

  .home-hero-content {
    width: min(100% - 3rem, 72rem);
    margin-inline: auto;
    padding-block: clamp(4rem, 8vw, 6rem);
  }

  .home-hero-grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    align-items: end;
    gap: clamp(2rem, 5vw, 4.5rem);
  }

