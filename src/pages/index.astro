---
import Layout from '~/layouts/Layout.astro';

const metadata = {
  title: 'Teesee | The GG Doula',
  description:
    'Personalized prenatal, birth, postpartum, virtual doula, feeding education, and newborn-care support from Grit + Grace Doula in Orange County, California.',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <link slot="head" rel="preload" href="/fonts/newsreader-latin.woff2" as="font" type="font/woff2" crossorigin />
  <main id="main-content" class="brand-hero" aria-labelledby="home-title">
    <canvas class="brand-threads" data-brand-threads aria-hidden="true"></canvas>
    <h1 id="home-title" class="brand-lockup">
      <span class="brand-name">teesee</span>
      <span class="brand-divider" aria-hidden="true">
        |
      </span>
      <span class="brand-description">the gg doula</span>
    </h1>
  </main>
</Layout>

<script>
  let stopBrandThreads: (() => void) | undefined;

  function startBrandThreads() {
    stopBrandThreads?.();
    stopBrandThreads = undefined;

    const canvas = document.querySelector<HTMLCanvasElement>('[data-brand-threads]');
    const context = canvas?.getContext('2d');
    if (!canvas || !context) return;
    const brandCanvas = canvas;
    const brandContext = context;

    const motionPreference = window.matchMedia('(prefers-reduced-motion: reduce)');
    let width = 0;
    let height = 0;
    let pixelRatio = 1;
    let frame = 0;
    let active = true;
    const ink = getComputedStyle(document.documentElement).getPropertyValue('--gg-color-on-brand').trim();

    function resize() {
      const bounds = brandCanvas.getBoundingClientRect();
      pixelRatio = Math.min(window.devicePixelRatio || 1, 2);
      width = bounds.width;
      height = bounds.height;
      brandCanvas.width = Math.round(width * pixelRatio);
      brandCanvas.height = Math.round(height * pixelRatio);
      brandContext.setTransform(pixelRatio, 0, 0, pixelRatio, 0, 0);
      draw(0);
    }

    function draw(time: number) {
      brandContext.clearRect(0, 0, width, height);
      if (!width || !height) return;

      const centerY = height * 0.76;
      const amplitude = Math.min(42, height * 0.055);
      const segments = Math.ceil(width / 28);
      const phase = motionPreference.matches ? 0 : time * 0.00024;
      const points: Array<{ x: number; first: number; second: number; depth: number }> = [];

      for (let index = 0; index <= segments; index += 1) {
        const x = (index / segments) * width;
        const angle = index * 0.34 - phase;
        points.push({
          x,
          first: centerY + Math.sin(angle) * amplitude,
          second: centerY + Math.sin(angle + Math.PI) * amplitude,
          depth: (Math.cos(angle) + 1) / 2,
        });
      }

      brandContext.lineWidth = 1;
      brandContext.strokeStyle = ink;
      brandContext.globalAlpha = 0.2;
      for (const point of points) {
        if (Math.round(point.x / 28) % 3 !== 0) continue;
        brandContext.globalAlpha = 0.06 + point.depth * 0.12;
        brandContext.beginPath();
        brandContext.moveTo(point.x, point.first);
        brandContext.lineTo(point.x, point.second);
        brandContext.stroke();
      }

      brandContext.lineWidth = 1.5;
      brandContext.globalAlpha = 0.28;
      for (const strand of ['first', 'second'] as const) {
        brandContext.beginPath();
        points.forEach((point, index) => {
          const y = point[strand];
          if (index === 0) brandContext.moveTo(point.x, y);
          else brandContext.lineTo(point.x, y);
        });
        brandContext.stroke();
      }

      const labelFont =
        getComputedStyle(document.documentElement).getPropertyValue('--gg-type-font-label').trim() || 'monospace';
      brandContext.font = `500 11px ${labelFont}`;
      brandContext.textAlign = 'center';
      brandContext.textBaseline = 'middle';
      points.forEach((point, index) => {
        if (index % 5 !== 0) return;
        brandContext.globalAlpha = 0.22 + point.depth * 0.2;
        brandContext.fillText('t', point.x, point.first);
        brandContext.fillText('g', point.x, point.second);
      });
      brandContext.globalAlpha = 1;
    }

    function animate(time: number) {
      if (!active) return;
      draw(time);
      if (!motionPreference.matches) frame = window.requestAnimationFrame(animate);
    }

    function updateMotion() {
      window.cancelAnimationFrame(frame);
      draw(0);
      if (!motionPreference.matches) frame = window.requestAnimationFrame(animate);
    }

    function stop() {
      active = false;
      window.cancelAnimationFrame(frame);
      window.removeEventListener('resize', resize);
      motionPreference.removeEventListener('change', updateMotion);
      document.removeEventListener('astro:before-swap', stop);
    }

    resize();
    window.addEventListener('resize', resize, { passive: true });
    motionPreference.addEventListener('change', updateMotion);
    document.addEventListener('astro:before-swap', stop, { once: true });
    if (!motionPreference.matches) frame = window.requestAnimationFrame(animate);
    stopBrandThreads = stop;
  }

  document.addEventListener('astro:page-load', startBrandThreads);
  startBrandThreads();
</script>

<style>
  :global(body:has(.brand-hero)) {
    min-height: 100svh;
    background: var(--gg-color-brand);
    color: var(--gg-color-on-brand);
  }

  .brand-hero {
    position: relative;
    display: grid;
    min-height: 100vh;
    min-height: 100svh;
    width: 100%;
    overflow: hidden;
    place-items: center;
    isolation: isolate;
    background: var(--gg-color-brand);
    color: var(--gg-color-on-brand);
  }

  .brand-threads {
    position: absolute;
    inset: 0;
    z-index: 0;
    display: block;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .brand-lockup {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: clamp(0.8rem, 2vw, 1.8rem);
    margin: 0;
    padding: 1.5rem;
    color: inherit;
    font-weight: 400;
    animation: arrive 1100ms cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }

  .brand-name {
    font-family: var(--gg-font-display), Georgia, serif;
    font-size: clamp(5rem, 17vw, 15rem);
    letter-spacing: -0.04em;
    line-height: 0.9;
  }

  .brand-divider {
    font-family: var(--gg-type-font-body), sans-serif;
    font-size: clamp(2rem, 5vw, 4.5rem);
    font-weight: 300;
    opacity: 0.65;
  }

  .brand-description {
    font-family: var(--gg-type-font-body), sans-serif;
    font-size: clamp(0.95rem, 2vw, 1.5rem);
    font-weight: 400;
    letter-spacing: 0.015em;
    line-height: 1.2;
    white-space: nowrap;
  }

  @keyframes arrive {
    from {
      opacity: 0;
      transform: translateY(0.45rem);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 640px) {
    .brand-lockup {
      flex-direction: column;
      align-items: center;
      gap: 0.9rem;
    }

    .brand-name {
      font-size: clamp(5rem, 23vw, 8rem);
    }

    .brand-divider {
      font-size: 0;
      width: 1px;
      height: 1.5rem;
      background: currentColor;
    }

    .brand-description {
      font-size: 1rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .brand-lockup {
      animation: none;
    }
  }
</style>
