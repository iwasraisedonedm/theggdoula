---
import Layout from '~/layouts/PageLayout.astro';
import ClientJourney from '~/components/widgets/ClientJourney.astro';

/**
 * Grit + Grace Doula — homepage adapted from user-provided Aura HTML.
 * Astro 7 + Tailwind CSS v4, with minimal vanilla JS and no React dependency.
 * The internal links assume the routes in the doula project exist.
 */
const services = [
  {
    number: '01',
    name: 'Prenatal Support',
    description:
      'One-on-one preparation for pregnancy, birth preferences, informed choices, and the questions that come up along the way.',
    href: '/services/prenatal/',
    label: 'BEFORE BIRTH',
    icon: 'sun',
  },
  {
    number: '02',
    name: 'Birth Doula Support',
    description:
      'Continuous emotional, physical, and informational support during labor and birth—for you and the people by your side.',
    href: '/services/birth/',
    label: 'LABOR & BIRTH',
    icon: 'heart',
  },
  {
    number: '03',
    name: 'Postpartum Care',
    description:
      'Gentle, practical care as you recover, bond with your baby, adjust to new routines, and find your footing at home.',
    href: '/services/postpartum/',
    label: 'AFTER BIRTH',
    icon: 'home',
  },
  {
    number: '04',
    name: 'Breastfeeding & Newborn Care',
    description:
      'Personalized feeding education and newborn-care guidance that helps you make confident, informed decisions.',
    href: '/services/breastfeeding/',
    label: 'FEEDING & BABY',
    icon: 'sparkles',
  },
];
const stages = ['Pregnancy', 'Labor & birth', 'Postpartum', 'Newborn care', 'Feeding support', 'Family education'];
const faqs = [
  {
    question: 'What does a doula do?',
    answer:
      'A doula provides nonmedical emotional, physical, and informational support. Your doula complements—not replaces—your medical care team.',
  },
  {
    question: 'When should I book a doula?',
    answer:
      'You can reach out at any point in pregnancy or postpartum. Earlier contact allows more time to discuss preferences and availability.',
  },
  {
    question: 'Can my partner be involved?',
    answer:
      'Yes. Doula support can include your partner or chosen support people so everyone feels informed, included, and supported.',
  },
];
const metadata = {
  title: 'Grit + Grace Doula | Birth & Postpartum Support',
  description:
    'Compassionate prenatal, birth, postpartum, breastfeeding, and newborn-care support from Grit + Grace Doula. Ask about a free 30-minute consultation.',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <div class="gg-home relative isolate overflow-hidden bg-page text-neutral-600 selection:bg-emerald-500/20 selection:text-emerald-800">
    <div class="bg-grid-pattern pointer-events-none absolute inset-0 z-0 opacity-60" aria-hidden="true"></div>
    <!-- Hero: preserves vertical rule, decorator and paired CTA treatments -->
    <section class="relative z-10 mx-auto max-w-6xl px-4 pb-12 pt-16 sm:px-6 sm:pb-24 sm:pt-24">
      <div class="relative flex flex-col items-start gap-6 border-l border-neutral-200 pb-20 pl-6 sm:gap-8 sm:pl-8 md:pl-12">
        <div
          class="absolute -left-[5px] top-0 h-[9px] w-[9px] border border-neutral-200 bg-white"
          aria-hidden="true"
        ></div>
        <div class="inline-flex items-center gap-2 border border-neutral-200 bg-neutral-50 px-3 py-1.5">
          <span class="h-2 w-2 rounded-full bg-emerald-600" aria-hidden="true"></span>
          <span class="text-[10px] font-medium uppercase tracking-wide text-emerald-700">
            COMPASSIONATE SUPPORT AT EVERY STAGE
          </span>
        </div>
        <h1 class="max-w-5xl font-heading text-4xl font-medium leading-[1.1] tracking-tighter text-neutral-900 sm:text-5xl md:text-7xl">
          Strong in your journey.
          <br />
          <span class="text-neutral-400">Supported through every moment.</span>
        </h1>
        <p class="max-w-xl text-base font-light leading-relaxed text-neutral-500">
          Pregnancy, birth, and life with a new baby are deeply personal. Grit + Grace Doula offers thoughtful
          education, steady encouragement, and hands-on support—so you can feel heard, informed, and cared for.
        </p>
        <div class="mt-4 flex w-full flex-col gap-3 sm:mt-6 sm:w-auto sm:flex-row sm:gap-4">
          <div class="rounded-sm border border-neutral-200">
            <a
              href="/book/"
              class="block rounded-sm bg-neutral-900 px-6 py-3.5 text-center text-xs font-semibold tracking-wide text-white transition-colors hover:bg-neutral-800"
            >
              ASK ABOUT A FREE 30-MINUTE CONSULTATION
            </a>
          </div>
          <div class="rounded-sm border border-neutral-200">
            <a
              href="#services"
              class="flex items-center justify-center gap-2 rounded-sm bg-white/90 px-6 py-3.5 text-center text-xs font-medium text-neutral-600 transition-colors hover:text-black"
            >
              EXPLORE SERVICES <span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>
      </div>
      <div class="relative z-30 mt-8 grid grid-cols-2 border-y border-neutral-200 bg-white/60 sm:mt-16 md:grid-cols-4">
        {[
          ['PRENATAL', 'Preparation & education'],
          ['BIRTH', 'Continuous doula support'],
          ['POSTPARTUM', 'Recovery & family care'],
          ['NEWBORN', 'Feeding & practical guidance'],
        ].map(([heading, description], i) => (
          <div
            class:list={[
              'p-4 text-center sm:p-8',
              i % 2 === 0 ? 'border-r' : '',
              i < 2 ? 'border-b md:border-b-0' : '',
              i === 1 ? 'md:border-r' : '',
              'border-neutral-200',
            ]}
          >
            <div class="mb-1 text-lg font-medium tracking-tighter text-neutral-900 sm:text-2xl">{heading}</div>
            <div class="font-mono text-[9px] uppercase tracking-widest text-neutral-500 sm:text-[10px]">
              {description}
            </div>
          </div>
        ))}
      </div>
    </section>

    <section aria-label="Areas of care" class="border-b border-neutral-200 bg-white py-8 sm:py-10">
      <div class="mx-auto flex max-w-6xl flex-wrap justify-center gap-x-8 gap-y-4 px-4 sm:px-6">
        {stages.map((stage) => (
          <span class="flex items-center gap-3 text-sm font-medium tracking-tight text-neutral-500 sm:text-base">
            <span class="h-2 w-2 border border-neutral-300 bg-neutral-200" aria-hidden="true"></span>
            {stage}
          </span>
        ))}
      </div>
    </section>

    <section class="relative z-10 border-b border-neutral-200 bg-white py-16 sm:py-24">
      <div class="mx-auto max-w-4xl px-4 sm:px-6">
        <h2 class="mb-4 flex items-center gap-2 font-mono text-[10px] uppercase tracking-widest text-emerald-600">
          <span class="h-1 w-1 rounded-full bg-emerald-500"></span>YOU DESERVE SUPPORT
        </h2>
        <h3 class="mb-8 text-2xl font-medium tracking-tighter text-neutral-900 sm:mb-12 sm:text-3xl md:text-4xl">
          You don't have to figure everything out alone.
        </h3>
        <div class="grid grid-cols-1 gap-4 sm:gap-6 md:grid-cols-2">
          <div class="group h-full rounded-sm border border-neutral-200">
            <div class="h-full rounded-sm bg-neutral-50 p-6 sm:p-8">
              <div class="mb-6 flex h-10 w-10 items-center justify-center rounded-full border border-neutral-200 bg-white text-emerald-700">
                ?
              </div>
              <h4 class="mb-2 text-base font-medium tracking-tight text-neutral-900">
                So many decisions. So little clarity.
              </h4>
              <p class="text-base font-light leading-relaxed text-neutral-500">
                From birth preferences to feeding choices, conflicting advice can make even simple decisions feel
                overwhelming. You deserve time, information, and space to ask questions.
              </p>
            </div>
          </div>
          <div class="group h-full rounded-sm border border-neutral-200">
            <div class="h-full rounded-sm bg-neutral-50 p-6 sm:p-8">
              <div class="mb-6 flex h-10 w-10 items-center justify-center rounded-full border border-neutral-200 bg-white text-emerald-700">
                ♡
              </div>
              <h4 class="mb-2 text-base font-medium tracking-tight text-neutral-900">
                Your care should feel personal.
              </h4>
              <p class="text-base font-light leading-relaxed text-neutral-500">
                Every family, birth, and recovery looks different. Support should adapt to your values, circumstances,
                and the way you want to welcome your baby.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- The original calculator's two-column card becomes a practical planning tool -->
    <section id="planner" class="relative z-10 border-b border-neutral-200 bg-neutral-50 py-16 sm:py-24">
      <div class="mx-auto max-w-4xl px-4 sm:px-6">
        <div class="mb-10 text-center">
          <h2 class="mb-4 flex items-center justify-center gap-2 font-mono text-[10px] uppercase tracking-widest text-emerald-600">
            <span class="h-1 w-1 rounded-full bg-emerald-500"></span>POSTPARTUM PLANNING TOOL
          </h2>
          <h3 class="text-2xl font-medium tracking-tighter text-neutral-900 sm:text-3xl">
            Make room for the support you need.
          </h3>
        </div>
        <div class="rounded-sm border border-neutral-200">
          <div class="flex flex-col rounded-sm bg-white md:flex-row">
            <div class="w-full border-b border-neutral-100 p-6 sm:p-8 md:w-1/2 md:border-b-0 md:border-r">
              <div class="space-y-8">
                <div>
                  <div class="mb-3 flex items-baseline justify-between">
                    <label for="weeks-range" class="font-mono text-[10px] uppercase tracking-wider text-neutral-500">
                      Weeks of support
                    </label>
                    <span class="text-sm font-medium text-neutral-900">
                      <span id="weeks-val">4</span> weeks
                    </span>
                  </div>
                  <input type="range" id="weeks-range" min="1" max="12" step="1" value="4" class="w-full" />
                  <div class="mt-2 flex justify-between font-mono text-[10px] text-neutral-400">
                    <span>1 week</span>
                    <span>12 weeks</span>
                  </div>
                </div>
                <div>
                  <div class="mb-3 flex items-baseline justify-between">
                    <label for="hours-range" class="font-mono text-[10px] uppercase tracking-wider text-neutral-500">
                      Hours per week
                    </label>
                    <span class="text-sm font-medium text-neutral-900">
                      <span id="hours-val">6</span> hours
                    </span>
                  </div>
                  <input type="range" id="hours-range" min="2" max="30" step="2" value="6" class="w-full" />
                  <div class="mt-2 flex justify-between font-mono text-[10px] text-neutral-400">
                    <span>2 hours</span>
                    <span>30 hours</span>
                  </div>
                </div>
              </div>
            </div>
            <div class="flex w-full flex-col justify-center bg-neutral-50/50 p-6 sm:p-8 md:w-1/2">
              <div class="mb-6 border-b border-neutral-200 pb-6">
                <span class="mb-1 block font-mono text-[10px] uppercase text-neutral-500">Your selected schedule</span>
                <div class="text-2xl font-medium tracking-tight text-neutral-400">
                  <span id="schedule-val">4 weeks × 6 hours</span>
                </div>
              </div>
              <div>
                <span class="mb-1 flex items-center gap-2 font-mono text-[10px] uppercase text-emerald-600">
                  <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-emerald-500"></span>ESTIMATED SUPPORT TIME
                </span>
                <div class="mb-2 text-4xl font-semibold tracking-tighter text-neutral-900">
                  <span id="total-val">24</span> hours
                </div>
                <p class="text-base font-light leading-relaxed text-neutral-500">
                  Use this estimate to start a conversation about the kind of postpartum help that fits your family.
                </p>
              </div>
            </div>
          </div>
        </div>
        <p class="mt-4 text-center text-[10px] text-neutral-400">
          Planning illustration only; not a quote, package, or confirmation of availability.
        </p>
      </div>
    </section>

    <section class="relative z-10 border-b border-neutral-200 bg-white py-16 sm:py-24">
      <div class="relative z-10 mx-auto max-w-6xl px-4 sm:px-6">
        <div class="mb-12 flex flex-col items-start justify-between gap-6 border-b border-neutral-200 pb-6 sm:mb-16 sm:pb-8 lg:flex-row">
          <h2 class="max-w-2xl text-2xl font-medium leading-[1.1] tracking-tight text-neutral-900 sm:text-3xl md:text-4xl">
            Support that respects <span class="text-neutral-400">your voice, your family, and your choices.</span>
          </h2>
          <a
            href="/about/"
            class="flex items-center gap-2 border-b border-neutral-200 pb-1 text-sm font-medium text-neutral-900 transition-colors hover:border-emerald-500 hover:text-emerald-600"
          >
            Meet your doula <span aria-hidden="true">↗</span>
          </a>
        </div>
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
          <div class="rounded-sm border border-neutral-200">
            <div class="flex min-h-[320px] flex-col justify-between rounded-sm bg-neutral-50 p-6 sm:p-8">
              <div>
                <h3 class="mb-4 text-base font-medium leading-tight tracking-tight text-neutral-900 sm:text-lg">
                  You deserve to feel heard.
                </h3>
                <p class="text-base font-light leading-relaxed text-neutral-500">
                  No one knows your hopes or your family better than you. My role is to help you ask questions, explore
                  options, and feel supported through your experience.
                </p>
              </div>
              <div class="mt-6 border-t border-neutral-200 pt-4">
                <span class="text-sm font-medium text-neutral-900">Teesee Logan</span>
                <div class="mt-1 font-mono text-[10px] uppercase tracking-wider text-neutral-500">
                  GRIT + GRACE DOULA
                </div>
              </div>
            </div>
          </div>
          <div class="rounded-sm border border-neutral-200">
            <div class="flex min-h-[320px] flex-col items-center justify-between rounded-sm bg-neutral-50 p-6 sm:p-8">
              <div class="text-center">
                <span class="mb-2 block font-mono text-xs uppercase tracking-widest text-neutral-500">
                  OUR PHILOSOPHY
                </span>
                <span class="text-sm font-medium tracking-tight text-neutral-900">Informed. Respected. Supported.</span>
              </div>
              <div class="relative flex h-32 w-32 items-center justify-center rounded-full border border-neutral-200">
                <span class="text-center text-2xl font-medium tracking-tighter text-neutral-900">
                  YOU
                  <br />
                  FIRST
                </span>
              </div>
              <a
                href="/about/"
                class="w-full rounded-sm border border-neutral-200 bg-white py-3 text-center text-xs font-semibold tracking-wide text-neutral-900 transition-colors hover:bg-neutral-100"
              >
                OUR STORY
              </a>
            </div>
          </div>
          <div class="rounded-sm border border-neutral-200 sm:col-span-2 lg:col-span-1">
            <div class="flex min-h-[320px] flex-col justify-between rounded-sm bg-neutral-900 p-6 sm:p-8">
              <div class="flex items-start justify-between text-white">
                <span class="text-base font-medium tracking-tight sm:text-lg">Let's Talk</span>
                <span class="text-neutral-500">↗</span>
              </div>
              <p class="text-base font-light leading-relaxed text-neutral-300">
                Not sure what type of support you need? A conversation is a good place to begin.
              </p>
              <a
                href="/book/"
                class="flex items-center gap-3 text-sm text-neutral-300 transition-colors hover:text-white"
              >
                <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>Ask about your free consultation
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="resources" class="relative z-10 border-b border-neutral-200 bg-neutral-50 py-16 sm:py-24">
      <div class="mx-auto max-w-4xl px-4 sm:px-6">
        <div class="rounded-sm border border-neutral-200">
          <div class="rounded-sm bg-white p-6 sm:p-8 md:p-12">
            <div class="flex flex-col items-center gap-8 md:flex-row md:gap-12">
              <div class="flex-1">
                <div class="mb-6 inline-flex items-center gap-2 rounded-sm border border-emerald-100 bg-emerald-50 px-2 py-1">
                  <span class="font-mono text-[10px] uppercase tracking-wider text-emerald-600">PDF GUIDE</span>
                </div>
                <h2 class="mb-4 text-2xl font-medium tracking-tight text-neutral-900 sm:text-3xl">
                  Birth Better Guide
                </h2>
                <p class="mb-6 text-base font-light leading-relaxed text-neutral-500">
                  Product recommendations for pregnancy, postpartum, baby, and beyond, gathered in one guide with links
                  to explore items and resources.
                </p>
                <ul class="mb-8 space-y-2">
                  {[
                    'Pregnancy and preparation ideas',
                    'Postpartum and recovery suggestions',
                    'Baby products and additional resources',
                  ].map((line) => (
                    <li class="flex items-center gap-3 text-xs text-neutral-600">
                      <span class="text-emerald-500">✓</span>
                      {line}
                    </li>
                  ))}
                </ul>
              </div>
              <div class="w-full md:w-72">
                <div class="rounded-sm border border-neutral-200 bg-neutral-50 p-6">
                  <span class="mb-3 block font-mono text-[10px] uppercase tracking-wider text-neutral-500">
                    START HERE
                  </span>
                  <p class="mb-6 text-sm leading-relaxed text-neutral-700">
                    See what the guide includes, its current price, and where checkout and PDF delivery happen.
                  </p>
                  <div class="rounded-sm border border-neutral-200">
                    <a
                      href="/resources/better-birth-guide/"
                      class="block rounded-sm bg-neutral-900 px-4 py-3 text-center text-xs font-semibold tracking-wide text-white transition-colors hover:bg-neutral-800"
                    >
                      GUIDE DETAILS & CHECKOUT →
                    </a>
                  </div>
                  <a
                    href="/resources/blog/"
                    class="mt-4 block text-center text-xs text-neutral-500 underline-offset-4 hover:underline"
                  >
                    Read the blog
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="services" class="relative z-10 bg-white py-16 sm:py-24">
      <div class="mx-auto max-w-5xl px-4 sm:px-6">
        <div class="mb-12 text-center sm:mb-16">
          <h2 class="mb-4 font-mono text-[10px] uppercase tracking-widest text-emerald-600">WAYS WE CAN SUPPORT YOU</h2>
          <h3 class="text-2xl font-medium tracking-tighter text-neutral-900 sm:text-3xl">
            Care for every stage of your journey.
          </h3>
        </div>
        <div class="grid grid-cols-1 gap-4 sm:gap-6 md:grid-cols-2">
          {services.map((service) => (
            <article class="group h-full rounded-sm border border-neutral-200">
              <div class="relative z-10 flex h-full flex-col rounded-sm bg-neutral-50 p-6 sm:p-8">
                <div class="mb-6 flex items-start justify-between">
                  <div class="flex h-10 w-10 items-center justify-center rounded-sm border border-neutral-200 bg-white font-mono text-xs text-emerald-600">
                    {service.number}
                  </div>
                  <span class="rounded-sm border border-neutral-200 bg-white px-2 py-1 font-mono text-[10px] text-neutral-500">
                    {service.label}
                  </span>
                </div>
                <h4 class="mb-2 text-base font-medium tracking-tight text-neutral-900 sm:text-lg">{service.name}</h4>
                <p class="mb-6 text-base font-light leading-relaxed text-neutral-500">{service.description}</p>
                <a
                  class="mt-auto border-t border-neutral-200 pt-5 text-xs font-medium text-neutral-700 transition-colors hover:text-emerald-600"
                  href={service.href}
                >
                  LEARN MORE <span aria-hidden="true">↗</span>
                </a>
              </div>
            </article>
          ))}
        </div>
        <div class="mt-8 text-center">
          <a href="/services/" class="text-xs font-medium text-neutral-700 underline-offset-4 hover:underline">
            Explore all services
          </a>
        </div>
      </div>
    </section>

    <ClientJourney />

    <section id="common-questions" class="relative z-10 border-t border-neutral-200 bg-neutral-50 py-16 sm:py-24">
      <div class="mx-auto max-w-3xl px-4 sm:px-6">
        <div class="mb-10 text-center">
          <h2 class="mb-4 font-mono text-[10px] uppercase tracking-widest text-emerald-600">COMMON QUESTIONS</h2>
          <h3 class="text-2xl font-medium tracking-tighter text-neutral-900 sm:text-3xl">
            A few things you may be wondering.
          </h3>
        </div>
        <div class="divide-y divide-neutral-200 border-y border-neutral-200">
          {faqs.map((faq) => (
            <details class="group bg-white/60 px-5 py-5">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-sm font-medium text-neutral-900">
                {faq.question}
                <span class="text-xl font-light text-neutral-500 group-open:rotate-45">+</span>
              </summary>
              <p class="max-w-2xl pt-4 text-base font-light leading-relaxed text-neutral-500">{faq.answer}</p>
            </details>
          ))}
        </div>
        <div class="mt-6 text-center">
          <a href="#common-questions" class="text-xs font-medium text-neutral-700 underline-offset-4 hover:underline">
            More frequently asked questions →
          </a>
        </div>
      </div>
    </section>

    <section id="contact" class="relative z-10 border-t border-neutral-200 bg-white py-16 sm:py-24">
      <div class="mx-auto max-w-3xl px-4 sm:px-6">
        <div class="mb-8 text-center sm:mb-12">
          <h2 class="mb-4 font-mono text-[10px] uppercase tracking-widest text-emerald-600">YOUR NEXT STEP</h2>
          <h3 class="mb-4 text-2xl font-medium tracking-tighter text-neutral-900 sm:text-3xl md:text-4xl">
            Let's talk about what support looks like for you.
          </h3>
          <p class="text-base font-light text-neutral-500">
            A free 30-minute conversation to connect, ask questions, and explore your options. No pressure or
            obligation.
          </p>
        </div>
        <div class="rounded-sm border border-neutral-200">
          <div class="rounded-sm bg-neutral-50 p-6 text-center sm:p-8">
            <div class="mx-auto mb-6 flex h-14 w-14 items-center justify-center rounded-full border border-neutral-200 bg-white text-xl text-emerald-600">
              ♡
            </div>
            <h4 class="mb-3 text-lg font-medium text-neutral-900">Come as you are.</h4>
            <p class="mx-auto mb-8 max-w-md text-base font-light leading-relaxed text-neutral-500">
              Whether you're planning for birth or navigating postpartum life, we'd love to hear what matters to you.
            </p>
            <div class="mx-auto max-w-sm rounded-sm border border-neutral-200">
              <a
                href="/book/"
                class="block rounded-sm bg-neutral-900 px-6 py-4 text-xs font-semibold tracking-wide text-white transition-colors hover:bg-neutral-800"
              >
                ASK ABOUT A FREE CONSULTATION →
              </a>
            </div>
            <a href="/contact/" class="mt-5 inline-block text-xs text-neutral-500 underline-offset-4 hover:underline">
              Prefer to send a message?
            </a>
          </div>
        </div>
      </div>
    </section>
  </div>
</Layout>
<script>
  const weeks = document.querySelector<HTMLInputElement>('#weeks-range');
  const hours = document.querySelector<HTMLInputElement>('#hours-range');
  const weeksValue = document.querySelector<HTMLElement>('#weeks-val');
  const hoursValue = document.querySelector<HTMLElement>('#hours-val');
  const scheduleValue = document.querySelector<HTMLElement>('#schedule-val');
  const totalValue = document.querySelector<HTMLElement>('#total-val');
  function updatePlanner() {
    if (!weeks || !hours || !weeksValue || !hoursValue || !scheduleValue || !totalValue) return;
    const w = Number(weeks.value);
    const h = Number(hours.value);
    weeksValue.textContent = String(w);
    hoursValue.textContent = String(h);
    scheduleValue.textContent = `${w} ${w === 1 ? 'week' : 'weeks'} × ${h} hours`;
    totalValue.textContent = String(w * h);
  }
  weeks?.addEventListener('input', updatePlanner);
  hours?.addEventListener('input', updatePlanner);
  updatePlanner();
