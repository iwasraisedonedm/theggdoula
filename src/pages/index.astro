---
import PageLayout from '~/layouts/PageLayout.astro';
import Button from '~/components/ui/Button.astro';
import { featuredExperience } from '~/data/client-experiences';
import { services } from '~/data/services';
import { siteConfig } from '~/config/site';
import { getPermalink } from '~/utils/permalinks';

const metadata = {
  title: 'Grit + Grace Doula | Birth & Postpartum Support in Orange County',
  description:
    'Personal, nonmedical support for pregnancy, birth, postpartum, feeding education, and newborn care in Orange County. Start with a complimentary 30 minute consultation.',
  ignoreTitleTemplate: true,
  openGraph: { type: 'website' },
};

const bookingHref = getPermalink('/book');
const professionalServiceSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'Grit + Grace Doula',
  url: siteConfig.url,
  telephone: '+1-714-253-2915',
  email: 'theGGdoula@gmail.com',
  areaServed: { '@type': 'AdministrativeArea', name: 'Orange County, California' },
  description: metadata.description,
  founder: { '@type': 'Person', name: 'Teesee Logan' },
};

const consultationSteps = [
  {
    title: 'Choose a time',
    description: 'See current availability in your local time zone on the booking page.',
  },
  {
    title: 'Meet with Teesee',
    description: 'Connect by phone, FaceTime, or in person, as shown when you book.',
  },
  {
    title: 'Talk through what matters',
    description: 'Share your questions and the kind of support that would feel useful.',
  },
];

const faqs = [
  {
    question: 'What does a doula do?',
    answer:
      'A doula offers emotional, physical, and informational support through pregnancy, birth, and postpartum. Doula care is nonmedical and works alongside your clinical care team.',
  },
  {
    question: 'Is the first consultation free?',
    answer:
      'Yes. The initial consultation is complimentary and lasts 30 minutes. It is a chance to talk through your questions and the support you are looking for, with no obligation to book care.',
  },
  {
    question: 'Where does Grit + Grace Doula offer support?',
    answer:
      'Teesee serves Orange County and surrounding areas. The consultation can take place by phone, FaceTime, or in person.',
  },
  {
    question: 'Can I ask about just postpartum or newborn care?',
    answer:
      'Yes. You can ask about any area of support, including postpartum care, breastfeeding education, and newborn care. You do not need to be seeking birth support to start a conversation.',
  },
];
---

<PageLayout metadata={metadata}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(professionalServiceSchema)} />
  <section class="home-hero relative isolate overflow-hidden" aria-labelledby="home-title">
    <canvas class="home-thread-canvas" data-home-threads aria-hidden="true"></canvas>
    <div class="home-hero-inner gg-site-container relative z-10">
      <div class="home-hero-copy">
        <p class="home-eyebrow">
          <span aria-hidden="true"></span> Grit + Grace Doula · Orange County, California
        </p>
        <h1 id="home-title" class="home-display mt-6 max-w-3xl text-pretty">
          A steady presence
          <br />
          for the moments
          <br />
          that matter most.
        </h1>
        <p class="home-hero-lede mt-6 max-w-xl text-pretty">
          Personal support through pregnancy, birth, and the early days with your baby. Care shaped around your family,
          your questions, and what feels right to you.
        </p>
        <div class="mt-8 flex flex-col items-start gap-3 sm:flex-row sm:items-center">
          <Button variant="secondary" href={bookingHref} class="home-hero-cta">
            Book a free 30 minute consultation <span aria-hidden="true">↗</span>
          </Button>
          <a class="home-text-link" href={getPermalink('/services')}>
            Explore support
          </a>
        </div>
        <div class="home-proofline mt-9 flex flex-wrap gap-x-5 gap-y-2">
          <span>With Teesee Logan</span>
          <span>In person or virtual</span>
          <span>Nonmedical care</span>
        </div>
      </div>

      <figure class="home-portrait">
        <img
          src="/images/teesee-portrait.avif"
          srcset="/images/teesee-portrait-640.avif 640w, /images/teesee-portrait.avif 960w"
          sizes="(min-width: 1024px) 38vw, (min-width: 640px) 70vw, calc(100vw - 2rem)"
          alt="Teesee Logan, birth and postpartum doula"
          width="960"
          height="1440"
          fetchpriority="high"
          decoding="async"
        />
        <figcaption>
          <span>Teesee Logan</span>
          <span>Here to listen first</span>
        </figcaption>
      </figure>
    </div>
    <a href="#care" class="home-scroll-cue" aria-label="Explore care services">
      <span>Explore care</span>
      <span class="home-scroll-line" aria-hidden="true"></span>
    </a>
  </section>

  <section class="home-intro bg-page text-default" aria-labelledby="intro-title">
    <div class="gg-site-container home-intro-grid">
      <p class="gg-section-label">Care starts with you</p>
      <div>
        <h2 id="intro-title" class="home-editorial-title home-tagline" data-tagline-reveal>
          <span>Your</span> <span>story</span> <span>sets</span> <span>the</span> <span>pace.</span>
          <br />
          <span class="home-tagline-soft">Support</span> <span class="home-tagline-soft">meets</span>
          <span class="home-tagline-soft">you</span> <span class="home-tagline-soft">there.</span>
        </h2>
        <p class="mt-6 max-w-2xl text-lg leading-reading text-muted">
          There is no single right way to prepare for birth or settle into life with a new baby. A doula can offer a
          grounded, informed presence while you make the choices that are right for your family.
        </p>
      </div>
    </div>
  </section>

  <section id="care" class="home-care bg-surface-subtle text-default" aria-labelledby="care-title">
    <div class="gg-site-container py-16 sm:py-20 lg:py-24">
      <div class="home-section-heading">
        <div>
          <p class="gg-section-label">Ways we can support you</p>
          <h2 id="care-title" class="home-section-title mt-4">
            Care through each chapter.
          </h2>
        </div>
        <p class="max-w-md text-base leading-reading text-muted">
          Start with one kind of support or talk through how different services may fit together.
        </p>
      </div>

      <ol class="home-service-list">
        {services.map((service) => (
          <li>
            <a class="home-service-row" href={getPermalink(`/services/${service.slug}`)}>
              <span class="home-service-stage">{service.stage}</span>
              <span class="home-service-name">{service.name}</span>
              <span class="home-service-summary">{service.summary}</span>
              <span class="home-service-arrow" aria-hidden="true">
                ↗
              </span>
            </a>
          </li>
        ))}
      </ol>
      <a class="home-inline-link mt-7 inline-flex min-h-11 items-center gap-2" href={getPermalink('/services')}>
        See all support options <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>

  <section class="home-conversation bg-page text-default" aria-labelledby="conversation-title">
    <div class="gg-site-container home-conversation-grid">
      <div class="home-conversation-lead">
        <p class="gg-section-label">A comfortable place to begin</p>
        <h2 id="conversation-title" class="home-section-title mt-4">
          One conversation. Room for your questions.
        </h2>
        <p class="mt-5 max-w-md text-base leading-reading text-muted">
          A complimentary 30 minute consultation lets you meet Teesee, talk about what is on your mind, and ask about
          the kind of care you are considering. No pressure to decide on the spot.
        </p>
        <Button variant="primary" href={bookingHref} class="mt-7">
          Find a time to talk <span aria-hidden="true">↗</span>
        </Button>
      </div>

      <ol class="home-steps">
        {consultationSteps.map((step, index) => (
          <li>
            <span class="home-step-index" aria-hidden="true">
              {String(index + 1).padStart(2, '0')}
            </span>
            <div>
              <h3>{step.title}</h3>
              <p>{step.description}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="home-about bg-surface-botanical text-default" aria-labelledby="about-title">
    <div class="gg-site-container home-about-grid">
      <figure class="home-family-image">
        <div class="home-family-photo-pair">
          <img
            class="home-family-photo-main"
            src="/images/client-postpartum-family.avif"
            srcset="/images/client-postpartum-family-480.avif 480w, /images/client-postpartum-family.avif 1100w"
            sizes="(min-width: 1024px) 48vw, (min-width: 640px) 80vw, calc(100vw - 2rem)"
            alt="A parent holding their newborn during a quiet postpartum moment"
            width="1100"
            height="1320"
            loading="lazy"
            decoding="async"
          />
          <img
            class="home-family-photo-inset"
            src="/images/doula-newborn-support.avif"
            srcset="/images/doula-newborn-support-480.avif 480w, /images/doula-newborn-support.avif 1100w"
            sizes="(min-width: 1024px) 18vw, 30vw"
            alt="Teesee offering gentle newborn care at a family's home"
            width="1100"
            height="1467"
            loading="lazy"
            decoding="async"
          />
        </div>
        <figcaption>Care that makes room for your own strength.</figcaption>
      </figure>
      <div class="home-about-copy">
        <p class="gg-section-label">The person behind your care</p>
        <h2 id="about-title" class="home-editorial-title mt-4">
          Meet Teesee Logan.
        </h2>
        <p class="mt-6 text-base leading-reading text-muted">
          Teesee Logan offers birth and postpartum doula care, newborn support, and breastfeeding education. Her role is
          to listen, share information, and support your choices alongside your clinical care team.
        </p>
        <a class="home-inline-link mt-6 inline-flex min-h-11 items-center gap-2" href={getPermalink('/about')}>
          Get to know Teesee <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <section class="home-testimonial bg-page text-default" aria-labelledby="family-words-title">
    <div class="gg-site-container home-testimonial-inner">
      <p class="gg-section-label">Shared with permission</p>
      <h2 id="family-words-title" class="sr-only">
        A family’s experience
      </h2>
      <figure class="mt-6">
        <blockquote class="home-quote">{featuredExperience.quote}</blockquote>
        <figcaption class="mt-6 flex flex-wrap items-center justify-between gap-4 border-t border-border pt-5">
          <span class="text-base font-medium text-heading">
            {featuredExperience.attribution} <span class="font-normal text-muted">· {featuredExperience.careType}</span>
          </span>
          <a class="home-inline-link inline-flex min-h-11 items-center gap-2" href={getPermalink('/testimonials')}>
            Read more family experiences <span aria-hidden="true">→</span>
          </a>
        </figcaption>
      </figure>
      <p class="mt-4 max-w-reading text-sm leading-reading text-muted">
        Every family’s needs and experience are different. These words describe one family’s experience, not a promised
        outcome.
      </p>
    </div>
  </section>

  <section id="common-questions" class="home-faq bg-surface-subtle text-default" aria-labelledby="faq-title">
    <div class="gg-site-container home-faq-grid">
      <div>
        <p class="gg-section-label">A few helpful details</p>
        <h2 id="faq-title" class="home-section-title mt-4">
          Questions, answered.
        </h2>
        <p class="mt-4 max-w-sm text-base leading-reading text-muted">
          Want to talk through something specific? Bring it to your free first consultation.
        </p>
        <a class="home-inline-link mt-5 inline-flex min-h-11 items-center gap-2" href={bookingHref}>
          Book a consultation <span aria-hidden="true">→</span>
        </a>
      </div>
      <div class="home-faq-list">
        {faqs.map((faq) => (
          <details>
            <summary>
              {faq.question}
              <span aria-hidden="true">+</span>
            </summary>
            <p>{faq.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="home-final-cta" aria-labelledby="final-cta-title">
    <div class="gg-site-container home-final-cta-inner">
      <p class="home-eyebrow">
        <span aria-hidden="true"></span> Pregnancy · birth · postpartum
      </p>
      <h2 id="final-cta-title" class="home-display mt-5 max-w-3xl">
        Let’s start with what matters to you.
      </h2>
      <p class="mt-5 max-w-xl text-lg leading-reading">
        There is room for your questions, your preferences, and your own way of doing things.
      </p>
      <Button variant="secondary" href={bookingHref} class="home-hero-cta mt-8">
        Book a free 30 minute consultation <span aria-hidden="true">↗</span>
      </Button>
      <p class="mt-5 text-sm">Orange County and surrounding areas · Phone, FaceTime, or in person</p>
    </div>
  </section>
</PageLayout>

<script>
  import { gsap } from 'gsap';

  let stopThreads: (() => void) | undefined;
  let stopTaglineReveal: (() => void) | undefined;

  function startThreads() {
    stopThreads?.();
    stopThreads = undefined;

    const canvas = document.querySelector<HTMLCanvasElement>('[data-home-threads]');
    const context = canvas?.getContext('2d');
    if (!canvas || !context) return;
    const threadCanvas = canvas;
    const threadContext = context;

    const media = window.matchMedia('(prefers-reduced-motion: reduce)');
    const firstSequence = 'teesee | the gg doula';
    const secondSequence = 'the gg doula | teesee';
    let width = 0;
    let height = 0;
    let ratio = 1;
    let inView = true;

    function draw(time = 0) {
      const rect = threadCanvas.getBoundingClientRect();
      if (!rect.width || !rect.height) return;
      width = rect.width;
      height = rect.height;
      ratio = Math.min(window.devicePixelRatio || 1, 2);
      if (threadCanvas.width !== Math.round(width * ratio) || threadCanvas.height !== Math.round(height * ratio)) {
        threadCanvas.width = Math.round(width * ratio);
        threadCanvas.height = Math.round(height * ratio);
      }
      threadContext.setTransform(ratio, 0, 0, ratio, 0, 0);
      threadContext.clearRect(0, 0, width, height);

      const spacing = Math.min(30, width / firstSequence.length);
      const copies = Math.ceil(width / (spacing * firstSequence.length));
      const count = copies * firstSequence.length;
      const step = width / count;
      const amplitude = height * 0.25;
      const center = height / 2;
      const phase = media.matches ? 0 : time * 0.24;
      const points: Array<{ x: number; y1: number; y2: number; depth: number }> = [];

      for (let index = 0; index < count; index += 1) {
        const angle = index * 0.2 - phase;
        points.push({
          x: (index + 0.5) * step,
          y1: center + Math.sin(angle) * amplitude,
          y2: center + Math.sin(angle + Math.PI) * amplitude,
          depth: (Math.cos(angle) + 1) / 2,
        });
      }

      threadContext.lineWidth = 1;
      threadContext.strokeStyle = '#ffffff';
      threadContext.fillStyle = '#ffffff';
      threadContext.font = `500 ${Math.max(9, Math.min(14, width / 100))}px ui-monospace, monospace`;
      threadContext.textAlign = 'center';
      threadContext.textBaseline = 'middle';
      for (const [index, point] of points.entries()) {
        const front = 0.2 + point.depth * 0.8;
        threadContext.globalAlpha = Math.min(front, 1 - point.depth + 0.2) * 0.22;
        threadContext.beginPath();
        threadContext.moveTo(point.x, point.y1);
        threadContext.lineTo(point.x, point.y2);
        threadContext.stroke();
        threadContext.globalAlpha = 0.18 + point.depth * 0.82;
        threadContext.fillText(firstSequence[index % firstSequence.length], point.x, point.y1);
        threadContext.globalAlpha = 0.18 + (1 - point.depth) * 0.82;
        threadContext.fillText(secondSequence[index % secondSequence.length], point.x, point.y2);
      }
      threadContext.globalAlpha = 1;
    }

    function updateTicker() {
      gsap.ticker.remove(draw);
      draw(0);
      if (inView && !media.matches) gsap.ticker.add(draw);
    }

    const resizeObserver = new ResizeObserver(() => draw(0));
    resizeObserver.observe(threadCanvas);
    const visibilityObserver = new IntersectionObserver(([entry]) => {
      inView = entry.isIntersecting;
      updateTicker();
    });
    visibilityObserver.observe(threadCanvas);
    media.addEventListener('change', updateTicker);
    updateTicker();

    stopThreads = () => {
      gsap.ticker.remove(draw);
      resizeObserver.disconnect();
      visibilityObserver.disconnect();
      media.removeEventListener('change', updateTicker);
    };
  }

  function startTaglineReveal() {
    stopTaglineReveal?.();
    const tagline = document.querySelector<HTMLElement>('[data-tagline-reveal]');
    if (!tagline) return;
    const words = [...tagline.querySelectorAll<HTMLElement>('span')];
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const reveal = () => {
      words.forEach((word, index) => {
        gsap.to(word, {
          color: getComputedStyle(tagline).color,
          delay: index * 0.045,
          duration: 0.42,
          ease: 'power2.out',
        });
      });
    };
    if (reducedMotion.matches) return;
    words.forEach((word) => {
      word.style.color = 'var(--gg-color-text-muted)';
    });
    const observer = new IntersectionObserver(
      ([entry]) => {
        if (!entry.isIntersecting) return;
        reveal();
        observer.disconnect();
      },
      { threshold: 0.35 }
    );
    observer.observe(tagline);
    stopTaglineReveal = () => {
      observer.disconnect();
      gsap.killTweensOf(words);
    };
  }

  document.addEventListener('astro:page-load', startThreads);
  document.addEventListener('astro:page-load', startTaglineReveal);
  document.addEventListener('astro:before-swap', () => {
    stopThreads?.();
    stopTaglineReveal?.();
  });
  startThreads();
  startTaglineReveal();
</script>

<style>
  :global(html:has(.home-hero)) {
    scroll-behavior: auto;
  }

  .home-hero,
  .home-final-cta {
    --hero-surface: var(--gg-color-hero-surface);
    --hero-ink: var(--gg-color-hero-text);
    background: var(--hero-surface);
    color: var(--hero-ink);
  }

  .home-hero {
    min-height: min(58rem, max(43rem, calc(100svh - 4rem)));
    display: grid;
    align-items: center;
    isolation: isolate;
  }

  .home-thread-canvas {
    position: absolute;
    z-index: -1;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0.24;
    pointer-events: none;
  }

  .home-hero-inner {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(17rem, 0.72fr);
    align-items: center;
    gap: clamp(2.5rem, 7vw, 7rem);
    padding-top: clamp(3.5rem, 8vh, 6.5rem);
    padding-bottom: clamp(4.5rem, 10vh, 8rem);
  }

  .home-hero-copy {
    max-width: 47rem;
  }

  .home-eyebrow {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    font-size: 0.8125rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .home-eyebrow > span:first-child {
    width: 0.45rem;
    height: 0.45rem;
    flex: 0 0 auto;
    border-radius: 50%;
    background: currentColor;
    opacity: 0.75;
  }

  .home-display,
  .home-editorial-title,
  .home-quote {
    font-family: var(--gg-type-font-display);
    font-weight: 400;
    letter-spacing: -0.04em;
  }

  .home-display {
    font-size: clamp(3.25rem, 4.8vw, 5.25rem);
    line-height: 0.98;
  }

  .home-hero-lede {
    font-size: clamp(1.0625rem, 1.5vw, 1.25rem);
    line-height: 1.65;
  }

  .home-hero-cta {
    min-height: 3.25rem;
    background: var(--hero-ink);
    color: var(--hero-surface);
    border: 1px solid var(--hero-ink);
    transition:
      transform 220ms cubic-bezier(0.2, 0, 0, 1),
      background-color 180ms ease,
      color 180ms ease;
  }

  .home-hero-cta:hover {
    transform: translateY(-3px);
    background: transparent;
    color: var(--hero-ink);
  }

  .home-hero-cta:active {
    transform: translateY(0) scale(0.98);
  }

  .home-text-link {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    text-underline-offset: 0.25em;
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, currentColor 55%, transparent);
    transition: transform 180ms ease;
  }

  .home-text-link:hover {
    transform: translateX(0.2rem);
  }

  .home-proofline {
    font-size: 0.8125rem;
    line-height: 1.5;
    opacity: 0.84;
  }

  .home-proofline span + span::before {
    content: '·';
    margin-right: 1.25rem;
  }

  .home-portrait {
    width: min(100%, 28rem);
    justify-self: end;
  }

  .home-portrait img {
    display: block;
    width: 100%;
    aspect-ratio: 0.79;
    object-fit: cover;
    object-position: center 34%;
    filter: grayscale(1);
  }

  .home-portrait figcaption {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    border-bottom: 1px solid color-mix(in srgb, var(--hero-ink) 40%, transparent);
    padding-top: 0.7rem;
    padding-bottom: 0.7rem;
    font-size: 0.75rem;
    letter-spacing: 0.04em;
  }

  .home-scroll-cue {
    position: absolute;
    z-index: 20;
    right: max(calc((100vw - 72rem) / 2), 1rem);
    bottom: 1.75rem;
    display: flex;
    min-height: 2.75rem;
    align-items: center;
    gap: 0.85rem;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .home-scroll-line {
    width: 3rem;
    height: 1px;
    background: currentColor;
    transform-origin: left;
    transition: transform 220ms ease;
  }

  .home-scroll-cue:hover .home-scroll-line {
    transform: scaleX(1.4);
  }

  .home-conversation :global(a.btn-primary) {
    transition: transform 180ms cubic-bezier(0.2, 0, 0, 1);
  }

  .home-conversation :global(a.btn-primary:hover) {
    transform: translateY(-3px);
  }

  .home-conversation :global(a.btn-primary:active) {
    transform: translateY(0) scale(0.98);
  }

  .home-intro-grid {
    display: grid;
    grid-template-columns: minmax(10rem, 0.55fr) minmax(0, 1.45fr);
    gap: clamp(2rem, 6vw, 6rem);
    padding-top: clamp(5rem, 10vw, 9rem);
    padding-bottom: clamp(5rem, 10vw, 9rem);
  }

  .home-editorial-title {
    max-width: 18ch;
    font-size: clamp(2.5rem, 5.3vw, 5rem);
    line-height: 1.04;
    color: var(--gg-color-text-heading);
  }

  .home-editorial-title span {
    color: var(--gg-color-text-muted);
  }

  .home-tagline > span {
    color: var(--gg-color-text-heading);
  }

  .home-tagline > .home-tagline-soft {
    color: var(--gg-color-text-heading);
  }

  .home-section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: 3rem;
  }

  .home-section-title {
    max-width: 16ch;
