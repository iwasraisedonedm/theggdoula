---
import ServiceDetail from '~/components/services/ServiceDetail.astro';
import PrenatalDetail from '~/components/services/PrenatalDetail.astro';
import { services } from '~/data/services';

export function getStaticPaths() {
  return services.map((service) => ({
    params: { service: service.slug },
    props: { service },
  }));
}

const { service } = Astro.props;
---

{service.slug === 'prenatal' ? <PrenatalDetail /> : <ServiceDetail service={service} />}
