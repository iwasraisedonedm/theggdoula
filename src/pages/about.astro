---
import Layout from '~/layouts/PageLayout.astro';
import Button from '~/components/ui/Button.astro';

const metadata = {
  title: 'About Teesee Logan',
  description:
    'Meet Teesee Logan, a birth and postpartum doula, newborn care specialist, and breastfeeding educator serving Orange County and surrounding areas.',
};

const supportAreas = [
  {
    slug: 'prenatal',
    title: 'Prenatal support',
    description:
      'Prenatal planning sessions create space to talk through your preferences, questions, concerns, and the support that would feel useful to you.',
  },
  {
    slug: 'birth',
    title: 'Labor and birth support',
    description:
      'Birth doula care offers continuous emotional, physical, and informational support through labor and birth, wherever you plan to give birth.',
  },
  {
    slug: 'postpartum',
    title: 'Postpartum care',
    description:
      'Postpartum support is centered on caring for the parent while helping the family settle into life with a new baby.',
  },
  {
    slug: 'breastfeeding',
    title: 'Breastfeeding education',
    description:
      'Teesee describes her role as a breastfeeding educator, offering practical support as families learn about nursing, pumping, and bottle feeding.',
  },
  {
    slug: 'newborn-care',
    title: 'Newborn care',
    description:
      'Newborn care support helps parents learn everyday infant care and find a rhythm during the first months at home.',
  },
];

const trainingAndExperience = [
  {
    title: 'DASC member',
    description: 'A professional community for doulas serving Southern California.',
  },
  {
    title: 'DONA training',
    description: 'Birth-doula certification and postpartum doula training inform the support offered to families.',
  },
  {
    title: 'Newborn care specialist',
    description: 'In-home newborn care support and parent education for the early weeks.',
  },
  {
    title: 'Breastfeeding educator',
    description: 'Practical education around feeding, positions, latch, and pumping.',
  },
  {
    title: 'Fitness background',
    description: 'More than a decade of personal-training experience working primarily with women.',
  },
  {
    title: 'Postpartum nutrition',
    description: 'Practical nutrition support as part of postpartum wellness services.',
  },
];
---

<Layout metadata={metadata}>
  <div class="about-page bg-page text-default">
    <section aria-labelledby="about-title" class="relative isolate overflow-hidden border-b border-border bg-page">
      <div class="relative mx-auto grid max-w-6xl items-center gap-10 px-4 py-14 sm:px-6 sm:py-20 md:grid-cols-[minmax(0,0.95fr)_minmax(18rem,0.8fr)] lg:gap-16 lg:px-8 lg:py-24">
        <div class="border-l border-border pl-6 sm:pl-8 md:pl-10">
          <p class="gg-section-label">The person behind the care</p>
          <h1 id="about-title" class="mt-4 max-w-2xl gg-type-page-title">
            Meet Teesee Logan.
          </h1>
          <p class="mt-6 max-w-xl text-lg leading-reading text-default sm:text-xl">
            A steady, personal source of support for pregnancy, birth, and the months that follow.
          </p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center">
            <Button variant="primary" href="/book/">
              Ask about a free 30-minute consultation
            </Button>
            <a class="gg-link text-base" href="#story">
              Get to know me
            </a>
          </div>
          <div class="mt-10 flex flex-wrap gap-x-6 gap-y-2 border-t border-border pt-5 text-sm text-muted">
            <span>Orange County and surrounding areas</span>
            <span>Non-medical support</span>
          </div>
        </div>

        <figure class="relative mx-auto w-full max-w-md md:mx-0 md:ml-auto">
          <div class="overflow-hidden border border-border bg-surface">
            <img
              src="/images/teesee-portrait.avif"
              srcset="/images/teesee-portrait-640.avif 640w, /images/teesee-portrait.avif 960w"
              sizes="(min-width: 768px) 38vw, calc(100vw - 2rem)"
              alt="Teesee Logan, Grit + Grace Doula"
              width="960"
              height="1440"
              fetchpriority="high"
              decoding="async"
            />
          </div>
          <figcaption class="mt-3 flex justify-between gap-4 text-sm text-muted">
            <span>Teesee Logan</span>
            <span>Grit + Grace Doula</span>
          </figcaption>
        </figure>
      </div>
    </section>

    <nav aria-label="On this page" class="border-b border-border bg-surface">
      <div class="mx-auto flex max-w-6xl flex-wrap items-center gap-x-6 gap-y-3 px-4 py-5 sm:px-6 lg:px-8">
        <span class="gg-section-label">A closer look</span>
        <a class="gg-link text-base" href="#story">
          My story
        </a>
        <a class="gg-link text-base" href="#approach">
          My approach
        </a>
        <a class="gg-link text-base" href="#training">
          Training and experience
        </a>
        <a class="gg-link text-base" href="#services">
          Areas of support
        </a>
      </div>
    </nav>

    <section id="story" aria-labelledby="story-title" class="scroll-mt-20 border-b border-border bg-surface-subtle">
      <div class="mx-auto grid max-w-6xl items-center gap-10 px-4 py-14 sm:px-6 sm:py-20 md:grid-cols-[minmax(16rem,0.9fr)_minmax(0,1.1fr)] lg:gap-16 lg:px-8 lg:py-24">
        <figure class="relative order-2 md:order-1">
          <div class="overflow-hidden border border-border bg-surface">
            <img
              src="/images/teesee-family-support.avif"
              srcset="/images/teesee-family-support-480.avif 480w, /images/teesee-family-support.avif 960w"
              sizes="(min-width: 768px) 42vw, calc(100vw - 2rem)"
              alt="Teesee Logan supports a laboring parent with their partner nearby."
              width="960"
              height="1231"
              loading="lazy"
              decoding="async"
            />
          </div>
          <figcaption class="mt-3 text-sm text-muted">
            Care that makes room for each family’s voice and values.
          </figcaption>
        </figure>

        <div class="order-1 md:order-2">
          <p class="gg-section-label">The relationship</p>
          <h2 id="story-title" class="gg-type-section-title mt-3 max-w-2xl text-heading">
            Support for pregnancy, birth, and the months that follow.
          </h2>
          <div class="mt-6 max-w-reading space-y-5 text-base leading-reading text-default">
            <p>
              I am a birth and postpartum doula serving Orange County and surrounding areas. I am also a newborn care
              specialist and breastfeeding educator. I typically work with families from pregnancy through birth and on
              through their baby’s first year.
            </p>
            <p>
              I’m a mother of four adult children and grandmother to two. The seasons of family life have shaped my
              respect for each household’s rhythms, values, and way of welcoming a new baby. Having experienced four
              different births with my own children, I understand the importance a supportive team can have during this
              life-changing time.
            </p>
          </div>
          <!-- CONTENT GAP: Add Teesee's own approved account of what led her to doula work. The source describes her family experience, but not a specific origin story. -->
        </div>
      </div>
    </section>

    <section id="approach" aria-labelledby="approach-title" class="scroll-mt-20 border-b border-border bg-page">
      <div class="mx-auto grid max-w-6xl gap-8 px-4 py-14 sm:px-6 sm:py-20 md:grid-cols-[minmax(14rem,0.65fr)_minmax(0,1.35fr)] lg:gap-16 lg:px-8 lg:py-24">
        <div>
          <p class="gg-section-label">Care, in practice</p>
          <h2 id="approach-title" class="gg-type-section-title mt-3 text-heading">
            Listening with compassion. Making space for your choices.
          </h2>
        </div>
        <div class="max-w-3xl">
          <blockquote class="border-l-2 border-brand pl-5 font-heading text-2xl font-medium leading-snug tracking-heading text-heading sm:pl-7 sm:text-3xl">
            “I listen with compassion and serve with my hands and my heart.”
          </blockquote>
          <div class="mt-7 space-y-5 text-base leading-reading text-default">
            <p>
              I’ll help you gather knowledge and encourage you while reminding you of your goals and values. I am an
              educator, but you are the parent and the expert on you. I trust you to make the best decisions for you and
              your baby, and I will honor your choices.
            </p>
            <p>
              My role is to provide continuous physical and emotional support, whatever decisions you make about your
              birth. I share information, encourage you, and help you and your partner feel cared for through labor and
              birth. Each birth is unique; your care should make room for your voice, values, and needs.
            </p>
            <p>
              After birth, postpartum care is centered on caring for the parent while also assisting with newborn care
              and everyday questions.
            </p>
          </div>
          <!-- CONTENT GAP: The source does not document an evidence-informed practice statement or supporting references. Confirm approved wording before making that claim. -->
        </div>
      </div>
    </section>

    <section
      id="training"
      aria-labelledby="training-title"
      class="scroll-mt-20 border-b border-border bg-surface-subtle"
    >
      <div class="mx-auto grid max-w-6xl gap-8 px-4 py-14 sm:px-6 sm:py-20 md:grid-cols-[minmax(14rem,0.65fr)_minmax(0,1.35fr)] lg:gap-16 lg:px-8 lg:py-24">
        <div>
          <p class="gg-section-label">What informs the work</p>
          <h2 id="training-title" class="gg-type-section-title mt-3 text-heading">
            Training and experience.
          </h2>
          <p class="mt-5 max-w-reading text-base leading-reading text-muted">
            Teesee’s background includes doula training, newborn-care and feeding education, and experience supporting
            women through personal training.
          </p>
        </div>
        <dl class="divide-y divide-border border-y border-border">
          {trainingAndExperience.map((item) => (
            <div class="grid gap-2 py-5 sm:grid-cols-[minmax(12rem,0.7fr)_minmax(0,1fr)] sm:gap-8">
              <dt class="font-heading text-lg font-medium text-heading">{item.title}</dt>
              <dd class="text-base leading-reading text-muted">{item.description}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <section id="services" aria-labelledby="services-title" class="scroll-mt-20 border-b border-border bg-page">
      <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 sm:py-20 lg:px-8 lg:py-24">
        <div class="grid gap-6 border-b border-border pb-7 md:grid-cols-[minmax(14rem,0.65fr)_minmax(0,1.35fr)] md:items-end lg:gap-16">
          <div>
            <p class="gg-section-label">Areas of support</p>
            <h2 id="services-title" class="gg-type-section-title mt-3 text-heading">
              From preparation through the early days at home.
            </h2>
          </div>
          <p class="max-w-reading text-base leading-reading text-muted">
            Explore the kinds of support Teesee offers and learn more about each service.
          </p>
        </div>
        <ul class="divide-y divide-border">
          {supportAreas.map((service) => (
            <li class="grid gap-3 py-6 sm:grid-cols-[minmax(12rem,0.65fr)_minmax(0,1fr)_auto] sm:items-center sm:gap-8">
              <h3 class="gg-type-card-title text-heading">{service.title}</h3>
              <p class="max-w-reading text-base leading-reading text-muted">{service.description}</p>
              <a
                class="gg-link inline-flex items-center gap-2 text-base font-medium"
                href={`/services/${service.slug}/`}
              >
                Explore service <span aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section aria-labelledby="working-title" class="border-b border-border bg-surface-subtle">
      <div class="mx-auto grid max-w-6xl gap-8 px-4 py-14 sm:px-6 sm:py-20 md:grid-cols-[minmax(14rem,0.65fr)_minmax(0,1.35fr)] lg:gap-16 lg:px-8 lg:py-24">
        <div>
          <p class="gg-section-label">What working together feels like</p>
          <h2 id="working-title" class="gg-type-section-title mt-3 text-heading">
            Support that respects your choices.
          </h2>
        </div>
        <div class="max-w-reading space-y-5 text-base leading-reading text-default">
          <p>
            I’ll help you gather knowledge and encourage you while reminding you of your goals and values. I am an
            educator, but you are the parent and the expert on you. I trust you to make the best decisions for you and
            your baby, and I will honor your choices.
          </p>
          <p>
            My role is to provide continuous physical and emotional support, whatever decisions you make about your
            birth. I share information, encourage you, and help you and your partner feel cared for through labor and
            birth. Each birth is unique; your care should make room for your voice, values, and needs.
          </p>
          <p>
            After birth, postpartum care is centered on caring for the parent while also assisting with newborn care and
            everyday questions.
          </p>
          <p>
            Doula care is non-medical support. Teesee does not diagnose or treat medical conditions and does not replace
            your clinical care team.
          </p>
          <a class="gg-link inline-flex text-base" href="/services/">
            Explore doula services <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </section>

    <section aria-labelledby="about-next-step" class="bg-brand text-on-brand">
      <div class="mx-auto grid max-w-6xl gap-7 px-4 py-14 sm:px-6 sm:py-20 md:grid-cols-[minmax(0,1fr)_auto] md:items-center lg:px-8 lg:py-24">
        <div>
          <p class="font-mono text-xs uppercase tracking-widest opacity-85">A personal invitation</p>
          <h2 id="about-next-step" class="gg-type-section-title mt-3 max-w-3xl text-on-brand">
            Let’s talk about the care that would feel supportive to you.
          </h2>
          <p class="mt-4 max-w-reading text-base leading-reading opacity-90">
            A free 30-minute conversation is a comfortable place to begin.
          </p>
        </div>
        <Button variant="secondary" href="/book/" class="border-on-brand text-on-brand hover:bg-on-brand/10">
          Ask about a free consultation
        </Button>
      </div>
    </section>
  </div>
</Layout>
