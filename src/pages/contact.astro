---
import { Icon } from 'astro-icon/components';
import Layout from '~/layouts/PageLayout.astro';
import FormContainer from '~/components/ui/Form.astro';
import { CONTACT } from '~/data/contact';

const metadata = {
  title: 'Contact',
  description:
    'Contact Grit + Grace Doula for prenatal, birth, postpartum, breastfeeding, and newborn-care support in Orange County and surrounding areas.',
};
---

<Layout metadata={metadata}>
  <div class="contact-page relative isolate overflow-hidden bg-page text-default">
    <div class="contact-wash pointer-events-none absolute inset-0" aria-hidden="true"></div>
    <div class="contact-grid pointer-events-none absolute inset-0" aria-hidden="true"></div>

    <section class="contact-band relative z-10">
      <div class="contact-layout mx-auto grid max-w-6xl grid-cols-1 gap-12 px-6 py-14 sm:py-16 md:py-20 lg:grid-cols-[1fr_0.92fr] lg:items-stretch lg:gap-16 lg:px-8 lg:py-24">
        <div class="contact-intro flex min-w-0 flex-col">
          <div>
            <p class="contact-eyebrow">
              <span aria-hidden="true"></span>Contact
            </p>
            <h1 class="gg-type-page-title mt-7">
              Let’s talk about
              <br class="hidden lg:block" /> your journey.
            </h1>
            <p class="contact-lede mt-6">
              Whether you’re preparing for birth, exploring postpartum or newborn support, or have questions about
              feeding, I’d love to hear from you.
            </p>

            <div class="contact-divider mt-9" aria-hidden="true"></div>

            <dl class="contact-details mt-7">
              <div class="contact-detail">
                <dt class="sr-only">Email</dt>
                <dd>
                  <span class="contact-icon" aria-hidden="true">
                    <Icon name="tabler:mail" />
                  </span>
                  <span class="contact-detail-copy">
                    <span class="contact-label">Email</span>
                    <a class="contact-value" href={CONTACT.emailHref}>
                      {CONTACT.email}
                    </a>
                  </span>
                </dd>
              </div>
              <div class="contact-detail">
                <dt class="sr-only">Phone</dt>
                <dd>
                  <span class="contact-icon" aria-hidden="true">
                    <Icon name="tabler:phone" />
                  </span>
                  <span class="contact-detail-copy">
                    <span class="contact-label">Phone</span>
                    <a class="contact-value" href={CONTACT.phoneHref}>
                      {CONTACT.phone}
                    </a>
                  </span>
                </dd>
              </div>
              <div class="contact-detail">
                <dt class="sr-only">Service area</dt>
                <dd>
                  <span class="contact-icon" aria-hidden="true">
                    <Icon name="tabler:map-pin" />
                  </span>
                  <span class="contact-detail-copy">
                    <span class="contact-label">Service area</span>
                    <span class="contact-value">{CONTACT.serviceArea}</span>
                  </span>
                </dd>
              </div>
              <div class="contact-detail">
                <dt class="sr-only">Initial consultation</dt>
                <dd>
                  <span class="contact-icon" aria-hidden="true">
                    <Icon name="tabler:calendar" />
                  </span>
                  <span class="contact-detail-copy">
                    <span class="contact-label">Initial consultation</span>
                    <span class="contact-value">{CONTACT.consultation}</span>
                    <span class="contact-support">
                      {CONTACT.consultationDetails} <a href="/book/">Choose a time</a>
                    </span>
                  </span>
                </dd>
              </div>
            </dl>
          </div>

          <div class="contact-reassurance">
            <div class="contact-divider" aria-hidden="true"></div>
            <p>Compassionate support for pregnancy, birth, and the days that follow.</p>
          </div>
        </div>

        <section class="contact-form-card" aria-labelledby="contact-form-title">
          <div class="contact-form-heading">
            <h2 id="contact-form-title" class="gg-type-card-title">
              Send a message
            </h2>
            <p>A simple first step</p>
          </div>
          <p id="form-required-note" class="sr-only">
            All fields are required.
          </p>
          <FormContainer
            id="contact-inquiry-form"
            action="https://formspree.io/f/mzeeebev"
            method="post"
            honeypot={true}
            inputs={[
              {
                type: 'text',
                name: 'name',
                label: 'Your name',
                autocomplete: 'name',
                placeholder: 'Your name',
                required: true,
                classes: 'form-input',
              },
              {
                type: 'email',
                name: 'email',
                label: 'Email address',
                autocomplete: 'email',
                placeholder: 'you@example.com',
                required: true,
                classes: 'form-input',
              },
            ]}
            textarea={{
              label: 'Your message',
              name: 'message',
              rows: 5,
              placeholder: 'Tell me a little about what support you’re looking for.',
              required: true,
              classes: 'form-textarea',
            }}
            button="Send message"
            buttonIcon="tabler:send"
            description="Please don’t include sensitive medical or health information."
          />
          <p class="contact-privacy">
            <Icon name="tabler:lock" aria-hidden="true" />
            <span>
              Your message is sent to Grit + Grace Doula through Formspree. <a href="/privacy/">Privacy policy</a>
            </span>
          </p>
        </section>
      </div>
    </section>
  </div>
</Layout>

<style>
  .contact-page {
    --contact-ink: var(--aw-color-text-heading);
    --contact-body: var(--aw-color-text-default);
    --contact-muted: var(--aw-color-text-muted);
    --contact-border: var(--gg-color-border);
    --contact-paper: var(--aw-color-bg-page);
    --contact-paper-2: var(--gg-color-surface-subtle);
    --contact-surface: var(--gg-color-surface);
    --contact-primary: var(--aw-color-primary);
    --contact-primary-hover: var(--aw-color-secondary);
    background: var(--contact-paper);
    color: var(--contact-body);
  }

  .contact-wash {
    background: none;
  }

  .contact-grid {
    display: none;
  }

  .contact-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    border: 1px solid var(--contact-border);
    border-radius: 0;
    background: color-mix(in srgb, var(--contact-surface) 74%, transparent);
    padding: 7px 12px;
    color: var(--contact-ink);
    font-size: var(--gg-type-label-size);
    font-weight: var(--gg-type-weight-strong);
    letter-spacing: var(--gg-type-label-tracking);
    line-height: var(--gg-type-label-leading);
    text-transform: uppercase;
  }

  .contact-eyebrow span {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--contact-primary);
  }

  .contact-lede {
    max-width: 440px;
    color: var(--contact-muted);
    font-size: var(--gg-type-body-large-size);
    line-height: var(--gg-type-body-leading);
  }

  .contact-divider {
    width: min(100%, 440px);
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--contact-border) 20%, var(--contact-border) 80%, transparent);
  }

  .contact-details {
    display: grid;
    gap: 17px;
    max-width: 470px;
  }

  .contact-detail {
    display: flex;
    min-width: 0;
    align-items: center;
    gap: 14px;
  }

  .contact-icon {
    display: grid;
    width: 36px;
    height: 36px;
    flex: 0 0 36px;
    place-items: center;
    border: 1px solid var(--contact-border);
    border-radius: 0;
    background: color-mix(in srgb, var(--contact-surface) 72%, transparent);
    color: var(--contact-primary);
  }

  .contact-icon :global(svg) {
    width: 18px;
    height: 18px;
    stroke-width: 1.7;
  }

  .contact-detail dd {
    display: grid;
    grid-template-columns: 36px minmax(0, 1fr);
    min-width: 0;
    align-items: center;
    gap: 14px;
  }

  .contact-detail-copy {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 2px;
  }

  .contact-label {
    color: var(--contact-muted);
    font-size: var(--gg-type-label-size);
    font-weight: var(--gg-type-weight-strong);
    letter-spacing: var(--gg-type-label-tracking);
    line-height: var(--gg-type-label-leading);
    text-transform: uppercase;
  }

  .contact-value {
    color: var(--contact-ink);
    font-size: var(--gg-type-body-size);
    font-weight: var(--gg-type-weight-heading);
    line-height: var(--gg-type-body-leading);
    overflow-wrap: anywhere;
  }

  a.contact-value,
  .contact-support a,
  .contact-privacy a {
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--contact-primary) 35%, transparent);
    text-underline-offset: 3px;
    transition:
      color 180ms ease,
      text-decoration-color 180ms ease;
  }

  a.contact-value:hover,
  .contact-support a:hover,
  .contact-privacy a:hover {
    color: var(--contact-primary-hover);
    text-decoration-color: currentColor;
  }

  .contact-page a:focus-visible {
    border-radius: 0;
    outline: 2px solid var(--gg-color-focus);
    outline-offset: 3px;
  }

  .contact-support {
    color: var(--contact-muted);
    font-size: var(--gg-type-body-small-size);
    line-height: var(--gg-type-body-small-leading);
  }

  .contact-support a {
    color: var(--contact-primary);
  }

  .contact-reassurance {
    margin-top: auto;
    padding-top: 44px;
  }

  .contact-reassurance p {
    padding-top: 15px;
    color: var(--contact-muted);
    font-size: var(--gg-type-body-small-size);
    line-height: var(--gg-type-body-small-leading);
  }

  .contact-form-card {
    align-self: center;
    border: 1px solid color-mix(in srgb, var(--contact-border) 86%, transparent);
    border-radius: 0;
    background: color-mix(in srgb, var(--contact-surface) 88%, transparent);
    padding: 26px 22px;
    box-shadow:
      0 24px 60px -32px rgba(38, 53, 45, 0.2),
      inset 0 1px 0 rgba(255, 255, 255, 0.78);
    backdrop-filter: blur(10px);
  }

  .contact-form-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 24px;
  }

  .contact-form-heading h2 {
    color: var(--contact-ink);
    font-size: var(--gg-type-card-title-size);
    font-weight: var(--gg-type-weight-heading);
    letter-spacing: var(--gg-type-tight-tracking);
    line-height: var(--gg-type-card-title-leading);
  }

  .contact-form-heading p {
    color: var(--contact-muted);
    font-size: var(--gg-type-body-small-size);
  }

  .contact-form-card :global(form > div:not([hidden])) {
    margin-bottom: 17px;
  }

  .contact-form-card :global(form label) {
    margin-bottom: 7px;
    color: var(--contact-ink);
    font-size: var(--gg-type-body-size);
    font-weight: var(--gg-type-weight-heading);
  }

  .contact-form-card :global(form .gg-field) {
    min-height: 48px;
    border: 1px solid var(--contact-border);
    border-radius: 0;
    background: var(--contact-surface);
    padding: 11px 15px;
    color: var(--contact-body);
    font-size: var(--gg-type-body-size);
    line-height: var(--gg-type-body-leading);
    transition:
      border-color 180ms ease,
      box-shadow 180ms ease;
  }

  .contact-form-card :global(form textarea.gg-field) {
    min-height: 134px;
    resize: vertical;
  }

  .contact-form-card :global(form .gg-field::placeholder) {
    color: var(--contact-muted);
    opacity: 1;
  }

  .contact-form-card :global(form .gg-field:hover) {
    border-color: color-mix(in srgb, var(--contact-ink) 34%, var(--contact-border));
  }

  .contact-form-card :global(form .gg-field:focus-visible) {
    border-color: var(--gg-color-focus);
    outline: none;
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--gg-color-focus) 36%, transparent);
  }

  .contact-form-card :global(form [data-submit-button]) {
    display: flex;
    min-height: 50px;
    width: 100%;
    align-items: center;
    justify-content: center;
    border-radius: 0;
    background: var(--contact-primary);
    color: var(--gg-color-on-brand);
    font-size: var(--gg-type-body-size);
    font-weight: var(--gg-type-weight-strong);
    transition:
      background-color 180ms ease,
      box-shadow 180ms ease,
      transform 180ms ease;
  }

  .contact-form-card :global(form [data-submit-button]:hover) {
    background: var(--contact-primary-hover);
    box-shadow: 0 7px 18px -10px rgba(31, 83, 62, 0.8);
  }

  .contact-form-card :global(form [data-submit-button]:active) {
    transform: translateY(1px);
  }

  .contact-form-card :global(form [data-submit-button]:focus-visible) {
    outline: 3px solid var(--gg-color-focus);
    outline-offset: 3px;
  }

  .contact-form-card :global(form [data-submit-button] svg) {
    transition: transform 180ms ease;
  }

  .contact-form-card :global(form [data-submit-button]:hover svg) {
    transform: translateX(2px);
  }

  .contact-form-card :global(form [data-form-status]) {
    border-radius: 0;
  }

  .contact-form-card :global(form > p) {
    color: var(--contact-muted);
    font-size: var(--gg-type-body-small-size);
    line-height: var(--gg-type-body-small-leading);
  }

  .contact-privacy {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    margin-top: 16px;
    color: var(--contact-muted);
    font-size: var(--gg-type-body-small-size);
    line-height: var(--gg-type-body-small-leading);
    text-align: center;
  }

  .contact-privacy :global(svg) {
    width: 14px;
    height: 14px;
    flex: 0 0 auto;
  }

  .contact-privacy a {
    color: var(--contact-primary);
  }

  .dark .contact-grid {
    opacity: 0.22;
  }

  .dark .contact-form-card {
    box-shadow:
      0 24px 60px -32px rgba(0, 0, 0, 0.56),
      inset 0 1px 0 rgba(255, 255, 255, 0.04);
  }

  @media (min-width: 640px) {
    .contact-form-card {
      padding: 32px;
    }
  }

  @media (min-width: 1024px) {
    .contact-band,
    .contact-layout {
      min-height: 690px;
    }

    .contact-form-card {
      padding: 36px;
    }
  }

  @media (max-width: 767px) {
    .contact-reassurance {
      display: none;
    }

    .contact-page a {
      position: relative;
    }

    .contact-page a::after {
      position: absolute;
      top: 50%;
      right: -8px;
      left: -8px;
      min-height: 44px;
      content: '';
      transform: translateY(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .contact-page *,
    .contact-page *::before,
    .contact-page *::after {
      scroll-behavior: auto !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>
