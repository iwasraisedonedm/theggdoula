{
  "name": "grit-grace-doula",
  "version": "1.0.0-beta.66",
  "description": "Grit + Grace Doula website built with Astro and Tailwind CSS.",
  "type": "module",
  "private": true,
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "tokens:build": "node scripts/build-design-tokens.mjs",
    "check:tokens": "node scripts/build-design-tokens.mjs --check",
    "dev": "astro dev",
    "start": "astro dev",
    "build": "npm run tokens:build && astro build",
    "sync": "astro sync",
    "preview": "astro preview",
    "astro": "astro",
    "check": "npm run check:tokens && npm run check:types && npm run test && npm run check:lint && npm run check:biome && npm run check:prettier",
    "check:types": "astro sync && node scripts/typecheck.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "check:lint": "oxlint --type-aware --disable-unicorn-plugin --ignore-pattern '.codex/**' --ignore-pattern '.pi/**' --ignore-pattern '.agents/skills/impeccable/**' --ignore-pattern '.agents/skills/ui-taste/**' --ignore-pattern '.agents/skills/design-taste-frontend/**' --ignore-pattern '.agents/skills/antislop*/**'",
    "check:prettier": "prettier --check \"src/**/*.astro\" \"src/**/*.css\" \"**/*.md\"",
    "fix": "npm run fix:lint && npm run fix:biome && npm run fix:prettier",
    "fix:lint": "oxlint --fix --disable-unicorn-plugin --ignore-pattern '.codex/**' --ignore-pattern '.pi/**'",
    "fix:prettier": "prettier --write \"src/**/*.astro\" \"src/**/*.css\" \"**/*.md\"",
    "check:biome": "biome format .",
    "fix:biome": "biome format --write ."
  },
  "dependencies": {
    "@astro-community/astro-embed-twitter": "^0.5.11",
    "@astro-community/astro-embed-vimeo": "^0.3.12",
    "@astro-community/astro-embed-youtube": "^0.5.10",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "astro": "^7.4.2",
    "astro-icon": "^1.1.5",
    "astro-seo": "^1.2.0",
    "limax": "4.2.3",
    "lodash.merge": "^4.6.2",
    "unpic": "^4.2.2"
  },
  "devDependencies": {
    "@astrojs/markdown-satteri": "^0.4.5",
    "@astrojs/mdx": "^8.1.1",
    "@astrojs/partytown": "^2.1.7",
    "@astrojs/ts-content-mapper": "0.2.0",
    "@biomejs/biome": "2.6.3",
    "@iconify-json/flat-color-icons": "^1.2.3",
    "@iconify-json/tabler": "^1.2.38",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/lodash.merge": "^4.6.9",
    "@types/mdx": "^2.0.14",
    "mdast-util-to-string": "^4.0.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2005",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^1.1.2",
    "reading-time": "^1.5.0",
    "satteri": "^0.10.5",
    "sharp": "^0.35.3",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "7.1.0-beta"
  },
  "overrides": {
    "@tailwindcss/typography": {
      "postcss-selector-parser": "^7.1.7"
    }
  }
}
